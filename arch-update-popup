        close_btn.setObjectName("primary")
        close_btn.setFixedHeight(32)
        close_btn.clicked.connect(self.close)
        row.addWidget(close_btn)
        lay.addLayout(row)

        # Position near the cursor, clamped on-screen.
        pos = QCursor.pos()
        geo = QApplication.primaryScreen().availableGeometry()
        self.adjustSize()
        x = min(max(pos.x() - 280, geo.left()), geo.right() - self.width())
        y = min(max(pos.y() - 100, geo.top()), geo.bottom() - self.height())
        self.move(x, y)


class UpdateWindow(QMainWindow):
    closed           = pyqtSignal()
    update_succeeded = pyqtSignal()

    def __init__(
        self,
        updates:     list[dict],
        cached_info: dict[int, tuple],
        aur_helper:  str | None,
    ) -> None:
        super().__init__()
        self._updates    = updates
        self._aur_helper = aur_helper
        self._runner:    UpdateRunner | None = None
        self._single:    UpdateRunner | None = None
        self._single_name: str | None = None
        self._single_overwrite: str | None = None
        self._remover:   ObsoleteRemover | None = None
        self._safe_names: list[str] = []
        self._last_run_names: list[str] = []
        self._updating   = False
        self._retry_mode = False
        self._overwrite:  str | None = None
        self._last_error: str = ""
        self._installing_row: int | None = None
        self._popover: NotesPopover | None = None
        self._fail_notif_id = 0  # single updating failure notification
        # Repeat-failure guard: same signature failing over and over means
        # the auto-fix isn't working — stop nagging, show the manual fix.
        self._fail_sig: tuple | None = None
        self._fail_streak = 0
        self._offer_open = False
        # Watchdog: silence from the installer means it may be stuck.
        self._last_activity = 0.0
        self._stuck_warned = False
        self._watchdog = QTimer(self)
        self._watchdog.setInterval(5000)
        self._watchdog.timeout.connect(self._watchdog_tick)
        self._compromised = any(pkg.get("compromised") for pkg in updates)
        n = len(updates)

        self.setWindowTitle(f"Arch Update — {n} package{'s' if n != 1 else ''} available")
        self.setMinimumSize(1240, 680)
        self.setStyleSheet(_APP_QSS)

        root = QWidget()
        self.setCentralWidget(root)
        lay = QVBoxLayout(root)
        lay.setContentsMargins(24, 24, 24, 24)
        lay.setSpacing(16)

        # ── Zone 1 · Header: identity left, search right ────────────────────
        head = QHBoxLayout()
        head.setSpacing(12)
        icon_lbl = QLabel()
        icon_lbl.setPixmap(_app_icon().pixmap(40, 40))
        head.addWidget(icon_lbl, 0, Qt.AlignmentFlag.AlignTop)

        title_block = QVBoxLayout()
        title_block.setSpacing(2)
        eyebrow = QLabel("SYSTEM UPDATES")
        eyebrow.setObjectName("eyebrow")
        title_block.addWidget(eyebrow)
        self._title = QLabel("Arch Update")
        self._title.setObjectName("title")
        title_block.addWidget(self._title)
        self._sub = QLabel()
        self._sub.setObjectName("subtitle")
        title_block.addWidget(self._sub)
        head.addLayout(title_block)
        head.addStretch()

        self._search = QLineEdit()
        self._search.setObjectName("search")
        self._search.setPlaceholderText("Filter packages…")
        self._search.setClearButtonEnabled(True)
        self._search.addAction(
            _svg_icon(_SEARCH_SVG), QLineEdit.ActionPosition.LeadingPosition
        )
        self._search.setFixedHeight(36)
        self._search.textChanged.connect(self._apply_filter)
        head.addWidget(self._search, 0, Qt.AlignmentFlag.AlignVCenter)
        lay.addLayout(head)

        lay.addWidget(_divider())

        # ── Zone 2 · Stat grid: equal-width cards ───────────────────────────
        stats = QHBoxLayout()
        stats.setSpacing(12)
        n_aur = sum(1 for p in updates if p.get("repo") == "aur")
        n_off = n - n_aur
        n_comp = sum(1 for p in updates if p.get("compromised"))
        self._stat_ready = _StatCard(str(n - n_comp), "ready to install", "#1e8e3e")
        self._stat_official = _StatCard(str(n_off), "official", "#3584e4")
        self._stat_aur = _StatCard(str(n_aur), "aur", "#e66100")
        stats.addWidget(self._stat_ready, 1)
        stats.addWidget(self._stat_official, 1)
        stats.addWidget(self._stat_aur, 1)
        self._stat_blocked: _StatCard | None = None
        if n_comp:
            self._stat_blocked = _StatCard(str(n_comp), "blocked · skipped", "#e01b24")
            stats.addWidget(self._stat_blocked, 1)
        lay.addLayout(stats)

        # ── Failure banner slot ─────────────────────────────────────────────
        # NOTE: intentionally no top banner widget. A dynamically shown
        # nested container gets squeezed below its children's minimums
        # when the window overflows, overlapping its own text. The status
        # box below (a direct layout child) renders reliably, names the
        # failing packages, and the list auto-scrolls to the failed row.
        self._fail_row: int | None = None

        # ── Compromised warning banner ──────────────────────────────────────
        if self._compromised:
            banner = QWidget()
            banner.setObjectName("banner-danger")
            banner.setAttribute(Qt.WidgetAttribute.WA_StyledBackground, True)
            blay = QVBoxLayout(banner)
            blay.setContentsMargins(16, 12, 16, 12)
            blay.setSpacing(4)
            comp_pkgs = [p for p in updates if p.get("compromised")]
            btitle = QLabel(
                f"Security warning — {len(comp_pkgs)} compromised "
                f"package{'s' if len(comp_pkgs) != 1 else ''} will be skipped"
            )
            btitle.setObjectName("banner-title")
            btitle.setWordWrap(True)
            blay.addWidget(btitle)
            comp_names = "\n".join(
                f"  • {p['name']}: {'; '.join(p.get('compromise_reasons', ['unknown']))}"
                for p in comp_pkgs
            )
            bbody = QLabel(
                f"{comp_names}\n\n"
                "These packages will be SKIPPED during update — safe packages "
                "can still be installed. Do not update the flagged packages "
                "until verified safe."
            )
            bbody.setObjectName("banner-body")
            bbody.setWordWrap(True)
            bbody.setTextInteractionFlags(
                Qt.TextInteractionFlag.TextSelectableByMouse
            )
            blay.addWidget(bbody)
            lay.addWidget(banner)

        n_cached = sum(1 for i in range(n) if i in cached_info)
        self._set_idle_header(n_cached)

        # ── Zone 3 · Toolbar + virtualized package list ─────────────────────
        toolbar = QHBoxLayout()
        toolbar.setSpacing(8)
        self._meta = QLabel(f"{n} package{'s' if n != 1 else ''}")
        self._meta.setObjectName("meta")
        toolbar.addWidget(self._meta, 0, Qt.AlignmentFlag.AlignVCenter)
        toolbar.addStretch()
        self._select_all_btn = QPushButton("Select all")
        self._select_all_btn.setObjectName("secondary-small")
        self._select_all_btn.setFixedHeight(30)
        self._select_all_btn.setIcon(app_icon("select-all", 14))
        self._select_all_btn.clicked.connect(lambda: self._select_all(True))
        toolbar.addWidget(self._select_all_btn)
        self._select_none_btn = QPushButton("Select none")
        self._select_none_btn.setObjectName("secondary-small")
        self._select_none_btn.setFixedHeight(30)
        self._select_none_btn.setIcon(app_icon("select-none", 14))
        self._select_none_btn.clicked.connect(lambda: self._select_all(False))
        toolbar.addWidget(self._select_none_btn)
        lay.addLayout(toolbar)

        self._model = PackageModel(updates, cached_info)
        self._list = QListView()
        self._list.setObjectName("package-list")
        self._list.setModel(self._model)
        self._delegate = PackageDelegate(self._list)
        self._list.setItemDelegate(self._delegate)
        # Perf: no per-cell widgets, per-pixel smooth scrolling, and rows
        # only repaint when their own dataChanged fires.
        self._list.setSelectionMode(
            QAbstractItemView.SelectionMode.NoSelection)
        self._list.setVerticalScrollMode(
            QAbstractItemView.ScrollMode.ScrollPerPixel)
        self._list.setResizeMode(QListView.ResizeMode.Adjust)
        self._list.setSpacing(0)
        self._list.setFrameShape(QFrame.Shape.NoFrame)
        self._list.setMouseTracking(True)
        self._list.viewport().setMouseTracking(True)
        self._delegate.toggled.connect(self._on_row_toggled)
        self._delegate.link_activated.connect(
            lambda url: QDesktopServices.openUrl(QUrl(url)))
        self._delegate.more_requested.connect(self._on_more_requested)
        self._delegate.action_requested.connect(self._on_row_action)
        self._model.dataChanged.connect(self._on_model_changed)
        lay.addWidget(self._list, 1)

        # Indeterminate per-item animation ticks only repaint installing rows.
        self._anim = QTimer(self)
        self._anim.setInterval(120)
        self._anim.timeout.connect(lambda: self._delegate.tick(self._model))

        # ── Zone 4 · Status: message + slim progress track ───────────────────
        self._status = QTextEdit()
        self._status.setObjectName("status")
        self._status.setReadOnly(True)
        self._status.setFrameShape(QFrame.Shape.NoFrame)
        self._status.setVerticalScrollBarPolicy(
            Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        self._status.setHorizontalScrollBarPolicy(
            Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        self._status.setSizeAdjustPolicy(
            QAbstractScrollArea.SizeAdjustPolicy.AdjustToContents)
        self._status.setTextInteractionFlags(
            Qt.TextInteractionFlag.TextSelectableByMouse
        )
        self._status.setVisible(False)
        lay.addWidget(self._status)

        self._progress = QProgressBar()
        self._progress.setRange(0, n)
        self._progress.setValue(n_cached)
        self._progress.setTextVisible(False)
        lay.addWidget(self._progress)

        # ── Failure details (hidden unless an update fails) ───────────────────
        fail_head = QHBoxLayout()
        fail_head.setSpacing(8)
        self._details_label = QLabel("ERROR DETAILS")
        self._details_label.setObjectName("details-label")
        self._details_label.setVisible(False)
        fail_head.addWidget(self._details_label)
        fail_head.addStretch()
        self._copy_btn = QPushButton("Copy error")
        self._copy_btn.setObjectName("secondary-small")
        self._copy_btn.setFixedHeight(30)
        self._copy_btn.setIcon(app_icon("copy", 14))
        self._copy_btn.setToolTip("Copy the error details to the clipboard")
        self._copy_btn.clicked.connect(self._copy_error)
        self._copy_btn.setVisible(False)
        fail_head.addWidget(self._copy_btn)
        lay.addLayout(fail_head)

        self._details = QPlainTextEdit()
        self._details.setObjectName("details")
        self._details.setReadOnly(True)
        self._details.setMaximumBlockCount(60)
        self._details.setMinimumHeight(90)
        self._details.setMaximumHeight(130)
        self._details.setVisible(False)
        lay.addWidget(self._details)

        # ── Optional log window (live installer output) ───────────────────────
        log_head = QHBoxLayout()
        log_head.setSpacing(8)
        self._log_label = QLabel("UPDATE LOG")
        self._log_label.setObjectName("details-label")
        self._log_label.setVisible(False)
        log_head.addWidget(self._log_label)
        log_head.addStretch()
        self._log_clear_btn = QPushButton("Clear")
        self._log_clear_btn.setObjectName("secondary-small")
        self._log_clear_btn.setFixedHeight(30)
        self._log_clear_btn.setVisible(False)
        self._log_clear_btn.clicked.connect(lambda: self._log_view.clear())

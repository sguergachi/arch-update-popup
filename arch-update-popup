# ── Virtualized package list ─────────────────────────────────────────────
#
# Hundreds of package cards must scroll at 60fps with no dropped frames,
# so rows are *painted* (QListView + QStyledItemDelegate) instead of
# widget trees: one paint pass per visible row, text laid out with cached
# QTextDocuments, and progress updates repaint only the affected row via
# dataChanged. Hit-testing (checkbox / links / action pill) is computed
# from the same layout the painter uses.

_SNIPPET_LEN = 220


class PackageModel(QAbstractListModel):
    """One dict per package; check state lives in Qt.CheckStateRole."""

    def __init__(self, updates: list[dict], cached: dict) -> None:
        super().__init__()
        self._items: list[dict] = []
        for i, pkg in enumerate(updates):
            c = cached.get(i, ("", "", "", "", "", ""))
            desc, notes, date, full, src, surl = (list(c) + [""] * 6)[:6]
            comp = bool(pkg.get("compromised"))
            self._items.append({
                "name": pkg["name"], "old": pkg.get("old", ""),
                "new": pkg.get("new", ""),
                "repo": pkg.get("repo", ""), "compromised": comp,
                "reasons": list(pkg.get("compromise_reasons", [])),
                "desc": desc or "Loading description…",
                "notes": notes or "Fetching release notes…",
                "date": date or "", "full": full or notes,
                "source": src, "source_url": surl,
                "checked": not comp,
                "state": "idle", "_rev": 0,
            })

    # — Qt interface —
    def rowCount(self, parent: QModelIndex | None = None) -> int:
        return 0 if parent is not None and parent.isValid() else len(self._items)

    def item(self, row: int) -> dict:
        return self._items[row]

    def flags(self, index: QModelIndex) -> Qt.ItemFlag:
        f = super().flags(index) | Qt.ItemFlag.ItemIsEnabled
        if index.isValid() and not self._items[index.row()]["compromised"]:
            f |= Qt.ItemFlag.ItemIsUserCheckable
        return f

    def data(self, index: QModelIndex, role: int = Qt.ItemDataRole.DisplayRole):
        if not index.isValid():
            return None
        it = self._items[index.row()]
        if role == Qt.ItemDataRole.DisplayRole:
            return it["name"]
        if role == Qt.ItemDataRole.CheckStateRole:
            return (Qt.CheckState.Checked if it["checked"]
                    else Qt.CheckState.Unchecked)
        return None

    def setData(self, index: QModelIndex, value, role: int = Qt.ItemDataRole.EditRole) -> bool:
        if (role == Qt.ItemDataRole.CheckStateRole and index.isValid()
                and not self._items[index.row()]["compromised"]):
            it = self._items[index.row()]
            it["checked"] = value in (Qt.CheckState.Checked, 2, True)
            self.dataChanged.emit(index, index, [role])
            return True
        return False

    # — Bulk helpers —
    def set_all(self, checked: bool) -> None:
        for it in self._items:
            if not it["compromised"]:
                it["checked"] = checked
        if self._items:
            self.dataChanged.emit(
                self.index(0), self.index(len(self._items) - 1),
                [Qt.ItemDataRole.CheckStateRole])

    def checked_names(self) -> list[str]:
        return [it["name"] for it in self._items
                if it["checked"] and not it["compromised"]]

    def selected_count(self) -> int:
        return sum(1 for it in self._items
                   if it["checked"] and not it["compromised"])

    def checkable_count(self) -> int:
        return sum(1 for it in self._items if not it["compromised"])

    def row_of(self, name: str) -> int | None:
        for r, it in enumerate(self._items):
            if it["name"] == name:
                return r
        return None

    def names(self) -> list[str]:
        return [it["name"] for it in self._items]

    def ensure_row(self, name: str) -> int:
        """Return the row for `name`, inserting a dependency row if new.

        pacman/paru often install packages that were never in the update
        list (dependencies, build deps). Without a row they are invisible:
        progress names something the list doesn't show, and a failure in
        oneosc them can't be highlighted. Auto rows start unchecked.
        """
        r = self.row_of(name)
        if r is not None:
            return r
        r = len(self._items)
        self.beginInsertRows(QModelIndex(), r, r)
        self._items.append({
            "name": name, "old": "", "new": "",
            "repo": "", "compromised": False, "reasons": [],
            "desc": "Pulled in automatically while installing "
                    "(e.g. a dependency) — it was not in the update list.",
            "notes": "No changelog available for auto-added packages.",
            "date": "", "full": "", "source": "", "source_url": "",
            "checked": False, "state": "idle", "_rev": 0, "auto": True,
        })
        self.endInsertRows()
        return r

    def set_state(self, name: str, state: str) -> None:
        r = self.row_of(name)
        if r is not None:
            self._items[r]["state"] = state
            idx = self.index(r)
            self.dataChanged.emit(idx, idx, [])

    def reset_states(self) -> None:
        for r, it in enumerate(self._items):
            if it["state"] != "idle":
                it["state"] = "idle"
                idx = self.index(r)
                self.dataChanged.emit(idx, idx, [])

    def set_info(self, row: int, desc: str, notes: str, date: str,
                 full: str, source: str, source_url: str) -> None:
        it = self._items[row]
        it.update(desc=desc or it["desc"], notes=notes or it["notes"],
                  date=date or "", full=full or notes,
                  source=source, source_url=source_url)
        it["_rev"] += 1
        idx = self.index(row)
        self.dataChanged.emit(idx, idx, [])
        self.layoutChanged.emit()  # wrapped heights may have changed

    # — Show-more popover (see UpdateWindow.show_popover) —


class PackageDelegate(QStyledItemDelegate):
    """Paints package cards and hit-tests their interactive zones."""

    toggled = pyqtSignal(int)            # checkbox flipped
    link_activated = pyqtSignal(str)    # external URL clicked
    more_requested = pyqtSignal(int)    # show more / less
    action_requested = pyqtSignal(str)  # retry / install-anyway for pkg

    RAIL = 30       # checkbox / status icon column
    PAD = 14        # card inner padding (horizontal)
    PTOP = 10       # card inner padding top
    PBOT = 12       # card inner padding bottom
    CDX = 8         # card inset inside the row (horizontal)
    CDY = 4         # card inset inside the row (vertical)

    def __init__(self, view: QListView) -> None:
        super().__init__(view)
        self._view = view
        self._docs: dict = {}
        self._geo: dict = {}
        self._hover: tuple[int, str] = (-1, "")
        self._phase = 0
        self._paint_failed = False
        self._f_name = QFont()
        self._f_name.setBold(True)
        self._f_name.setPointSize(self._f_name.pointSize() + 1)
        self._f_small = QFont()
        self._f_small.setPointSize(self._f_small.pointSize() - 1)
        self._f_badge = QFont()
        self._f_badge.setBold(True)
        self._f_badge.setPointSize(self._f_badge.pointSize() - 2)

    # — Text documents (cached per row/rev/width) —
    def _doc(self, row: int, field: str, text: str, width: int,
             font: QFont | None, html: bool, rev: int) -> QTextDocument:
        key = (row, field, width, rev)
        doc = self._docs.get(key)
        if doc is None:
            if len(self._docs) > 900:
                self._docs.clear()
            doc = QTextDocument()
            if font is not None:
                doc.setDefaultFont(font)
            doc.setDocumentMargin(0)
            if html:
                doc.setHtml(text)
            else:
                doc.setPlainText(text)
            doc.setTextWidth(width)
            self._docs[key] = doc
        return doc

    # — Geometry: single source of truth for paint + hit-testing —
    def _layout(self, row: int, item: dict, width: int) -> dict:
        # The view may query geometry before it has a real width (and tests
        # do too) — never lay out on a degenerate width.
        width = max(int(width or 0), 60)
        rev = item["_rev"]
        key = (row, width, item["state"], rev)
        lay = self._geo.get(key)
        if lay is not None:
            return lay
        if len(self._geo) > 600:
            self._geo.clear()

        cw = width - 2 * self.CDX - 2 * self.PAD - self.RAIL
        x0 = self.CDX + self.PAD + self.RAIL
        right = width - self.CDX - self.PAD
        y = self.CDY + self.PTOP
        fm_name = self._view.fontMetrics()
        fm_name_b = QFontMetrics(self._f_name)

        name_w = fm_name_b.horizontalAdvance(item["name"])
        badge_txt = (item["repo"] or "").upper()
        badge_w = (QFontMetrics(self._f_badge).horizontalAdvance(badge_txt) + 18
                   if badge_txt else 0)
        date_w = fm_name.horizontalAdvance(item["date"]) if item["date"] else 0

        if item.get("auto"):
            ver_html = (
                "<span style='color:#757575'>dependency — added automatically "
                "during install</span>")
        else:
            ver_html = (
                f"<span style='color:#757575'><s>{item['old']}</s></span>"
                f" &nbsp;→&nbsp; <b style='color:{_NEW_GREEN}'>{item['new']}</b>")
        ver_doc = self._doc(row, "ver", ver_html, cw, None, True, rev)
        desc_doc = self._doc(row, "desc", item["desc"], cw, None, False, rev)

        full = (item["full"] or "").strip()
        notes = (item["notes"] or "").strip()
        has_more = bool(full) and full != notes
        shown = (notes[:_SNIPPET_LEN].rstrip() + "…"
                 if len(notes) > _SNIPPET_LEN else notes)
        notes_doc = self._doc(row, "notes", shown, cw, None, False, rev)

        more_txt = "Show more  ↓" if has_more else ""
        link_txt = "View package  ↗"
        more_w = fm_name.horizontalAdvance(more_txt) if more_txt else 0
        link_w = fm_name.horizontalAdvance(link_txt)

        h_name, h_ver = 24, int(ver_doc.size().height())
        h_desc = int(desc_doc.size().height())
        h_kick, h_notes = 18, int(notes_doc.size().height())
        h_actions = 22
        lay = {
            "check": QRect(x0 - self.RAIL + 4, y + 1, 20, 20),
            "name": QRect(x0, y, name_w, h_name),
            "badge": QRect(x0 + name_w + 8, y + 3, badge_w, 18),
            "date": QRect(right - date_w, y + 3, date_w, 18),
            "state_icon": QRect(right - date_w - 22, y + 1, 18, 18)
            if (item["state"] != "idle" or item["compromised"]) else QRect(),
            "ver": QRect(x0, y + h_name + 2, cw, h_ver),
            "desc": QRect(x0, y + h_name + 2 + h_ver + 4, cw, h_desc),
            "kick": QRect(x0, y + h_name + 2 + h_ver + 4 + h_desc + 6, cw, h_kick),
            "notes": QRect(x0, y + h_name + 2 + h_ver + 4 + h_desc + 6 + h_kick, cw, h_notes),
            "more": QRect(x0, 0, more_w + 18, h_actions),
            "link": QRect(right - link_w - 18, 0, link_w + 18, h_actions),
            "card": QRect(self.CDX, self.CDY, width - 2 * self.CDX, 0),
        }
        ycur = (y + h_name + 2 + h_ver + 4 + h_desc + 6 + h_kick + h_notes + 6)
        lay["more"].moveTop(ycur)
        lay["link"].moveTop(ycur)
        ycur += h_actions + 4

        if item["state"] in ("installing", "done", "failed"):
            lay["progress"] = QRect(x0, ycur, cw, 4)
            ycur += 4 + 8
        else:
            lay["progress"] = QRect()

        action_txt = ""
        if item["state"] == "failed":
            action_txt = "Retry"
        elif item["compromised"]:
            action_txt = "Install anyway"
        if action_txt:
            aw = fm_name.horizontalAdvance(action_txt) + 28
            lay["action"] = QRect(right - aw, ycur, aw, 28)
            lay["action_txt"] = action_txt
            ycur += 28 + 2
        else:
            lay["action"] = QRect()
            lay["action_txt"] = ""

        total = ycur + self.PBOT
        lay["card"].setHeight(total - 2 * self.CDY)
        lay["height"] = total
        lay["ver_doc"] = ver_doc
        lay["desc_doc"] = desc_doc
        lay["notes_doc"] = notes_doc
        lay["more_txt"] = more_txt
        lay["link_txt"] = link_txt
        lay["badge_txt"] = badge_txt
        self._geo[key] = lay
        return lay

    def sizeHint(self, option, index) -> QSize:
        try:
            item = index.model().item(index.row())
            w = option.rect.width() or self._view.viewport().width()
            return QSize(w, self._layout(index.row(), item, w)["height"])
        except Exception:
            traceback.print_exc()
            return QSize(option.rect.width() or 400, 120)

    # — Painting — (guarded: an exception here must degrade one row, not
    # abort the process)
    def paint(self, painter: QPainter, option, index) -> None:
        try:
            self._paint_inner(painter, option, index)
        except Exception:
            if not self._paint_failed:
                self._paint_failed = True
                traceback.print_exc()

    def _paint_inner(self, painter: QPainter, option, index) -> None:
        model = index.model()
        item = model.item(index.row())
        w = option.rect.width()
        lay = self._layout(index.row(), item, w)
        p = painter
        p.save()
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        pal = option.palette
        card = QRect(lay["card"])
        card.translate(option.rect.topLeft())

        def move(r: QRect) -> QRect:
            return QRect(r).translated(option.rect.topLeft())

        # Card background + border
        p.setPen(QPen(pal.color(pal.ColorRole.Midlight), 1))
        p.setBrush(QBrush(pal.color(pal.ColorRole.Window)))
        p.drawRoundedRect(card, 10, 10)

        # Left state accent
        accent = {"installing": "#3584e4", "done": "#26a269",
                  "failed": "#e01b24"}.get(item["state"])
        if item["compromised"]:
            accent = "#e01b24"
        if accent:
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(QBrush(QColor(accent)))
            p.drawRoundedRect(
                QRect(card.left(), card.top() + 8, 4, card.height() - 16), 2, 2)

        # Rail: checkbox or blocked icon
        if item["compromised"]:
            app_icon("warn-triangle", 18).paint(p, move(lay["check"]))
        else:
            opt = QStyleOptionButton()
            opt.rect = move(lay["check"])
            opt.state = (QStyle.StateFlag.State_Enabled
                         | (QStyle.StateFlag.State_On if item["checked"]
                            else QStyle.StateFlag.State_Off))
            self.parent().style().drawPrimitive(
                QStyle.PrimitiveElement.PE_IndicatorCheckBox, opt, p, self._view)

        # Name + repo badge
        p.setPen(QPen(pal.color(pal.ColorRole.Text)))
        p.setFont(self._f_name)
        p.drawText(move(lay["name"]),
                   Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter,
                   item["name"])
        if lay["badge_txt"]:
            rgb, fg = _repo_tint(item["repo"])
            br = move(lay["badge"])
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(QBrush(QColor(*rgb, 41)))
            p.drawRoundedRect(br, 8, 8)
            p.setPen(QPen(QColor(fg)))
            p.setFont(self._f_badge)
            p.drawText(br, Qt.AlignmentFlag.AlignCenter, lay["badge_txt"])

        # Date + state icon (top right)
        p.setFont(self.parent().font())
        p.setPen(QPen(QColor("#757575")))
        p.drawText(move(lay["date"]),
                   Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter,
                   item["date"])
        if not lay["state_icon"].isNull():
            icon = {"installing": "info-circle", "done": "check-circle",
                    "failed": "error-circle"}.get(item["state"],
                                                  "warn-triangle")
            app_icon(icon, 16).paint(p, move(lay["state_icon"]))

        # Rich / wrapped text blocks
        for key in ("ver_doc", "desc_doc", "notes_doc"):
            doc = lay[key]
            r = move(lay[key.replace("_doc", "")])
            p.save()
            p.translate(r.topLeft())
            doc.drawContents(p, QRectF(0, 0, r.width(), r.height()))
            p.restore()

        # Kicker
        p.setFont(self._f_badge)
        p.setPen(QPen(QColor("#757575")))
        p.drawText(move(lay["kick"]),
                   Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter,
                   "WHAT'S NEW")

        # Action links
        hover = self._hover if self._hover[0] == index.row() else (-1, "")
        p.setFont(self.parent().font())
        if lay["more_txt"]:
            mr = move(lay["more"])
            app_icon("chevron-down", 14).paint(
                p, QRect(mr.left(), mr.center().y() - 7, 14, 14))
            p.setPen(QPen(QColor("#3584e4")))
            f = p.font()
            f.setUnderline(hover[1] == "more")
            p.setFont(f)
            p.drawText(QRect(mr.left() + 18, mr.top(), mr.width() - 18,
                             mr.height()),
                       Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter,
                       lay["more_txt"])
        lr = move(lay["link"])
        p.setPen(QPen(QColor("#3584e4")))
        f = p.font()
        f.setUnderline(hover[1] == "link")
        p.setFont(f)
        p.drawText(lr, Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter,
                   lay["link_txt"])

        # Per-item progress
        if not lay["progress"].isNull():
            pr = move(lay["progress"])
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(QBrush(pal.color(pal.ColorRole.Midlight)))
            p.drawRoundedRect(pr, 2, 2)
            color = {"installing": "#3584e4", "done": "#26a269",
                     "failed": "#e01b24"}[item["state"]]
            p.setBrush(QBrush(QColor(color)))
            if item["state"] == "installing":
                frac = 0.35
                x = pr.left() + int(
                    (pr.width() * (1 - frac)) * (self._phase % 20) / 19)
                p.drawRoundedRect(QRect(x, pr.top(), int(pr.width() * frac),
                                        pr.height()), 2, 2)
            else:
                p.drawRoundedRect(pr, 2, 2)

        # Action pill (Retry / Install anyway)
        if not lay["action"].isNull():
            ar = move(lay["action"])
            danger = item["compromised"]
            col = "#e01b24" if danger else "#3584e4"
            if hover[1] == "action":
                p.setBrush(QBrush(QColor(col)))
                p.setPen(Qt.PenStyle.NoPen)
                p.drawRoundedRect(ar, 8, 8)
                p.setPen(QPen(QColor("#ffffff")))
            else:
                p.setBrush(Qt.BrushStyle.NoBrush)
                p.setPen(QPen(QColor(col), 1.5))
                p.drawRoundedRect(ar, 8, 8)
                p.setPen(QPen(QColor(col)))
            p.drawText(ar, Qt.AlignmentFlag.AlignCenter, lay["action_txt"])

        p.restore()

    # — Interaction —
    def _hit(self, option, index) -> tuple[dict, object]:
        lay = self._layout(index.row(), index.model().item(index.row()),
                           option.rect.width())
        return lay, option.rect.topLeft()

    def editorEvent(self, event, model, option, index) -> bool:
        # Never let exceptions escape into Qt event dispatch (sip turns
        # them into a hard abort). Log and ignore instead.
        try:
            return self._editor_event_inner(event, model, option, index)
        except Exception:
            traceback.print_exc()
            return False

    def _editor_event_inner(self, event, model, option, index) -> bool:
        if event.type() == QEvent.Type.MouseMove:
            lay, origin = self._hit(option, index)
            pos = event.position().toPoint() - origin
            kind = ""
            for k in ("check", "link", "more", "action"):
                r = lay.get(k)
                if r is not None and not r.isNull() and r.contains(pos):
                    if k == "check" and model.item(index.row())["compromised"]:
                        continue
                    kind = k
                    break
            if (index.row(), kind) != self._hover:
                old_row = self._hover[0]
                self._hover = (index.row(), kind)
                # NOTE: QListView.update() takes a QModelIndex, not a QRect
                # (it shadows QWidget.update) — repaint via the viewport.
                vp = self._view.viewport()
                if old_row >= 0:
                    vp.update(self._view.visualRect(model.index(old_row)))
                vp.update(option.rect)
                vp.setCursor(
                    Qt.CursorShape.PointingHandCursor if kind
                    else Qt.CursorShape.ArrowCursor)
            return False
        if (event.type() == QEvent.Type.MouseButtonRelease
                and event.button() == Qt.MouseButton.LeftButton):
            lay, origin = self._hit(option, index)
            pos = event.position().toPoint() - origin
            item = model.item(index.row())
            if lay["check"].contains(pos) and not item["compromised"]:
                self.toggled.emit(index.row())
                return True
            if lay["link"].contains(pos):
                self.link_activated.emit(
                    _package_url(item["name"], item["repo"]))
                return True
            if not lay["more"].isNull() and lay["more"].contains(pos):
                self.more_requested.emit(index.row())
                return True
            if not lay["action"].isNull() and lay["action"].contains(pos):
                self.action_requested.emit(item["name"])
                return True
        return False

    def tick(self, model: PackageModel) -> None:
        """Advance the indeterminate animation; repaint installing rows only."""
        self._phase += 1
        for r, it in enumerate(model._items):
            if it["state"] == "installing":
                idx = model.index(r)
                model.dataChanged.emit(idx, idx, [])


class NotesPopover(QDialog):

    # ── Helpers ────────────────────────────────────────────────────────────────

    def _apply_filter(self, text: str) -> None:
        q = text.strip().lower()
        shown = 0
        for r in range(self._model.rowCount()):
            hidden = bool(q) and q not in self._model.item(r)["name"].lower()
            self._list.setRowHidden(r, hidden)
            shown += not hidden
        n = self._model.rowCount()
        self._meta.setText(
            f"Showing {shown} of {n} package{'s' if n != 1 else ''}" if q
            else f"{n} package{'s' if n != 1 else ''}"
        )

    def _set_idle_header(self, n_cached: int) -> None:
        n = len(self._updates)
        self._stat_ready.set_caption("ready to install")
        self._stat_ready.set_accent("#1e8e3e")
        if n_cached < n:
            self._sub.setText(
                f"<b>{n}</b> package{'s' if n != 1 else ''} available "
                f"<span style='color:#757575'>· fetching release notes…</span>"
            )
        else:
            self._sub.setText(
                f"<b>{n}</b> package{'s' if n != 1 else ''} available "
                f"<span style='color:#757575'>· release notes loaded ✓</span>"
            )

    # — Selection —
    def _select_all(self, checked: bool) -> None:
        self._model.set_all(checked)
        self._refresh_selection_ui()

    def _on_row_toggled(self, row: int) -> None:
        idx = self._model.index(row)
        cur = self._model.data(idx, Qt.ItemDataRole.CheckStateRole)
        self._model.setData(
            idx,
            Qt.CheckState.Unchecked if cur == Qt.CheckState.Checked
            else Qt.CheckState.Checked,
            Qt.ItemDataRole.CheckStateRole)
        self._refresh_selection_ui()

    def _on_model_changed(self, *args) -> None:
        self._refresh_selection_ui()

    def _refresh_selection_ui(self) -> None:
        sel = self._model.selected_count()
        total = self._model.checkable_count()
        if sel == total:
            self._sel_label.setText(f"All {total} packages selected")
        elif sel == 0:
            self._sel_label.setText("No packages selected")
        else:
            self._sel_label.setText(f"{sel} of {total} selected")
        self._select_all_btn.setEnabled(sel < total)
        self._select_none_btn.setEnabled(sel > 0)
        if self._updating:
            return
        if sel == 0:
            self._update_btn.setText("Update")
            self._update_btn.setEnabled(False)
        elif getattr(self, "_retry_mode", False):
            self._update_btn.setText(
                f"Retry {sel} selected" if sel != total else "Retry Update")
            self._update_btn.setEnabled(True)
        else:
            self._update_btn.setText(
                "Update All" if sel == total else f"Update {sel} selected")
            self._update_btn.setEnabled(True)

    # ── Status / progress presentation ─────────────────────────────────────

    def _set_status(self, text: str, kind: str = "info") -> None:
        """Show a status message; the box hides itself when empty.

        kind: "info" (plain text), "error" (white on red), "ok" (white on green).
        """
        self._status.setHtml(text)
        self._status.setVisible(bool(text))
        if kind == "error":
            self._status.setObjectName("status-error")
        elif kind == "ok":
            self._status.setObjectName("status-ok")
        else:
            self._status.setObjectName("status")
        self._status.style().unpolish(self._status)
        self._status.style().polish(self._status)

    def _set_progress_state(self, state: str, text: str = "") -> None:
        """Recolor the slim progress track: 'normal', 'error' (red), 'ok'."""
        chunk = {"normal": "#2e9b57", "error": "#c01c28", "ok": "#1f7a3a"}[state]
        self._progress.setStyleSheet(
            "QProgressBar { border: none; background: palette(midlight);"
            " border-radius: 3px; min-height: 6px; max-height: 6px;"
            " color: transparent; }"
            "QProgressBar::chunk { background: %s; border-radius: 3px; }"
            % chunk
        )
        if text:
            self._progress.setFormat(text)

    def _hide_failure_ui(self) -> None:
        self._fail_row = None
        self._details_label.setVisible(False)
        self._details.clear()
        self._details.setVisible(False)
        self._copy_btn.setVisible(False)
        self._last_error = ""

    def _scroll_to_failed(self) -> None:
        if self._fail_row is not None:
            self._list.scrollTo(self._model.index(self._fail_row),
                                QAbstractItemView.ScrollHint.PositionAtCenter)
            self._list.setCurrentIndex(self._model.index(self._fail_row))

    def _on_show_failed(self) -> None:
        self._scroll_to_failed()

    # ── Called by TrayApp as background data arrives ───────────────────────────

    def on_info_ready(self, row: int, desc: str, notes: str, date: str,
                      full: str = "", source: str = "", source_url: str = "") -> None:
        if 0 <= row < self._model.rowCount():
            self._model.set_info(row, desc, notes, date, full, source,
                                 source_url)
        if not self._updating:
            self._progress.setValue(self._progress.value() + 1)

    def on_fetch_done(self) -> None:
        if not self._updating:
            self._set_idle_header(len(self._updates))
            self._progress.setFormat("Release notes loaded  ✓")

    # ── Update flow ────────────────────────────────────────────────────────────

    def start_update(self) -> None:
        if self._single is not None:
            self._set_status(
                "A single-package install is still running — please wait…",
                "info")
            return
        safe_names = self._model.checked_names()
        if not safe_names:
            return
        self._updating = True
        self._retry_mode = False
        if safe_names != self._last_run_names:
            # Different selection → different problem possibly; reset guard.
            self._fail_sig = None
            self._fail_streak = 0
        self._last_run_names = list(safe_names)
        self._update_btn.setEnabled(False)
        self._skip_btn.setEnabled(True)
        self._skip_btn.setText("Cancel update")
        self._select_all_btn.setEnabled(False)
        self._select_none_btn.setEnabled(False)
        self._hide_failure_ui()
        self._set_status("", "info")
        self._model.reset_states()
        self._log_view.clear()
        self._note_activity()
        self._stuck_warned = False
        self._watchdog.start()

        comp_pkgs = [p for p in self._updates if p.get("compromised")]
        self._safe_names = safe_names

        n = len(safe_names)
        self._sub.setText(f"Installing… <b>0</b> of <b>{n}</b> selected")
        self._stat_ready.set_value(str(n))
        self._stat_ready.set_caption("remaining")
        self._stat_ready.set_accent("#1e8e3e")
        msg = "Waiting for authentication — a password dialog should appear…"
        if comp_pkgs:
            skipped = ", ".join(p["name"] for p in comp_pkgs)
            msg = f"Skipping compromised: {skipped}. {msg}"
        if self._overwrite:
            msg += " (retrying with --overwrite)"
        self._set_status(msg, "info")
        self._set_progress_state("normal")
        self._progress.setRange(0, 0)
        self._progress.setFormat("")
        self._anim.start()

        self._runner = UpdateRunner(
            self._aur_helper, safe_names, overwrite=self._overwrite)
        self._runner.install_progress.connect(self._on_install_progress)
        self._runner.line.connect(self._on_log_line)
        self._runner.done.connect(self._on_update_done)
        self._runner.start()

    def _on_install_progress(self, current: int, total: int, pkg: str) -> None:
        if self._progress.maximum() == 0:
            self._progress.setRange(0, total)   # switch away from indeterminate
            self._set_progress_state("normal")
        self._progress.setValue(current)
        self._note_activity()
        remaining = total - current
        r = self._model.ensure_row(pkg)
        if self._model.item(r).get("auto"):
            self._sub.setText(
                f"Installing dependency <b>{pkg}</b> — {current} of {total} "
                f"<span style='color:#757575'>(auto-added below)</span>")
        else:
            self._sub.setText(
                f"Installing <b>{pkg}</b> — {current} of {total}")
        self._stat_ready.set_value(str(remaining))
        self._set_status("", "info")
        if self._installing_row is not None and self._installing_row != r:
            prev = self._model.item(self._installing_row)["name"]
            self._model.set_state(prev, "done")
        self._installing_row = r
        self._model.set_state(pkg, "installing")
        self._list.scrollTo(self._model.index(r),
                            QAbstractItemView.ScrollHint.EnsureVisible)

    # — Live log window —
    def _on_log_line(self, line: str) -> None:
        self._note_activity()
        if is_log_noise(line):
            return
        self._log_view.appendPlainText(line)

    # — Watchdog + cancel —
    def _note_activity(self) -> None:
        self._last_activity = time.time()

    def _watchdog_tick(self) -> None:
        if not (self._updating or self._single is not None):
            return
        if self._stuck_warned:
            return
        if time.time() - self._last_activity > 120:
            self._stuck_warned = True
            self._set_status(
                "No installer output for 2 minutes — it may be waiting for "
                "input. Check the Log, or press Cancel update.", "error")
            self._show_log()

    def _on_skip_or_cancel(self) -> None:
        if self._updating or self._single is not None:
            self._cancel_update()
        else:
            self.close()

    def _cancel_update(self) -> None:
        runner = self._runner or self._single
        if runner is None:
            return
        runner.terminate()
        self._skip_btn.setEnabled(False)
        self._set_status("Cancelling the running install…", "info")

    def _on_log_toggled(self, checked: bool) -> None:
        for w in (self._log_label, self._log_view, self._log_clear_btn):
            w.setVisible(checked)

    def _show_log(self) -> None:
        if not self._log_btn.isChecked():
            self._log_btn.setChecked(True)

    def _copy_error(self) -> None:
        text = self._details.toPlainText()
        if text:
            QApplication.clipboard().setText(text)
            old = self._copy_btn.text()
            self._copy_btn.setText("Copied ✓")
            QTimer.singleShot(2000, lambda: self._copy_btn.setText(old))

    def _on_update_done(self, success: bool, output: str) -> None:
        self._anim.stop()
        self._watchdog.stop()
        self._skip_btn.setText("Skip for Now")
        self._skip_btn.setEnabled(True)
        n_total = self._model.rowCount()
        n_selected = len(self._safe_names)
        n_comp = sum(1 for p in self._updates if p.get("compromised"))
        if success:
            self._overwrite = None
            self._fail_sig = None
            self._fail_streak = 0
            _notify_close(self._fail_notif_id)
            self._fail_notif_id = 0
            self._hide_failure_ui()
            for name in self._safe_names:
                self._model.set_state(name, "done")
            self._installing_row = None
            self._progress.setRange(0, max(n_total, 1))
            self._progress.setValue(n_total)
            self._set_progress_state("ok")
            self._stat_ready.set_value("✓")
            self._stat_ready.set_caption("up to date")
            self._stat_ready.set_accent("#1e8e3e")
            msg = f"<b>{n_selected} package{'s' if n_selected != 1 else ''}</b> updated"
            if n_comp:
                msg += f" <span style='color:#757575'>· {n_comp} compromised skipped</span>"
            self._sub.setText(msg)
            self._set_status("System is up to date. Closing in a moment…", "ok")
            subprocess.Popen([
                "notify-send", "Arch Update Complete",
                f"Successfully updated {n_selected} package{'s' if n_selected != 1 else ''}."
                + (f" {n_comp} compromised skipped." if n_comp else ""),
                "-i", "system-software-update", "-t", "9000",
            ])
            self.update_succeeded.emit()
            QTimer.singleShot(2000, self.close)
            return

        # ── Failure path ──────────────────────────────────────────────
        self._updating = False
        self._runner = None
        self._retry_mode = True
        self._watchdog.stop()
        if self._installing_row is not None:
            # The package being installed never finished — back to idle;
            # the failed run is summarized below with per-row Retry pills.
            prev = self._model.item(self._installing_row)["name"]
            self._model.set_state(prev, "idle")
            self._installing_row = None

        # Name the failing packages even when they were never in the list
        # (dependencies): give them rows + Retry pills so the failure has
        # a visible owner instead of a mystery name in the log.
        all_names = self._model.names()
        failed_names = _failed_package_names(output, all_names)
        conflict_pkgs, _conflict_files = extract_file_conflicts(output or "")
        for pkg in conflict_pkgs:
            if self._model.row_of(pkg) is None:
                self._model.ensure_row(pkg)
                all_names.append(pkg)
            if pkg not in failed_names:
                failed_names.append(pkg)
        for name in failed_names:
            self._model.set_state(name, "failed")

        kind, title, advice = classify_update_failure(output)
        lines = [l for l in output.splitlines() if l.strip()]
        self._last_error = "\n".join(lines[-40:]) if lines else "(no output captured)"

        # Repeat guard: same signature failing again means the auto-fix
        # isn't working — stop the dialog loop, show the manual command.
        sig = (kind, tuple(failed_names))
        self._fail_streak = self._fail_streak + 1 if sig == self._fail_sig else 1
        self._fail_sig = sig
        manual_cmd = ""
        if failed_names:
            manual_cmd = (
                "Manual fix (run in a terminal):\n"
                f"  sudo pacman -S {' '.join(failed_names)} --overwrite '*'\n\n")
        if self._fail_streak >= 2 and kind != "cancelled":
            advice += (f" This exact failure happened {self._fail_streak} "
                       f"times in a row — automatic fixes are paused.")

        # Red, full progress track — never green on failure.
        self._progress.setRange(0, 1)
        self._progress.setValue(1)
        self._set_progress_state("error")

        n_done = sum(1 for r in range(self._model.rowCount())
                     if self._model.item(r)["state"] == "done")
        n_pending = max(0, n_selected - n_done)
        self._stat_ready.set_value(str(n_pending))
        self._stat_ready.set_caption("pending — retry")
        self._stat_ready.set_accent("#e01b24")
        self._sub.setText(
            f"<b style='color:#e5484d'>Update failed</b> — "
            f"<b>{n_pending}</b> package{'s' if n_pending != 1 else ''} "
            "pending"
        )
        self._show_log()

        # Unmissable who/why summary in the status box (proven to render),
        # then jump the list to the failed row and its Retry pill.
        who = ", ".join(failed_names) if failed_names else "unknown package"
        self._set_status(f"✕ {title}: {who}. {advice}", "error")
        self._fail_row = (self._model.row_of(failed_names[0])
                          if failed_names else None)
        self._scroll_to_failed()

        self._details.setPlainText(manual_cmd + self._last_error)
        self._details_label.setVisible(True)
        self._details.setVisible(True)
        self._copy_btn.setVisible(True)

        self._update_btn.setEnabled(True)
        self._skip_btn.setEnabled(True)
        self._skip_btn.setText("Skip for Now")
        self._select_all_btn.setEnabled(True)
        self._select_none_btn.setEnabled(True)
        self._refresh_selection_ui()

        if kind == "cancelled":
            return  # dismissing auth is not a failure — stay silent
        body = f"{title}: {who}"
        if self._fail_streak >= 2:
            body += f"\nFailure #{self._fail_streak} — same issue repeated"
        self._fail_notif_id = _notify_update(
            "Arch Update Failed", body,
            replaces_id=self._fail_notif_id)

        if self._fail_streak >= 2:
            return  # guard: no more auto-fix dialogs for the same failure
        if self._offer_open:
            return  # single-flight: never stack modal fix dialogs
        self._offer_open = True
        try:
            self._maybe_offer_obsolete_cleanup(output)
            self._maybe_offer_overwrite_retry(kind, output)
        finally:
            self._offer_open = False

    def _maybe_offer_overwrite_retry(self, kind: str, output: str,
                                       single_name: str | None = None) -> None:
        """Offer 'Retry with --overwrite' for 'exists in filesystem' failures."""
        if kind != "file-conflict":
            return
        pkgs, files = extract_file_conflicts(output)
        shown = "\n".join(f"  • {f}" for f in files[:8])
        if len(files) > 8:
            shown += f"\n  • …and {len(files) - 8} more"
        who = ", ".join(pkgs) if pkgs else "the failing package(s)"
        box = QMessageBox(self)
        box.setWindowTitle("Files already exist on disk")
        box.setIcon(QMessageBox.Icon.Warning)
        box.setText(
            f"{who} can't install because these files already exist:\n\n"
            f"{shown}\n\n"
            "This usually follows a pip install into system paths.\n"
            "Retry with “--overwrite '*'” to let pacman replace them?"
        )
        retry_btn = box.addButton("Retry with --overwrite", QMessageBox.ButtonRole.AcceptRole)
        box.addButton("Not Now", QMessageBox.ButtonRole.RejectRole)
        box.exec()
        if box.clickedButton() is retry_btn:
            if single_name is not None:
                self._run_single(single_name, overwrite="*")
            else:
                self._overwrite = "*"
                self.start_update()

    # — Show-more popover —
    def _on_more_requested(self, row: int) -> None:
        self.show_popover(row)

    def show_popover(self, row: int) -> None:
        self._popover = NotesPopover(self, self._model.item(row))
        self._popover.show()

    # — Per-package actions —
    def _on_row_action(self, name: str) -> None:
        r = self._model.row_of(name)
        if r is None:
            return
        item = self._model.item(r)
        if item["compromised"]:
            self._confirm_install_anyway(name, item)
        else:
            self._run_single(name)

    def _confirm_install_anyway(self, name: str, item: dict) -> None:
        reasons = "; ".join(item.get("reasons", ["unknown"]))
        box = QMessageBox(self)
        box.setWindowTitle(f"Install {name} anyway?")
        box.setIcon(QMessageBox.Icon.Critical)
        box.setText(
            f"⚠️  {name} is flagged as COMPROMISED and was skipped for your safety:\n\n"
            f"{reasons}\n\n"
            "Installing it may compromise your system. Only proceed if you have "
            "personally verified the package is safe (e.g. the upstream issue "
            "was resolved and the package was rebuilt)."
        )
        go_btn = box.addButton("I verified — install anyway",
                               QMessageBox.ButtonRole.AcceptRole)
        box.addButton("Cancel", QMessageBox.ButtonRole.RejectRole)
        box.exec()
        if box.clickedButton() is go_btn:
            self._run_single(name)

    def _run_single(self, name: str, overwrite: str | None = None) -> None:
        """Install exactly one package (retry a failure, or install-anyway)."""
        if self._updating or self._single is not None:
            self._set_status(
                "Another install is already running — please wait…", "info")
            return
        self._single_name = name
        self._single_overwrite = overwrite
        self._model.set_state(name, "installing")
        self._anim.start()
        self._note_activity()
        self._stuck_warned = False
        self._watchdog.start()
        self._show_log()
        self._set_status(f"Installing {name}…", "info")
        self._skip_btn.setText("Cancel update")
        self._skip_btn.setEnabled(True)
        self._single = UpdateRunner(
            self._aur_helper, [name], overwrite=overwrite)
        self._single.line.connect(self._on_log_line)
        self._single.done.connect(self._on_single_done)
        self._single.start()

    def _on_single_done(self, success: bool, output: str) -> None:
        name = self._single_name or ""
        self._single = None
        self._single_name = None
        self._anim.stop()
        self._watchdog.stop()
        self._skip_btn.setText("Skip for Now")
        self._skip_btn.setEnabled(True)
        r = self._model.row_of(name)
        if r is None:
            return
        if success:
            self._model.set_state(name, "done")
            _notify_close(self._fail_notif_id)
            self._fail_notif_id = 0
            self._sub.setText(f"<b>{name}</b> installed ✓")
            self._set_status("", "info")
            subprocess.Popen([
                "notify-send", "Arch Update", f"{name} installed.",
                "-i", "system-software-update", "-t", "6000",
            ])
            return
        self._model.set_state(name, "failed")
        kind, title, advice = classify_update_failure(output)
        lines = [l for l in output.splitlines() if l.strip()]
        self._last_error = "\n".join(lines[-40:]) if lines else "(no output captured)"
        self._details.setPlainText(self._last_error)
        self._details_label.setVisible(True)
        self._details.setVisible(True)
        self._copy_btn.setVisible(True)
        self._set_status(f"✕ {name}: {title}. {advice}", "error")
        self._fail_row = r
        self._scroll_to_failed()
        self._show_log()
        if kind == "cancelled":
            return
        self._fail_notif_id = _notify_update(
            "Arch Update Failed", f"{title}: {name}",
            replaces_id=self._fail_notif_id)
        if self._offer_open:
            return
        self._offer_open = True
        try:
            self._maybe_offer_overwrite_retry(kind, output, single_name=name)
        finally:
            self._offer_open = False

    def _maybe_offer_obsolete_cleanup(self, output: str) -> None:
        """If the failed update looks blocked by dropped packages, offer to remove them."""
        try:
            obsolete = get_obsolete_packages()
        except Exception:
            obsolete = []
        culprits = obsolete_conflict_culprits(output, obsolete)
        if not culprits:
            return

        names = "\n".join(f"  • {pkg}" for pkg in culprits)
        box = QMessageBox(self)
        box.setWindowTitle("Obsolete packages blocking the update")
        box.setIcon(QMessageBox.Icon.Warning)
        box.setText(
            "The update failed, possibly because these packages are no longer\n"
            "provided by any repository and are blocking the upgrade:\n\n"
            f"{names}\n\n"
            "They are usually split packages dropped upstream and are safe to remove.\n"
            "Remove them now and retry the update?"
        )
        remove_btn = box.addButton("Remove & Retry", QMessageBox.ButtonRole.AcceptRole)
        box.addButton("Cancel", QMessageBox.ButtonRole.RejectRole)
        box.exec()
        if box.clickedButton() is remove_btn:
            self._start_obsolete_removal(culprits)

    def _start_obsolete_removal(self, packages: list[str]) -> None:
        force = False
        blocked = find_blocked_obsolete_packages(packages)
        if blocked:
            names = ", ".join(blocked)
            box = QMessageBox(self)
            box.setWindowTitle("Obsolete packages still required")
            box.setIcon(QMessageBox.Icon.Warning)
            box.setText(
                f"{names} is/are still required by other installed packages.\n\n"
                "Removing them requires ignoring dependencies (-Rdd).\n"
                "Only do this if the packages requiring them are being upgraded\n"
                "to versions that no longer depend on them."
            )
            force_btn = box.addButton("Force Removal", QMessageBox.ButtonRole.AcceptRole)
            box.addButton("Cancel", QMessageBox.ButtonRole.RejectRole)
            box.exec()
            if box.clickedButton() is not force_btn:
                return
            force = True

        self._update_btn.setEnabled(False)
        self._skip_btn.setEnabled(False)
        self._progress.setRange(0, 0)
        self._progress.setFormat("")
        self._set_progress_state("normal")
        self._set_status("Removing obsolete packages… (a password dialog may appear)", "info")

        self._remover = ObsoleteRemover(packages, force=force)
        self._remover.done.connect(self._on_obsolete_removal_done)
        self._remover.start()

    def _on_obsolete_removal_done(self, success: bool, output: str) -> None:
        self._remover = None
        if not success:
            last = [l for l in output.splitlines() if l.strip()][-2:]
            hint = " · ".join(last) if last else "No output captured"
            self._set_status(f"Obsolete removal failed: {hint}", "error")
            self._update_btn.setEnabled(True)
            self._skip_btn.setEnabled(True)
            return
        self._set_status("Obsolete packages removed — retrying update…", "info")
        self.start_update()

    def keyPressEvent(self, event) -> None:  # type: ignore[override]
        if event.key() == Qt.Key.Key_Escape:
            self.close()
        elif (
            event.key() in (Qt.Key.Key_Return, Qt.Key.Key_Enter)
            and not self._search.hasFocus()
            and self._update_btn.isEnabled()
        ):
            self.start_update()
        else:
            super().keyPressEvent(event)

    def closeEvent(self, event) -> None:  # type: ignore[override]
        super().closeEvent(event)
        self.closed.emit()



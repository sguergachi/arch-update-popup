            src.setOpenExternalLinks(True)
            lay.addWidget(src)

        browser = QTextBrowser()
        browser.setObjectName("details")
        browser.setPlainText((item.get("full") or item.get("notes") or "").strip())
        browser.setFont(QFont("monospace"))
        lay.addWidget(browser, 1)

        row = QHBoxLayout()
        row.setSpacing(8)
        pkg_link = QLabel(
            f"<a href='{_package_url(item['name'], item['repo'])}'>"
            "Open package page ↗</a>")
        pkg_link.setObjectName("package-link")
        pkg_link.setOpenExternalLinks(True)
        row.addWidget(pkg_link)
        row.addStretch()
        copy_btn = QPushButton("Copy")
        copy_btn.setObjectName("secondary-small")
        copy_btn.setFixedHeight(32)
        copy_btn.setIcon(app_icon("copy", 14))
        copy_btn.clicked.connect(
            lambda: QApplication.clipboard().setText(browser.toPlainText()))

        lay_sec = QVBoxLayout(self._slot_security)
        lay_sec.setContentsMargins(0, 0, 0, 0)
        up.addWidget(self._slot_security)
        self._slot_moves = QWidget()
        lay_moves = QVBoxLayout(self._slot_moves)
        lay_moves.setContentsMargins(0, 0, 0, 0)
        up.addWidget(self._slot_moves)
        self._refresh_view_banners(recompute_moves=True)

        n_cached = sum(1 for i in range(n) if i in cached_info)
        self._set_idle_header(n_cached)

        self._model = PackageModel(updates, cached_info)
        self._list = QListView()

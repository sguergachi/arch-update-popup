    def _enable_source(self, name: str, steps: str, card: QWidget,
                       btn: QPushButton) -> None:
        """Enable a source inline — no modal dialogs."""
        # Confirm first (one small dialog is fine for a system change).
        box = QMessageBox(self)
        box.setIcon(QMessageBox.Icon.Question)
        box.setWindowTitle(f"Enable {name}?")
        box.setText(f"Enable {name}?")
        box.setInformativeText(
            "This will change your system: it imports a signing key, "
            "installs the repo's mirrorlist and keyring, and appends the "
            "repo to /etc/pacman.conf. Nothing runs until you confirm.")
        box.setDetailedText(steps)
        box.setStyleSheet(_themed_qss())
        run_btn = box.addButton("Enable", QMessageBox.ButtonRole.AcceptRole)
        copy_btn = box.addButton("Copy commands",
                                 QMessageBox.ButtonRole.ActionRole)
        box.addButton("Cancel", QMessageBox.ButtonRole.RejectRole)

        def _copy() -> None:
            QApplication.clipboard().setText(steps)
            copy_btn.setText("Copied ✓")

        copy_btn.clicked.connect(_copy)
        box.exec()
        if box.clickedButton() is not run_btn:
            return

        # Inline progress: the button becomes "Enabling…", the description
        # slot swaps to the live status, and the card's track turns accent.
        # Nothing is added to the layout, so nothing moves.
        btn.setEnabled(False)
        btn.setText("Enabling…")
        self._set_note_role(card._status_lbl, "text-muted")
        card._status_lbl.setText("Starting…")
        card._bar.setRange(0, 0)
        self._set_bar_state(card._bar, "running")
        self.logged.emit(f"Enabling {name}…")
        self._enable_runner = _SourceEnableRunner(steps)
        self._enable_runner.line.connect(
            lambda line, c=card: c._status_lbl.setText(line))
        self._enable_runner.line.connect(self.logged.emit)
        self._enable_runner.done.connect(
            lambda ok, out, n=name, c=card, b=btn:
            self._on_enable_done(ok, out, n, c, b))
        self._enable_runner.start()

    def _on_enable_done(self, success: bool, output: str, name: str,
                        card: QWidget, btn: QPushButton) -> None:
        runner = getattr(self, "_enable_runner", None)
        self._enable_runner = None
        if runner is not None:
            runner.wait(5000)
        if success:
            card._status_lbl.setText(f"{name} enabled ✓ — restart to apply.")
            self._set_note_role(card._status_lbl, "text-positive")
            card._bar.setRange(0, 1)
            card._bar.setValue(1)
            self._set_bar_state(card._bar, "done")
            btn.setText("Enabled ✓")
            btn.setEnabled(False)
            # The badge was built from the state at open time: flip it too,
            # so the card cannot say "enabled" and "not enabled" at once.
            badge = getattr(card, "_badge", None)
            if badge is not None:
                badge.setText("ENABLED")
                badge.setProperty("tint", "positive")
                style = badge.style()
                style.unpolish(badge)
                style.polish(badge)
            self.restart_needed.emit()
            self.logged.emit(f"{name} enabled — restart to apply")
        else:
            lines = [l for l in output.splitlines() if l.strip()]
            hint = lines[-1] if lines else "No output captured"
            card._status_lbl.setText(f"Failed: {hint}")
            self._set_note_role(card._status_lbl, "text-negative")
            card._bar.setRange(0, 1)
            card._bar.setValue(1)
            self._set_bar_state(card._bar, "failed")
            btn.setText("Enable")
            btn.setEnabled(True)

    def _set_note_role(self, lbl: QLabel, role: str) -> None:
        """Swap a label's semantic role through the stylesheet, so the
        color follows the live theme instead of freezing inline."""
        if lbl.objectName() == role:
            return
        lbl.setObjectName(role)
        style = lbl.style()
        style.unpolish(lbl)
        style.polish(lbl)

    def _set_bar_state(self, bar: QProgressBar, state: str) -> None:
        """Repaint a card's track for a new state (see the QSS variants)."""
        bar.setProperty("state", state)
        style = bar.style()
        style.unpolish(bar)
        style.polish(bar)

    def closeEvent(self, event) -> None:  # type: ignore[override]
        runner = getattr(self, "_enable_runner", None)
        if runner is not None:
            if runner.isRunning():
                runner.terminate()
                runner.wait(8000)
            self._enable_runner = None
        super().closeEvent(event)
        self.closed.emit()

    def changeEvent(self, event) -> None:  # type: ignore[override]
        super().changeEvent(event)
        if event.type() in _THEME_CHANGE_TYPES:
            self.setStyleSheet(_themed_qss())


class MovesDialog(QMainWindow):

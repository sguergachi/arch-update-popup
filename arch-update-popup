        self._sources_dialog.activateWindow()

    def _on_source_enabled(self) -> None:
        self._restart_needed = True
        self._restart_btn.setVisible(True)
        self._log_action("Source enabled — restart to apply")

    def _on_sources_closed(self) -> None:
        self._sources_dialog = None

    def _open_moves_dialog(self) -> None:
        if self._moves_dialog is not None:
            self._moves_dialog.raise_()
            self._moves_dialog.activateWindow()
            return
        self._moves_dialog = MovesDialog(self._pending_moves)
        self._moves_dialog.closed.connect(self._on_moves_dialog_closed)
        self._moves_dialog.moves_done.connect(self._on_moves_changed)
        self._moves_dialog.logged.connect(self._log_action)

class _StatCard(QWidget):
    """One cell of the stat strip: a big number, then its caption.

    Every cell is the same fixed height so the strip reads as one even
    row of the grid no matter how long a caption is. Cells that stand for
    a subset of the list are clickable filters: the active one is
    highlighted, and nothing moves when it changes (same box, new border).
    """

    clicked = pyqtSignal()

    def __init__(self, value: str, caption: str, accent: str,
                 filterable: bool = True) -> None:
        super().__init__()
        self.setObjectName("stat-card")
        # Plain QWidgets don't paint QSS backgrounds/borders without this.
        self.setAttribute(Qt.WidgetAttribute.WA_StyledBackground, True)
        self.setAttribute(Qt.WidgetAttribute.WA_Hover, filterable)
        self.setFixedHeight(_sp(38))
        # A fixed column width keeps the strip a real grid: the numbers
        # stay grouped instead of drifting apart across a wide window.
        self.setMaximumWidth(_sp(280))
        self.setProperty("active", False)
        self.setProperty("filterable", filterable)
        self._filterable = filterable
        if filterable:
            self.setCursor(Qt.CursorShape.PointingHandCursor)
        lay = QHBoxLayout(self)
        lay.setContentsMargins(_sp(14), 0, _sp(14), 0)
        lay.setSpacing(_sp(8))
        self._value = QLabel(value)
        self._value.setObjectName("stat-value")
        self._value.setStyleSheet(f"color: {accent};")
        self._caption = QLabel(caption.upper())
        self._caption.setObjectName("stat-caption")
        # Fixed height + baseline alignment: a 22px number and an 11px
        # caption then sit on one shared baseline, whatever the font scale.
        for lbl in (self._value, self._caption):
            lbl.setSizePolicy(QSizePolicy.Policy.Preferred,
                              QSizePolicy.Policy.Fixed)
            lbl.setAlignment(Qt.AlignmentFlag.AlignLeft
                             | Qt.AlignmentFlag.AlignBaseline)
            lay.addWidget(lbl, 0, Qt.AlignmentFlag.AlignBaseline)
        lay.addStretch()

    def set_value(self, text: str) -> None:
        self._value.setText(text)

    def set_caption(self, text: str) -> None:
        self._caption.setText(text.upper())

    def set_accent(self, color: str) -> None:
        self._value.setStyleSheet(f"color: {color};")

    def set_active(self, active: bool) -> None:
        """Highlight this cell as the filter in force (no geometry change)."""
        active = bool(active)
        if self.property("active") == active:
            return
        self.setProperty("active", active)
        style = self.style()
        style.unpolish(self)
        style.polish(self)

    def set_filterable(self, on: bool) -> None:
        """A cell with nothing behind it stays a readout, not a button."""
        on = bool(on)
        self.setProperty("filterable", on)
        self.setAttribute(Qt.WidgetAttribute.WA_Hover, on)
        self.setCursor(Qt.CursorShape.PointingHandCursor if on
                       else Qt.CursorShape.ArrowCursor)
        style = self.style()
        style.unpolish(self)
        style.polish(self)

    def mouseReleaseEvent(self, event) -> None:  # type: ignore[override]
        if (self._filterable and event.button() == Qt.MouseButton.LeftButton
                and self.rect().contains(event.position().toPoint())):
            self.clicked.emit()
        super().mouseReleaseEvent(event)


def _stat_strip(cards: list[_StatCard]) -> QWidget:
    """One row of stat cells: equal widths, honest whitespace after."""
    row = QWidget()

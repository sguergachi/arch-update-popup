               "muted"),
    "reboot": ('<path d="M12 3.5v8"/><path d="M7.4 6.6a7 7 0 1 0 9.2 0"/>',
               "on_warning"),
}

_ICON_CACHE: dict[tuple[str, int, str], QIcon] = {}


def _icon_color(token: str) -> str:
    """Resolve an icon stroke token to a color for the active theme."""
    if token == "muted":
        return _secondary_hex()
    if token == "accent":
        return _accent_hex()
    if token == "positive":
        return _positive_hex()
    if token == "negative":
        return _negative_hex()
    if token == "warning":
        return _warning_hex()
    if token == "on_accent":
        return _on_accent_hex()
    if token == "on_warning":
        return _on_warning_hex()
    return token


def app_icon(name: str, size: int = 16, token: str | None = None) -> QIcon:
    """Fetch (and cache) a bundled icon by name, colored for the theme.

    `token` overrides the icon's own color role — an icon sitting on a
    filled accent button must be drawn in the on-accent color, not its
    semantic one (a green check on blue reads as a mistake).
    """
    body, default_token = _ICON_SVGS[name]
    stroke = _icon_color(token or default_token)
    key = (name, size, stroke)
    if key not in _ICON_CACHE:
        data = (
            f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"'
            f' width="{size}" height="{size}" fill="none" stroke="{stroke}"'
            f' stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">'
            f"{body}</svg>"
        ).encode()
        _ICON_CACHE[key] = _svg_icon(data, size)
    return _ICON_CACHE[key]


def _svg_icon(data: bytes, size: int = 16) -> QIcon:
    """Render an inline SVG into a QIcon (same technique as the app icon)."""
    renderer = QSvgRenderer(QByteArray(data))
    pm = QPixmap(size, size)
    pm.fill(QColor(0, 0, 0, 0))
    painter = QPainter(pm)
    renderer.render(painter, QRectF(0, 0, size, size))
    painter.end()
    return QIcon(pm)


def _divider() -> QFrame:
    """Hairline separator between layout zones."""
    line = QFrame()
    line.setObjectName("divider")
    line.setFrameShape(QFrame.Shape.HLine)
    line.setFrameShadow(QFrame.Shadow.Plain)
    line.setLineWidth(1)
    return line


def _accent_strip(color: str) -> QFrame:
    """The 3px state rail the painted cards use, for widget-based cards.

    Qt does not render a per-side border on a rounded widget, so the rail
    is a real element — the same width, inset and radius as the one the
    delegates paint, which keeps both card styles identical.
    """
    strip = QFrame()
    strip.setObjectName("accent-strip")
    strip.setFixedWidth(3)
    strip.setStyleSheet(
        f"QFrame#accent-strip {{ background: {color}; border-radius: 2px; }}")
    return strip


def _card_layout(card: QWidget, accent: str | None,
                 spacing: int = 6) -> QVBoxLayout:
    """Give a card its accent rail (if any) and return its body layout."""
    outer = QHBoxLayout(card)
    outer.setContentsMargins(0, 0, 0, 0)
    outer.setSpacing(0)
    if accent:
        # Inset the rail vertically so it never fights the corner radius.
        rail = QVBoxLayout()
        rail.setContentsMargins(0, _sp(8), 0, _sp(8))
        rail.addWidget(_accent_strip(accent))
        outer.addLayout(rail)
    body = QVBoxLayout()
    body.setContentsMargins(_sp(16), _sp(12), _sp(16), _sp(12))
    body.setSpacing(_sp(spacing))
    outer.addLayout(body, 1)
    return body


class _ListHeader(QWidget):
    """The strip above a card list: select-all, a count, and a filter.

    These controls act on rows, so they live with the rows instead of in
    the footer. One tri-state box replaces the old All/None pair: tick it
    to take everything the filter is showing, untick it to drop it all.
    """

    select_all = pyqtSignal(bool)
    filter_changed = pyqtSignal(str)

    def __init__(self, placeholder: str = "", with_search: bool = True,
                 with_select: bool = True) -> None:
        super().__init__()
        self.setObjectName("list-header")
        # Last state we painted: Qt cycles a tri-state box *before*
        # emitting clicked(), so the click handler must not read it back.
        self._shown = Qt.CheckState.Unchecked
        lay = QHBoxLayout(self)
        lay.setContentsMargins(0, 0, 0, 0)
        lay.setSpacing(_sp(8))

        # The filter leads the strip, at the far left, at a fixed width —
        # a full-width bar dwarfed the count it sits next to.
        self.search: QLineEdit | None = None
        if with_search:
            self.search = QLineEdit()
            self.search.setObjectName("search")
            self.search.setPlaceholderText(placeholder)
            self.search.setClearButtonEnabled(True)
            self.search.setFixedWidth(_sp(240))
            self.search.setToolTip("Filter this list by name or description")
            self.search.addAction(app_icon("search", 14),
                                  QLineEdit.ActionPosition.LeadingPosition)
            self.search.textChanged.connect(self.filter_changed)
            lay.addWidget(self.search, 0, Qt.AlignmentFlag.AlignVCenter)
        lay.addStretch()

        # What the controls are producing: the selection, then how much of
        # the list the filter is hiding — then the control itself, far
        # right, so the strip is anchored at both ends.
        self.count = QLabel("")
        self.count.setObjectName("meta")
        lay.addWidget(self.count, 0, Qt.AlignmentFlag.AlignVCenter)
        self.filtered = QLabel("")
        self.filtered.setObjectName("meta")
        lay.addWidget(self.filtered, 0, Qt.AlignmentFlag.AlignVCenter)

        self.check: QCheckBox | None = None
        if with_select:
            self.check = QCheckBox("Select all")
            self.check.setObjectName("select-all")
            self.check.setTristate(True)
            self.check.setCursor(Qt.CursorShape.PointingHandCursor)
            self.check.clicked.connect(self._on_click)
            lay.addWidget(self.check, 0, Qt.AlignmentFlag.AlignVCenter)

    def _on_click(self) -> None:
        # Ask for the opposite of what we last showed; the window then
        # reports the real selection back through set_state().
        want = self._shown != Qt.CheckState.Checked
        self.check.setCheckState(Qt.CheckState.Checked if want
                                 else Qt.CheckState.Unchecked)
        self._shown = self.check.checkState()
        self.select_all.emit(want)

    def set_state(self, selected: int, total: int) -> None:
        """Mirror the real selection: all, none, or a partial count."""
        if self.check is not None:
            self.check.blockSignals(True)
            if total == 0 or selected == 0:
                self.check.setCheckState(Qt.CheckState.Unchecked)
            elif selected >= total:
                self.check.setCheckState(Qt.CheckState.Checked)
            else:
                self.check.setCheckState(Qt.CheckState.PartiallyChecked)
            self.check.setEnabled(total > 0)
            self._shown = self.check.checkState()
            self.check.blockSignals(False)
        # The count is always on show: the box says the state, this says
        # the number, and together they balance the strip against the
        # controls on the left.
        self.count.setText(self._count_text(selected, total))
        self.count.setVisible(True)

    @staticmethod
    def _count_text(selected: int, total: int) -> str:
        if total == 0:
            return "Nothing selected"
        if selected >= total:
            return f"All {total} packages selected"
        if selected == 0:
            return "No packages selected"
        return f"{selected} of {total} selected"

    def set_filter_info(self, shown: int, total: int) -> None:
        """Say how much is hidden, but only when something actually is.

        The leading separator keeps it readable next to the selection
        count, which shares this end of the strip.
        """
        hidden = total - shown
        self.filtered.setText(f"·  {shown} of {total}" if hidden > 0 else "")
        self.filtered.setVisible(hidden > 0)

    def filter_text(self) -> str:
        return self.search.text() if self.search is not None else ""

    def set_filter_enabled(self, enabled: bool) -> None:
        if self.search is not None:
            self.search.setEnabled(enabled)



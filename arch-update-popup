def _build_qss() -> str:
    """The stylesheet for the active theme, on the desktop's type scale."""
    t = _tokens()
    accent = t["accent"]
    on_accent = _on_accent_hex()
    return _QSS_TEMPLATE % {
        "title": _sp(20), "stat": _sp(22), "body": _sp(13), "meta": _sp(12),
        "eyebrow": _sp(11),
        "radius": 6, "radius_inner": 4, "accentbar": 3,
        "control": _sp(34), "pad14": _sp(14), "pad18": _sp(18),
        "muted": _secondary_hex(),
        "accent": accent,
        "accent_hover": _mix(accent, "#ffffff" if t["dark"] else "#000000",
                             0.14),
        "accent_press": _mix(accent, "#000000", 0.28),
        "accent_soft": _accent_soft(),
        "on_accent": on_accent,
        "positive": t["positive"], "negative": t["negative"],
        "warning": t["neutral"], "link": t["link"], "visited": t["visited"],
        "on_warning": _on_warning_hex(),
        "warning_hover": _mix(t["neutral"],
                              "#ffffff" if t["dark"] else "#000000", 0.14),
        "warning_press": _mix(t["neutral"], "#000000", 0.28),
        "surface": t["surface"], "canvas": t["canvas"],
        "border": t["border"], "hover": t["hover"],
        "disabled": _mix(t["surface"], t["text"], 0.35),
        "on_disabled": _mix(t["surface"], t["text"], 0.75),
        "warning_soft": _soft(t["neutral"]),
        "positive_soft": _soft(t["positive"]),
        "negative_soft": _soft(t["negative"]),
        "visited_soft": _soft(t["visited"]),
        "muted_soft": _soft(_secondary_hex()),
    }


# The light-theme build for the active font scale. _themed_qss() refreshes
# it, so callers can compare a live stylesheet against the reference.
_APP_QSS = _build_qss()
_QSS_CACHE: dict[tuple[bool, float], str] = {}


def _package_url(name: str, repo: str, url: str = "") -> str:
    """Where to read about this package or app — '' when nowhere honest.

    Each source has its own home: a Flatpak app is on Flathub, an AUR
    package on the AUR, a repo package in Arch's search. An AppImage is
    just a file: its launcher's URL if it has one, otherwise no link at
    all — a wrong page is worse than no link.
    """
    key = _source_key(repo)
    if key == SRC_FLATPAK:
        return f"https://flathub.org/apps/{name}"
    if key == SRC_AUR:
        return f"https://aur.archlinux.org/packages/{name}"
    if key in (SRC_APPIMAGE, SRC_MANUAL):
        return (url or "").strip()
    return f"https://archlinux.org/packages/?q={name}"


def _themed_qss() -> str:
    """The app stylesheet, rebuilt when the theme or font scale changes."""
    global _APP_QSS, _SCALE
    _SCALE = _font_scale()
    key = (_is_dark_theme(), round(_SCALE, 3))
    qss = _QSS_CACHE.get(key)
    if qss is None:
        qss = _build_qss()
        if len(_QSS_CACHE) > 4:
            _QSS_CACHE.clear()
        _QSS_CACHE[key] = qss
        if not key[0]:
            _APP_QSS = qss
    return qss


# Widget change events that mean "the desktop theme may have flipped".
# ThemeChange is new-ish (Qt 6.8+); guard so older Qt still works — the
# palette/style events cover the same ground.
_THEME_CHANGE_TYPES = tuple(
    t for t in (
        getattr(QEvent.Type, "ThemeChange", None),
        getattr(QEvent.Type, "ApplicationPaletteChange", None),
        getattr(QEvent.Type, "StyleChange", None),
    ) if t is not None
)


def _badge(text: str, tint: str) -> QLabel:
    """A small uppercase pill whose color comes from the stylesheet.

    Inline stylesheets would freeze the theme at creation time; a dynamic
    property lets the badge follow a live light/dark switch.
    """
    label = QLabel(text.upper())
    label.setObjectName("repo-badge")
    label.setProperty("tint", tint)
    return label


def _repo_tint_key(repo: str) -> str:
    """Badge tint name for a repo (see the repo-badge QSS variants)."""
    key = _source_key(repo)
    if key == SRC_AUR:
        return "warning"
    if key == SRC_FLATPAK:
        return "positive"
    if key == SRC_APPIMAGE:
        return "visited"
    if key == SRC_MANUAL:
        return "muted"
    r = (repo or "").lower()
    if "testing" in r:
        return "visited"
    return "accent"


def _repo_tint(repo: str) -> tuple[tuple[int, int, int], str]:
    """(rgb, foreground hex) pill colors per repo, readable both themes.

    Colors come from the active scheme: AUR is the desktop's neutral/warning
    hue, testing its visited/purple, Flatpak its positive/green, a manual
    install the muted foreground, official the accent. Callers choose the
    format — stylesheets take CSS rgba(), QPainter takes QColor(*rgb, alpha).
    """
    r = (repo or "").lower()
    key = _source_key(repo)
    hexes = {
        SRC_AUR: _warning_hex(),
        SRC_FLATPAK: _positive_hex(),
        SRC_APPIMAGE: _visited_hex(),
        SRC_MANUAL: _secondary_hex(),
        SRC_OFFICIAL: _accent_hex(),
        SRC_MANAGED: _accent_hex(),
    }
    if "testing" in r:
        hexes[key] = _visited_hex()
    c = QColor(hexes[key])
    return (c.red(), c.green(), c.blue()), hexes[key]



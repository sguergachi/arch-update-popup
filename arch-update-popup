        self.setMinimumSize(560, 420)
        self.setStyleSheet(_APP_QSS)
        lay = QVBoxLayout(self)
        lay.setContentsMargins(20, 16, 20, 16)
        lay.setSpacing(10)

        eyebrow = QLabel("WHAT'S NEW · FULL DETAILS")

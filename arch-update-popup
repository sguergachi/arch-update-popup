    It lives inside the list's own frame and only ever swaps an icon and
    two lines of text, so a refresh or a re-check cannot shift the window
    (see AGENTS.md). States: loading, empty, and nothing-matched.
    """

    def __init__(self, parent: QWidget | None = None) -> None:
        super().__init__(parent)

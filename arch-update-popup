        lay.addWidget(eyebrow)
        title = QLabel(
            f"{item['name']} &nbsp;<span style='color:#757575'>"
            f"{item['old']} → <b style='color:{_NEW_GREEN}'>{item['new']}</b>"
            "</span>")
        title.setObjectName("title")
        title.setStyleSheet("font-size: 17px;")
        lay.addWidget(title)

        if item.get("source"):

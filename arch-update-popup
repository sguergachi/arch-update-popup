class UpdateChecker(QThread):
    """Checks for pending updates off the main thread."""
    updates_found = pyqtSignal(list)
    no_updates    = pyqtSignal()

    def __init__(self, aur_helper: str | None) -> None:
        super().__init__()
        self._aur_helper = aur_helper

    def run(self) -> None:
        updates = get_pending_updates(self._aur_helper)
        if updates:
            self.updates_found.emit(updates)
        else:
            self.no_updates.emit()


class InfoFetcher(QThread):
    """Fetches description and release notes for each pending update.

    Results are persisted to the on-disk cache as they arrive so the update
    window is already populated the next time the same versions are offered.
    """
    # row, name, new_ver, desc, notes, date, full, source_label, source_url
    row_ready = pyqtSignal(int, str, str, str, str, str, str, str, str)

    def __init__(self, updates: list[dict]) -> None:
        super().__init__()
        self._updates = updates
        self._cache = load_pkg_info_cache()

    def run(self) -> None:
        now = time.time()
        for i, pkg in enumerate(self._updates):
            if self.isInterruptionRequested():
                return
            info = fetch_pacman_info(pkg["name"])
            desc = info["desc"] or "No description available"
            notes, date, full, source, source_url = get_whats_new(
                pkg["name"], pkg["new"], info["url"], info["repo"],
                old_ver=pkg.get("old", ""),
            )
            self._cache[pkg["name"]] = {
                "desc": desc, "notes": notes, "date": date,
                "full": full[:6000], "source": source,
                "source_url": source_url,
                "version": pkg["new"], "ts": now,
            }
            for key in [
                k for k, v in self._cache.items()
                if now - v.get("ts", 0) > _CACHE_MAX_AGE_S
            ]:
                del self._cache[key]
            save_pkg_info_cache(self._cache)
            self.row_ready.emit(i, pkg["name"], pkg["new"], desc, notes, date,
                                full, source, source_url)


class SystemScanner(QThread):
    """Scans all installed packages for compromise off the main thread."""
    progress   = pyqtSignal(int, int, str)  # current, total, pkg_name
    done       = pyqtSignal(list)            # list[dict] — scan results

    def run(self) -> None:
        results = scan_installed_for_compromise(
            on_progress=lambda cur, tot, name: self.progress.emit(cur, tot, name)
        )
        self.done.emit(results)


class UpdateRunner(QThread):
    """Runs the package update and streams per-package install progress."""
    install_progress = pyqtSignal(int, int, str)  # current, total, pkg_name
    line             = pyqtSignal(str)             # every raw output line
    done             = pyqtSignal(bool, str)       # success, last output lines

    def __init__(self, aur_helper: str | None, packages: list[str] | None = None,
                 overwrite: str | None = None) -> None:
        super().__init__()
        self._askpass: str | None = None
        self._proc: subprocess.Popen | None = None
        self._killed = False

        extra = ["--overwrite", overwrite] if overwrite else []
        if aur_helper:
            fd, path = tempfile.mkstemp(suffix=".sh", prefix="arch-update-askpass-")
            with os.fdopen(fd, "w") as f:
                f.write(
                    '#!/bin/bash\n'
                    'kdialog --title "Arch Update" --password '
                    '"${1:-Enter sudo password to install updates:}" 2>/dev/null\n'
                )
            os.chmod(path, stat.S_IRWXU)
            self._askpass = path
            if packages:
                self._cmd = [aur_helper, "--sudoflags", "-A", "-S", *packages, "--noconfirm", *extra]
            else:
                self._cmd = [aur_helper, "--sudoflags", "-A", "-Syu", "--noconfirm", *extra]
        else:
            if packages:
                self._cmd = ["pkexec", "pacman", "-S", *packages, "--noconfirm", *extra]
            else:
                self._cmd = ["pkexec", "pacman", "-Syu", "--noconfirm", *extra]

    def run(self) -> None:
        env = os.environ.copy()
        if self._askpass:
            env["SUDO_ASKPASS"] = self._askpass

        # Use a pty so paru/pacman think they're writing to a terminal and
        # flush output per line rather than buffering to the pipe.
        master_fd, slave_fd = pty.openpty()
        try:
            proc = subprocess.Popen(
                self._cmd,
                stdout=slave_fd, stderr=slave_fd,
                stdin=subprocess.DEVNULL,
                env=env, close_fds=True,
            )
        except FileNotFoundError as e:
            os.close(master_fd)
            os.close(slave_fd)
            self._cleanup()
            self.done.emit(False, str(e))
            return

        os.close(slave_fd)  # parent doesn't need the slave end
        self._proc = proc
        if self._killed:
            # Cancel arrived between spawn and here — stop immediately.
            try:
                proc.terminate()
            except Exception:
                pass

        lines: list[str] = []
        buf = ""
        while True:
            try:
                ready, _, _ = select.select([master_fd], [], [], 0.05)
            except (OSError, ValueError):
                break
            if ready:
                try:
                    buf += os.read(master_fd, 4096).decode(errors="replace")
                except OSError:
                    break
                while "\n" in buf:
                    raw, buf = buf.split("\n", 1)
                    for fragment in raw.split("\r"):
                        fragment = _ANSI_RE.sub("", fragment).strip()
                        if not fragment:
                            continue
                        lines.append(fragment)
                        if len(lines) > 2000:
                            del lines[:500]
                        self.line.emit(fragment)
                        m = _INSTALL_RE.match(fragment)
                        if m:
                            self.install_progress.emit(
                                int(m.group(1)), int(m.group(2)), m.group(3)
                            )
            elif proc.poll() is not None:
                break

        try:
            os.close(master_fd)
        except OSError:
            pass

        proc.wait()
        self._cleanup()
        if self._killed:
            lines.append("Cancelled by user.")
        self.done.emit(proc.returncode == 0 and not self._killed,
                       "\n".join(lines[-20:]))

    def terminate(self) -> None:  # type: ignore[override]
        """Ask the installer to stop (Cancel button / watchdog).

        Safe to call from the GUI thread; the run loop notices the dead
        process and emits done(False, …) as usual.
        """
        self._killed = True
        proc = self._proc
        if proc is not None:
            try:
                proc.terminate()
            except Exception:
                pass

    def _cleanup(self) -> None:
        if self._askpass:
            try:
                os.unlink(self._askpass)
            except OSError:
                pass
            self._askpass = None


class ObsoleteRemover(QThread):
    """Removes obsolete packages (privileged) and streams the output."""

    done = pyqtSignal(bool, str)  # success, last output lines

    def __init__(self, packages: list[str], force: bool = False) -> None:
        super().__init__()
        op = "-Rdd" if force else "-Rns"
        self._cmd = ["pkexec", "pacman", op, *packages, "--noconfirm"]

    def run(self) -> None:
        master_fd, slave_fd = pty.openpty()
        try:
            proc = subprocess.Popen(
                self._cmd,
                stdout=slave_fd, stderr=slave_fd,
                stdin=subprocess.DEVNULL,
                close_fds=True,
            )
        except FileNotFoundError as e:
            os.close(master_fd)
            os.close(slave_fd)
            self.done.emit(False, str(e))
            return

        os.close(slave_fd)

        lines: list[str] = []
        buf = ""
        while True:
            try:
                ready, _, _ = select.select([master_fd], [], [], 0.05)
            except (OSError, ValueError):
                break
            if ready:
                try:
                    buf += os.read(master_fd, 4096).decode(errors="replace")
                except OSError:
                    break
                while "\n" in buf:
                    raw, buf = buf.split("\n", 1)
                    for fragment in raw.split("\r"):
                        fragment = _ANSI_RE.sub("", fragment).strip()
                        if fragment:
                            lines.append(fragment)
            elif proc.poll() is not None:
                break

        try:
            os.close(master_fd)
        except OSError:
            pass

        proc.wait()
        self.done.emit(proc.returncode == 0, "\n".join(lines[-8:]))


# ── Design system ──────────────────────────────────────────────────────────
#
# Grid: 8pt base unit. Window margins 24 (3u), section gaps 16 (2u),
# related-item gaps 8 (1u), micro gaps 4. Stat cards share one row with
# equal stretch so they always form an even grid.
#
# Type scale: eyebrow 11 / title 22·bold / section 13·semibold /
# body 13 / meta 12 / table header 12·semibold / stat number 20·bold.
# Headers and captions are uppercase kickers; body text is sentence case.

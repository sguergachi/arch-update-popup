def _relation_pill(relation: str, source: str = "") -> str:
    """Pill label for a switch candidate: which source, and how it compares."""
    label = _repo_label(source)
    return {
        "upgrade": f"{label} newer",
        "same": "same version",
        "downgrade": f"{label} older",
    }.get(relation, label)


def _relation_tint(relation: str) -> str:
    return {"upgrade": "positive", "downgrade": "warning"}.get(relation,
                                                               "muted")


def _relation_color(relation: str) -> str:
    """Rail color for a switch candidate (None → no rail)."""
    return {"upgrade": _positive_hex(),
            "downgrade": _warning_hex()}.get(relation, "")



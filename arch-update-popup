        self._state_lbl.setObjectName("package-date")
        self._state_lbl.setWordWrap(True)
        self._state_lbl.setVisible(False)
        body.addWidget(self._state_lbl)

    def set_row_state(self, state: str, text: str = "") -> None:
        """idle | switching | done | failed — button + note follow."""
        self._state_lbl.setText(text)
        self._state_lbl.setVisible(bool(text))
        if state == "switching":
            self._switch_btn.setEnabled(False)
            self._switch_btn.setText("Switching…")
            self._set_note("text-accent")
        elif state == "done":
            self._switch_btn.setEnabled(False)
            self._switch_btn.setText("Switched ✓")
            self._set_note("text-positive")
            self._set_card("package-card-done")
        elif state == "failed":
            self._switch_btn.setEnabled(True)
            self._switch_btn.setText("Retry")
            self._set_note("text-negative")
            self._set_card("package-card-failed")
        else:
            self._switch_btn.setEnabled(True)
            self._switch_btn.setText(
                "Queued" if text.startswith("Queued") else "Switch")
            self._set_note("package-date")
            self._set_card("package-card")

    def _set_note(self, object_name: str) -> None:
        """Swap the note's role; Qt needs a repolish to re-apply QSS."""
        if self._state_lbl.objectName() == object_name:
            return
        self._state_lbl.setObjectName(object_name)
        self._state_lbl.style().unpolish(self._state_lbl)
        self._state_lbl.style().polish(self._state_lbl)

    def _set_card(self, name: str) -> None:
        self.setObjectName(name)
        self.style().unpolish(self)
        self.style().polish(self)



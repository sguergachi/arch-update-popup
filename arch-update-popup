def enabled_repos() -> set[str]:
    """Repo names enabled in pacman.conf (read only — never written to)."""
    names: set[str] = set()
    try:
        with open("/etc/pacman.conf", encoding="utf-8", errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if (line.startswith("[") and line.endswith("]")
                        and line.lower() != "[options]"):
                    names.add(line[1:-1])
    except OSError:
        pass
    return names


def _flatpak_ready() -> bool:
    """Flatpak installed, with the Flathub remote registered (local read)."""
    if not shutil.which("flatpak"):
        return False
    try:
        res = subprocess.run(["flatpak", "remotes", "--columns=name"],
                             capture_output=True, text=True, timeout=5)
    except (OSError, subprocess.SubprocessError):
        return False
    remotes = {ln.strip().lower() for ln in (res.stdout or "").splitlines()}
    return "flathub" in remotes


def _managed_source_ready(probe: str, enabled: set[str]) -> bool:
    """Is this managed source already usable on this machine? Flatpak is
    not a pacman repo, so it answers for itself."""
    if probe == "flatpak":
        return _flatpak_ready()
    return probe in enabled


_PACMAN_LOCK = "/var/lib/pacman/db.lck"


def pacman_lock_held() -> bool:
    """True while a package transaction holds pacman's database.

    The lock file is pacman's own signal. A removal started while it is
    held prints an error and changes nothing — which reads to the user as
    "uninstall doesn't work", so every removal path checks this first.
    """
    try:
        return os.path.exists(_PACMAN_LOCK)
    except OSError:
        return False


def _repo_kind(repo: str) -> str:
    """'official', or 'managed' for a third-party binary source."""
    return ("official" if _source_key(repo) == SRC_OFFICIAL else "managed")


def _repo_label(repo: str) -> str:
    """Human name for a providing repo ('official' reads better than a list)."""
    kind = _repo_kind(repo)
    return "official" if kind == "official" else (repo or "third-party")


# One vocabulary for "where did this come from", shared by the badges, the
# stat-strip filters and the source panel, so Flatpak and the managed repos
# are as recognisable as official and AUR.
SRC_OFFICIAL = "official"
SRC_AUR = "aur"
SRC_FLATPAK = "flatpak"
SRC_APPIMAGE = "appimage"
SRC_MANUAL = "manual"        # on disk, owned by no package manager
SRC_MANAGED = "managed"      # a third-party pacman repo (cachyos, …)

_SOURCE_META: dict[str, tuple[str, str]] = {
    # key → (label, filter-card caption)
    SRC_OFFICIAL: ("official", "official"),
    SRC_AUR: ("aur", "aur"),
    SRC_FLATPAK: ("flatpak", "flatpak"),
    SRC_APPIMAGE: ("appimage", "appimage"),
    SRC_MANUAL: ("manual install", "manual"),
    SRC_MANAGED: ("third-party", "third-party"),
}


def _source_key(repo: str) -> str:
    """Canonical source key for a repo name or a pseudo-source."""
    r = (repo or "").lower()
    if not r:
        return SRC_MANUAL
    if r in (SRC_FLATPAK, SRC_APPIMAGE, SRC_MANUAL, SRC_AUR, SRC_OFFICIAL):
        return r
    if r in OFFICIAL_REPOS:
        return SRC_OFFICIAL
    return SRC_MANAGED


def _source_label(repo: str) -> str:
    """Human name for a source, for a tooltip or a filter caption."""
    return _SOURCE_META[_source_key(repo)][0]



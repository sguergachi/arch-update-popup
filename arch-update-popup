    def __init__(self, moves: list[dict]) -> None:
        super().__init__()
        self._moves = {m["name"]: m for m in moves}
        self._rows: dict[str, _MoveRow] = {}
        self._queue: list[str] = []
        self._runner: UpdateRunner | None = None
        self._current: str | None = None
        self._changed = False
        self._orphans: set = set()  # parked threads, never destroyed live

        n = len(moves)
        self.setWindowTitle(
            f"Switch to Managed Packages — {n} candidate"
            f"{'s' if n != 1 else ''}")

        eyebrow.setObjectName("eyebrow")
        tb.addWidget(eyebrow)
        title = QLabel("Switch off the AUR")
        title.setObjectName("title")
        tb.addWidget(title)
        sources = sorted({_repo_label(m["source"]) for m in moves})
        sub = QLabel(
            "These installed AUR packages are also carried by a managed "
            "repo: <b>" + ", ".join(sources) + "</b>. Switching replaces "
            "your locally-built AUR package with that repo's signed, "
            "prebuilt one — no PKGBUILD of yours is run to get it.")
        sub.setObjectName("subtitle")
        sub.setWordWrap(True)
        tb.addWidget(sub)
        head.addLayout(tb, 1)
        lay.addLayout(head)
        lay.addWidget(_divider())

        scroll = QScrollArea()
        scroll.setObjectName("package-list")
        scroll.setWidgetResizable(True)
        scroll.setFrameShape(QFrame.Shape.NoFrame)
        inner = QWidget()
        inner.setObjectName("list-inner")
        ll = QVBoxLayout(inner)
        ll.setContentsMargins(_sp(8), _sp(8), _sp(8), _sp(8))
        ll.setSpacing(_sp(8))
        for m in moves:
            row = _MoveRow(m, self.request_switch)
            self._rows[m["name"]] = row
            ll.addWidget(row)
        ll.addStretch()
        scroll.setWidget(inner)
        lay.addWidget(scroll, 1)

        lay.addWidget(_divider())

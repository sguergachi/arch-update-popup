        err_head.setSpacing(_sp(8))
        self._details_label = QLabel("ERROR DETAILS")
        self._details_label.setObjectName("details-label")
        self._details_label.setVisible(False)
        err_head.addWidget(self._details_label)
        err_head.addStretch()
        self._copy_btn = QPushButton("Copy error")
        self._copy_btn.setObjectName("secondary-small")
        self._copy_btn.setFixedHeight(_sp(28))
        self._icon_btn(self._copy_btn, "copy", 14)
        self._copy_btn.setToolTip("Copy the error details to the clipboard")
        self._copy_btn.clicked.connect(self._copy_error)
        self._copy_btn.setVisible(False)
        err_head.addWidget(self._copy_btn)
        self._dismiss_btn = QPushButton("Dismiss")
        self._dismiss_btn.setObjectName("secondary-small")
        self._dismiss_btn.setFixedHeight(_sp(28))
        self._dismiss_btn.setToolTip("Close the error details")
        self._dismiss_btn.clicked.connect(self._dismiss_error)
        self._dismiss_btn.setVisible(False)
        err_head.addWidget(self._dismiss_btn)
        log_lay.addLayout(err_head)

        self._details = QPlainTextEdit()
        self._details.setObjectName("details")
        self._details.setReadOnly(True)
        self._details.setMaximumBlockCount(60)
        self._details.setMinimumHeight(80)
        self._details.setMaximumHeight(220)
        self._details.setVisible(False)

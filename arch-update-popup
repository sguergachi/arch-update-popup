def flatpak_tracked_rows() -> list[dict]:
    """Installed Flatpak apps as Tracked rows.

    A Flatpak app is software you installed deliberately — it belongs in
    the same list as your pacman packages, wearing a FLATPAK badge, not in
    "stuff pacman doesn't own". Its launcher (already on disk) names it, so
    the row can be titled and sorted like the app it is, not like an app id.
    """
    rows = []
    for app_id, (version, _install) in sorted(_flatpak_apps().items()):
        desktop = TrackedEnricher._flatpak_desktop(app_id)
        rows.append({
            "name": app_id, "version": version, "repo": SRC_FLATPAK,
            "title": _desktop_title(desktop) if desktop else "",
            "desktop": desktop or "",
            "desc": TrackedEnricher._flatpak_desc(app_id) if desktop else "",
        })
    return rows


def load_tracked() -> tuple[list[dict], list[dict]]:
    """Everything the Tracked tab shows: explicitly installed packages,
    installed Flatpak apps, and the moves that could replace AUR builds."""
    try:
        installed = get_installed_packages()
    except Exception:
        installed = []
    try:
        installed += flatpak_tracked_rows()
    except Exception:
        pass
    try:
        installed += appimage_rows()
    except Exception:
        pass
    try:
        moves = find_repo_moves()
    except Exception:
        moves = []
    return installed, moves


class TrackedLoader(QThread):
    """Loads explicitly installed packages + Flatpak apps + repo moves."""
    done = pyqtSignal(list, list)  # (installed, moves)

    def run(self) -> None:
        self.done.emit(*load_tracked())


def pick_desktop_file(pkgname: str, paths: list[str]) -> str:
    """Choose a launchable .desktop file for `pkgname` from `paths`.

    Prefers an exact `<pkgname>.desktop` match, else the first visible
    GUI entry. Terminal-only entries are skipped (nothing graphical to
    open). Returns "" when nothing qualifies.
    """
    cands = sorted({p for p in paths if p.endswith(".desktop")})
    if not cands:
        return ""
    for p in cands:
        if os.path.basename(p) == f"{pkgname}.desktop" \
                and _desktop_launchable(p):
            return p
    for p in cands:
        if _desktop_launchable(p):
            return p
    return ""


def _desktop_title(path: str) -> str:
    """The human-readable Name from a .desktop entry, or ""."""
    if not path:
        return ""
    entry = _desktop_entry(path)
    return entry.get("Name", "") if entry else ""


def _desktop_entry(path: str) -> dict[str, str]:
    """Parse the [Desktop Entry] keys of a .desktop file."""
    entry: dict[str, str] = {}
    try:
        with open(path, encoding="utf-8", errors="replace") as f:
            text = f.read(4096)
    except OSError:
        return entry
    in_entry = False
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("["):
            in_entry = line == "[Desktop Entry]"
            continue
        if in_entry and "=" in line:
            k, v = line.split("=", 1)
            entry.setdefault(k.strip(), v.strip())
    return entry


def _desktop_launchable(path: str) -> bool:
    """False for hidden entries and terminal-only apps."""
    entry = _desktop_entry(path)
    if not entry:
        return False
    low = {k.lower(): v.lower() for k, v in entry.items()}
    return ("true" not in low.get("nodisplay", "")) \
        and ("true" not in low.get("hidden", "")) \
        and ("true" not in low.get("terminal", ""))


def _launch_desktop(path: str) -> bool:
    """Really launch a .desktop file: parse Exec= and start it detached.

    openUrl() on a .desktop file just opens the file itself — this runs
    the app instead. Returns True when the process was started.
    """
    entry = _desktop_entry(path)
    exec_line = entry.get("Exec", "").strip()
    if not exec_line:
        return False
    # Expand the codes we can, drop the rest (spec: %f %F %u %U %d %D
    # %n %N %v %m are runtime-provided and empty here).
    prog = exec_line.replace("%%", "\0")
    prog = prog.replace("%k", path).replace("%c", entry.get("Name", ""))
    prog = re.sub(r"%[fFuUdDnNvVmik]", "", prog).replace("\0", "%")
    try:
        argv = shlex.split(prog, posix=True)
    except ValueError:
        return False
    argv = [a for a in argv if a]
    if not argv:
        return False
    program = argv[0]
    if "/" not in program:
        found = shutil.which(program)
        if not found:
            return False
        program = found
    return bool(QProcess.startDetached(program, argv[1:]))


class TrackedEnricher(QThread):
    """Fills in Tracked rows in the background: GUI launchers for the
    Open pill, plus package descriptions Updates-style.

    One `pacman -Ql` / `-Qi` per package; rows update as results arrive.
    Pure compute — safe to interrupt + park on shutdown.
    """
    found = pyqtSignal(str, str)      # (name, desktop_path)
    titled = pyqtSignal(str, str)    # (name, human title)
    described = pyqtSignal(str, str)  # (name, description)

    @staticmethod
    def _resolve_title(desktop_path: str) -> str:
        entry = _desktop_entry(desktop_path)
        return entry.get("Name", "") if entry else ""

    def __init__(self, names: list[str],
                 flatpak: set[str] | None = None) -> None:
        super().__init__()
        self._names = names
        self._flatpak = set(flatpak or ())

    def run(self) -> None:
        try:
            for name in self._names:
                if self.isInterruptionRequested():
                    return
                desktop = (self._flatpak_desktop(name)
                           if name in self._flatpak
                           else self._resolve_desktop(name))
                if desktop:
                    self.found.emit(name, desktop)
                    title = _desktop_title(desktop)
                    if title:
                        self.titled.emit(name, title)
                if self.isInterruptionRequested():
                    return
                desc = (self._flatpak_desc(name) if name in self._flatpak
                        else self._resolve_desc(name))
                if desc:
                    self.described.emit(name, desc)
        except Exception:
            pass

    @staticmethod
    def _flatpak_desktop(name: str) -> str:
        """The launcher Flatpak exports for an app id (no subprocess)."""
        for root in _flatpak_export_dirs():
            path = os.path.join(root, f"{name}.desktop")
            if os.path.exists(path) and _desktop_launchable(path):
                return path
        return ""

    @classmethod
    def _flatpak_desc(cls, name: str) -> str:
        """An app's own one-liner: the Comment in its launcher."""
        path = cls._flatpak_desktop(name)
        entry = _desktop_entry(path) if path else {}
        return entry.get("Comment", "") if entry else ""

    @staticmethod
    def _resolve_desktop(name: str) -> str:
        try:
            r = _run(["pacman", "-Ql", name], capture_output=True, text=True)
        except Exception:
            return ""
        if r.returncode != 0:
            return ""
        paths = [ln.split(None, 1)[1].strip()
                 for ln in r.stdout.splitlines()
                 if len(ln.split(None, 1)) == 2]
        return pick_desktop_file(name, paths)

    @staticmethod
    def _resolve_desc(name: str) -> str:
        try:
            r = _run(["pacman", "-Qi", name], capture_output=True, text=True)
        except Exception:
            return ""
        if r.returncode != 0:
            return ""
        for line in r.stdout.splitlines():
            if line.startswith("Description"):
                _, _, desc = line.partition(":")
                return desc.strip()
        return ""


def _flatpak_export_dirs() -> list[str]:
    """Where Flatpak puts the launchers of its installed apps."""
    home = os.path.expanduser("~")
    return ["/var/lib/flatpak/exports/share/applications",
            os.path.join(home, ".local/share/flatpak/exports/share/"
                               "applications")]


def _flatpak_app_id(path: str) -> str:
    """The Flatpak application id for a launcher in an exports dir.

    Flatpak names its desktop files after the app id, which is also what
    `flatpak uninstall` takes — so the id is both the row's identity and
    the removal target. '' when the file isn't a Flatpak launcher.
    """
    folder = os.path.abspath(os.path.dirname(path))
    for root in _flatpak_export_dirs():
        if folder == os.path.abspath(root):
            return os.path.splitext(os.path.basename(path))[0]
    return ""


def _flatpak_exec_id(exec_line: str) -> str:
    """The Flatpak app id from an Exec that launches through Flatpak.

    A hand-made launcher for a Flatpak app (or a second copy of one) is
    still that Flatpak app: `flatpak run --branch=stable … <app id>`.
    """
    try:
        parts = shlex.split(exec_line or "")
    except ValueError:
        parts = (exec_line or "").split()
    if not parts or os.path.basename(parts[0]) not in ("flatpak",
                                                       "flatpak-run"):
        return ""
    if "run" not in parts:
        return ""
    for part in parts[parts.index("run") + 1:]:
        if not part.startswith("-"):
            return part
    return ""


def _flatpak_id_for(app: dict) -> str:
    """The Flatpak app id for a scanned launcher, or ''."""
    return _flatpak_app_id(app["file"]) or _flatpak_exec_id(app.get("exec", ""))


APPIMAGE_SUFFIX = ".appimage"


def _appimage_dirs() -> list[str]:
    """Where an AppImage lives when it is meant to be used, not just kept.

    Downloads is deliberately absent: a `.AppImage` you just fetched is a
    download. One you put in an app folder — or wired a launcher to — is
    software you have.
    """
    home = os.path.expanduser("~")
    return [os.path.join(home, "Applications"),
            os.path.join(home, "AppImages"),
            os.path.join(home, ".local/bin"),
            "/opt", "/usr/local/bin"]


def _appimage_version(path: str) -> str:
    """The version in an AppImage's filename, or ''.

    There is no field to read and running one to ask is not an option, but
    releases are named after themselves: `T3-Code-0.0.24-x86_64.AppImage`.
    """
    stem = os.path.basename(path)
    if stem.lower().endswith(APPIMAGE_SUFFIX):
        stem = stem[:-len(APPIMAGE_SUFFIX)]
    match = re.search(r"[-_]v?(\d+(?:\.\d+)+)", stem)
    return match.group(1) if match else ""


def _appimage_in_exec(exec_line: str) -> str:
    """The AppImage path an Exec line runs, or ''.

    Launchers quote and wrap their command ('env … "/path/App.AppImage" %U'),
    so the path is found by its suffix rather than by splitting cleanly.
    """
    line = exec_line or ""
    for quote in ('"', "'"):
        start = 0
        while True:
            i = line.find(quote, start)
            if i < 0:
                break
            j = line.find(quote, i + 1)
            if j < 0:
                break
            token = line[i + 1:j]
            if token.lower().endswith(APPIMAGE_SUFFIX):
                return token
            start = j + 1
    for token in line.replace("\t", " ").split():
        if token.lower().endswith(APPIMAGE_SUFFIX):
            return token
    return ""


def _appimages_in(folder: str, depth: int = 1) -> list[str]:
    """AppImage files in `folder` (one level down for /opt-style trees)."""
    found: list[str] = []
    try:
        entries = sorted(os.listdir(folder))
    except OSError:
        return found
    for entry in entries:
        path = os.path.join(folder, entry)
        if entry.lower().endswith(APPIMAGE_SUFFIX):
            if os.path.isfile(path):
                found.append(path)
        elif depth > 0 and os.path.isdir(path):
            found.extend(_appimages_in(path, depth - 1))
    return found


def _launcher_appimages() -> dict[str, dict]:
    """{AppImage path: launcher} for every launcher that runs one."""
    out: dict[str, dict] = {}
    for app in scan_desktop_files(include_hidden=True):
        path = _appimage_in_exec(app.get("exec", ""))
        if path and os.path.exists(path):
            out.setdefault(path, app)
    return out


def appimage_rows() -> list[dict]:
    """Installed AppImages as Tracked rows.

    Two ways in: a launcher runs it (wherever it lives — several people
    keep them in Downloads and wire a .desktop to them), or it sits in an
    app folder. Same file found both ways is one row.
    """
    rows: list[dict] = []
    seen: set[str] = set()
    for path, app in sorted(_launcher_appimages().items()):
        rows.append(_appimage_row(path, app))
        seen.add(os.path.realpath(path))
    for folder in _appimage_dirs():
        for path in _appimages_in(folder):
            if os.path.realpath(path) in seen:
                continue
            seen.add(os.path.realpath(path))
            rows.append(_appimage_row(path, None))
    return rows


def _appimage_pretty(stem: str) -> str:
    """'WhisperFlow-0.4.409-x86_64' → 'WhisperFlow' (the app's own name)."""
    pretty = re.sub(r"[-_]v?\d+(?:\.\d+)+.*$", "", stem).strip("-_ ")
    return pretty or stem


def _appimage_row(path: str, launcher: dict | None) -> dict:
    """One AppImage as a Tracked row (name, version, title, Open target).

    The row's *name* stays the filename stem — two builds of one app in
    the same folder must stay two rows, and removal needs the file — while
    the row *shows* the app's own name.
    """
    stem = os.path.basename(path)
    if stem.lower().endswith(APPIMAGE_SUFFIX):
        stem = stem[:-len(APPIMAGE_SUFFIX)]
    launcher = launcher or {}
    return {
        "name": stem,
        "version": _appimage_version(path),
        "repo": SRC_APPIMAGE,
        "title": launcher.get("title", "") or _appimage_pretty(stem),
        "desktop": launcher.get("file", ""),
        "desc": launcher.get("comment", ""),
        # The app's own page, when its launcher names one.
        "url": launcher.get("url", ""),
        # The file itself is the removal target — no package owns it.
        "path": path,
    }


def _flatpak_apps() -> dict[str, tuple[str, str]]:
    """{application id: (version, installation)} for installed apps.

    One local `flatpak list` — no network. Empty when Flatpak isn't
    installed or the call fails, so a machine without Flatpak simply
    never reports a Flatpak source.
    """
    if not shutil.which("flatpak"):
        return {}
    try:
        res = _run(["flatpak", "list", "--app",
                    "--columns=application,version,installation"],
                   capture_output=True, text=True, timeout=20)
    except Exception:
        return {}
    apps: dict[str, tuple[str, str]] = {}
    for line in (res.stdout or "").splitlines():
        parts = [p.strip() for p in line.split("\t")]
        if len(parts) >= 3 and parts[0]:
            apps[parts[0]] = (parts[1], parts[2].lower())
    return apps


def scan_desktop_files(dirs: list[str] | None = None,
                       include_hidden: bool = False) -> list[dict]:
    """Find installed GUI applications by searching .desktop files.

    Returns [{file, title, comment, exec}] for entries with a Name, deduped
    by basename with user-local files winning over system ones. Pure
    filesystem read — no subprocesses.

    `include_hidden` keeps NoDisplay/Hidden entries, which are not
    launchers but still prove a file is wired into the desktop (an
    AppImage registered as a URL handler, for instance).
    """
    if dirs is None:
        home = os.path.expanduser("~")
        # Flatpak apps ship their launchers here; if we don't scan them,
        # a Flatpak-installed Heroic Games Launcher (and every other
        # Flatpak GUI app) is invisible to the app — which reads as "apps
        # don't show up here".
        dirs = [os.path.join(home, ".local/share/applications"),
                "/usr/local/share/applications",
                "/usr/share/applications",
                "/var/lib/flatpak/exports/share/applications",
                os.path.join(home, ".local/share/flatpak/exports/share/applications")]
    found: dict[str, dict] = {}
    for d in dirs:
        try:
            names = sorted(os.listdir(d))
        except OSError:
            continue
        for fn in names:
            if not fn.endswith(".desktop") or fn in found:
                continue
            path = os.path.join(d, fn)
            entry = _desktop_entry(path)
            if not entry or not entry.get("Name"):
                continue
            low = {k.lower(): v.lower() for k, v in entry.items()}
            if not include_hidden and ("true" in low.get("nodisplay", "")
                                       or "true" in low.get("hidden", "")):
                continue
            found[fn] = {"file": path, "title": entry["Name"],
                         "comment": entry.get("Comment", ""),
                         "exec": entry.get("Exec", ""),
                         "url": entry.get("URL", "")}
    return list(found.values())


_QO_RE = re.compile(r"^(.*) is owned by (\S+) (\S+)\s*$")


def parse_qo_owner(line: str) -> tuple[str, str | None, str]:
    """Parse one `pacman -Qo` line → (file, owner or None, version)."""
    m = _QO_RE.match((line or "").strip())
    if not m:
        return line.strip(), None, ""
    return m.group(1), m.group(2), m.group(3)


def _installed_version_map() -> dict[str, str]:
    """All installed packages → version (one `pacman -Q` fork)."""
    try:
        r = _run(["pacman", "-Q"], capture_output=True, text=True)
    except Exception:
        return {}
    if r.returncode != 0:
        return {}
    out: dict[str, str] = {}
    for line in r.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 2:
            out[parts[0]] = parts[1]
    return out


def _explicit_package_set() -> set[str]:
    """Packages the user explicitly installed (pacman -Qe)."""
    try:
        r = _run(["pacman", "-Qqe"], capture_output=True, text=True, timeout=30)
    except Exception:
        return set()
    return set(r.stdout.split()) if r.returncode == 0 else set()


def _foreign_pkg_set() -> set[str]:
    """Packages not from any configured repo (one `pacman -Qm` fork)."""
    try:
        r = _run(["pacman", "-Qm"], capture_output=True, text=True)
    except Exception:
        return set()
    if r.returncode != 0:
        return set()
    return {ln.split()[0] for ln in r.stdout.splitlines() if ln.split()}


def _tracked_row(name: str, version: str, repo: str, title: str = "",
                 desktop: str = "", desc: str = "", url: str = "") -> dict:
    """A complete TrackedModel-compatible row dict."""
    return {"name": name, "title": title, "version": version, "repo": repo,
            "target": "", "source": "", "relation": "",
            "state": "idle", "failed_op": "",
            "desktop": desktop or None, "desc": desc, "checked": False,
            "url": url, "path": ""}


class FlatpakRemover(QThread):
    """Uninstalls Flatpak apps, streaming the output.

    Flatpak is not pacman: there is no database lock to wait for and no
    `-Rns`. System installs need root (we use the same `sudo -A` askpass
    as everywhere else, because no polkit agent runs in this session);
    user installs must *not* be run as root.
    """

    line = pyqtSignal(str)
    done = pyqtSignal(bool, str)

    def __init__(self, app_ids: list[str],
                 installations: dict[str, str] | None = None) -> None:
        super().__init__()
        self._proc: subprocess.Popen | None = None
        self._killed = False
        installs = installations or {}
        user = [a for a in app_ids if installs.get(a, "system") == "user"]
        system = [a for a in app_ids if a not in user]
        base = ["flatpak", "uninstall", "--noninteractive", "--assumeyes"]
        self._batches: list[list[str]] = []
        if user:
            self._batches.append([*base, "--user", *user])
        if system:
            self._askpass = (make_askpass_script(
                "Enter sudo password to remove Flatpak apps:")
                if shutil.which("sudo") else None)
            prefix = (["sudo", "-A"] if self._askpass else ["pkexec"])
            self._batches.append([*prefix, *base, "--system", *system])
        else:
            self._askpass = None

    def _child_env(self) -> dict:
        env = os.environ.copy()
        if self._askpass:
            env["SUDO_ASKPASS"] = self._askpass
        return env

    def _cleanup(self) -> None:
        if self._askpass:
            try:
                os.unlink(self._askpass)
            except OSError:
                pass
            self._askpass = None

    def run(self) -> None:
        lines: list[str] = []
        ok = True
        try:
            for cmd in self._batches:
                if self._killed:
                    ok = False
                    break
                ok = self._run_one(cmd, lines) and ok
        finally:
            self._cleanup()
        self.done.emit(ok and not self._killed, "\n".join(lines[-40:]))

    def _run_one(self, cmd: list[str], lines: list[str]) -> bool:
        env = self._child_env()
        master_fd, slave_fd = pty.openpty()
        try:
            proc = subprocess.Popen(
                cmd, stdout=slave_fd, stderr=slave_fd,
                stdin=subprocess.DEVNULL, env=env, close_fds=True)
        except FileNotFoundError as e:
            os.close(master_fd)
            os.close(slave_fd)
            lines.append(str(e))
            return False
        os.close(slave_fd)
        self._proc = proc
        if self._killed:
            try:
                proc.terminate()
            except Exception:
                pass
        buf = ""
        while True:
            try:
                ready, _, _ = select.select([master_fd], [], [], 0.05)
            except (OSError, ValueError):
                break
            if ready:
                try:
                    buf += os.read(master_fd, 4096).decode(errors="replace")
                except OSError:
                    break
                while "\n" in buf:
                    raw, buf = buf.split("\n", 1)
                    for fragment in raw.split("\r"):
                        fragment = _ANSI_RE.sub("", fragment).strip()
                        if fragment:
                            lines.append(fragment)
                            self.line.emit(fragment)
            elif proc.poll() is not None:
                break
        try:
            os.close(master_fd)
        except OSError:
            pass
        proc.wait()
        return proc.returncode == 0

    def terminate(self) -> None:  # type: ignore[override]
        self._killed = True
        proc = self._proc
        if proc is not None:
            try:
                proc.terminate()
            except Exception:
                pass


class AppImageRemover(QThread):
    """Deletes AppImages, and the launchers that point at them.

    No package manager is involved: the file is the installation. A
    launcher wired to it (and any icon it brought) goes too, or the menu
    keeps an entry that runs nothing. User-owned paths are deleted
    directly; anything root-owned goes through the usual `sudo -A`
    askpass, because /opt-style installs are not the user's to remove.
    """

    line = pyqtSignal(str)
    done = pyqtSignal(bool, str)

    def __init__(self, paths: list[str]) -> None:
        super().__init__()
        self._paths = list(paths)
        self._askpass: str | None = None

    def _child_env(self) -> dict:
        env = os.environ.copy()
        if self._askpass:
            env["SUDO_ASKPASS"] = self._askpass
        return env

    def _cleanup(self) -> None:
        if self._askpass:
            try:
                os.unlink(self._askpass)
            except OSError:
                pass
            self._askpass = None

    @staticmethod
    def _launchers_for(path: str) -> list[str]:
        """Desktop entries that run this AppImage (they die with it)."""
        out = []
        for app in scan_desktop_files(include_hidden=True):
            if _appimage_in_exec(app.get("exec", "")) == path:
                out.append(app["file"])
        return out

    def run(self) -> None:
        lines: list[str] = []
        mine: list[str] = []
        theirs: list[str] = []
        try:
            for path in self._paths:
                targets = [path, *self._launchers_for(path)]
                for target in targets:
                    if os.access(target, os.W_OK) and os.access(
                            os.path.dirname(target) or "/", os.W_OK):
                        mine.append(target)
                    else:
                        theirs.append(target)
            ok = True
            for target in mine:
                try:
                    os.remove(target)
                    lines.append(f"removed {target}")
                    self.line.emit(f"removed {target}")
                except OSError as e:
                    ok = False
                    lines.append(f"{target}: {e}")
            if theirs:
                self._askpass = make_askpass_script(
                    "Enter sudo password to remove these files:")
                env = self._child_env()
                try:
                    proc = subprocess.Popen(
                        ["sudo", "-A", "rm", "-f", *theirs],
                        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                        stdin=subprocess.DEVNULL, env=env, text=True)
                    out, _ = proc.communicate(timeout=120)
                    for ln in (out or "").splitlines():
                        if ln.strip():
                            lines.append(ln.strip())
                            self.line.emit(ln.strip())
                    if proc.returncode != 0:
                        ok = False
                except Exception as e:      # noqa: BLE001 - report, never raise
                    ok = False
                    lines.append(str(e))
            for path in self._paths:
                if os.path.exists(path):
                    ok = False
        finally:
            self._cleanup()
        self.done.emit(ok, "\n".join(lines[-40:]))


class UntrackedLoader(QThread):
    """Finds untracked software in the background.

    GUI applications come from a .desktop-file search whose owners resolve
    via a single batched `pacman -Qo`; dependency packages from one
    `pacman -Qd`. Pure compute — safe to interrupt + park on shutdown.
    """
    done = pyqtSignal(list, list)  # (app_rows, dep_rows)

    def run(self) -> None:
        try:
            apps = self._load_apps()
            if self.isInterruptionRequested():
                return
            pkgs = self._load_deps()
        except Exception:
            return
        self.done.emit(apps, pkgs)

    def _load_apps(self) -> list[dict]:
        found = scan_desktop_files()
        owners: dict[str, tuple[str | None, str]] = {}
        files = [a["file"] for a in found if not _flatpak_id_for(a)]
        if files and not self.isInterruptionRequested():
            # pacman prints owned lines even when it exits nonzero over
            # unowned files — always parse stdout, then resolve only the
            # files still missing one by one.
            try:
                r = _run(["pacman", "-Qo", *files],
                         capture_output=True, text=True)
                out = r.stdout or ""
            except Exception:
                out = ""
            for line in out.splitlines():
                f, owner, ver = parse_qo_owner(line)
                if owner:
                    owners[f] = (owner, ver)
            for f in files:
                if f in owners or self.isInterruptionRequested():
                    continue
                try:
                    r = _run(["pacman", "-Qo", f],
                             capture_output=True, text=True)
                    o = r.stdout or ""
                except Exception:
                    o = ""
                for line in o.splitlines():
                    ff, owner, ver = parse_qo_owner(line)
                    if owner:
                        owners[ff] = (owner, ver)
        versions = _installed_version_map()
        foreign = _foreign_pkg_set()
        rows = []
        seen: set[tuple[str, str]] = set()
        explicit = _explicit_package_set()
        for a in found:
            if _flatpak_id_for(a) or _appimage_in_exec(a.get("exec", "")):
                continue    # a Flatpak app / AppImage is a Tracked row
            owner, ver = owners.get(a["file"], (None, ""))
            if owner:
                # Genuinely untracked means "not in your explicit set":
                # an app whose package you deliberately installed belongs
                # to the Tracked tab, not here. Showing it in both places
                # is what made this tab read as "stuff that's also tracked".
                if owner in explicit:
                    continue
                name, version = owner, ver or versions.get(owner, "")
            else:
                # Not owned by any package (manual install): identify by
                # desktop filename; uninstall is unavailable.
                name = os.path.splitext(os.path.basename(a["file"]))[0]
                version = ""
                repo = SRC_MANUAL
            if owner:
                repo = "aur" if name in foreign else "official"
            launchable = (a["exec"] and _desktop_launchable(a["file"]))
            row = _tracked_row(
                name, version, repo, title=a["title"],
                desktop=a["file"] if launchable else "",
                desc=a["comment"], url=a.get("url", ""))
            # Same app shipped twice (system + user copy, .bak-style
            # twins): collapse on title + launch command.
            key = ((row["title"] or row["name"]).lower(), a["exec"])
            if key in seen:
                continue
            seen.add(key)
            rows.append(row)
        rows.sort(key=lambda it: (it["title"] or it["name"]).lower())
        return rows

    def _load_deps(self) -> list[dict]:
        try:
            r = _run(["pacman", "-Qd"], capture_output=True, text=True)
        except Exception:
            return []
        if r.returncode != 0:
            return []
        foreign = _foreign_pkg_set()
        rows = []
        for line in r.stdout.splitlines():
            if self.isInterruptionRequested():
                return []
            parts = line.split()
            if len(parts) < 2:
                continue
            rows.append(_tracked_row(
                parts[0], parts[1],
                "aur" if parts[0] in foreign else "official"))
        rows.sort(key=lambda it: it["name"].lower())
        return rows


class InfoFetcher(QThread):
    """Fetches description and release notes for each pending update.

    Results are persisted to the on-disk cache as they arrive so the update
    window is already populated the next time the same versions are offered.
    """
    # row, name, new_ver, desc, notes, date, full, source_label, source_url
    row_ready = pyqtSignal(int, str, str, str, str, str, str, str, str)

    def __init__(self, updates: list[dict]) -> None:
        super().__init__()
        self._updates = updates
        self._cache = load_pkg_info_cache()

    def run(self) -> None:
        now = time.time()
        for i, pkg in enumerate(self._updates):
            if self.isInterruptionRequested():
                return
            info = fetch_pacman_info(pkg["name"])
            desc = info["desc"] or "No description available"
            notes, date, full, source, source_url = get_whats_new(
                pkg["name"], pkg["new"], info["url"], info["repo"],
                old_ver=pkg.get("old", ""),
            )
            self._cache[pkg["name"]] = {
                "desc": desc, "notes": notes, "date": date,
                "full": full[:6000], "source": source,
                "source_url": source_url,
                "version": pkg["new"], "ts": now,
            }
            for key in [
                k for k, v in self._cache.items()
                if now - v.get("ts", 0) > _CACHE_MAX_AGE_S
            ]:
                del self._cache[key]
            save_pkg_info_cache(self._cache)
            self.row_ready.emit(i, pkg["name"], pkg["new"], desc, notes, date,
                                full, source, source_url)


class SystemScanner(QThread):
    """Scans all installed packages for compromise off the main thread."""

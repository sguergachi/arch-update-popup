    def _refresh_tracked_summary(self) -> None:
        n = self._track_model.rowCount()
        movable = self._track_model.movable_names()
        counts = self._track_model.source_counts()
        n_aur = counts.get(SRC_AUR, 0)
        n_flat = counts.get(SRC_FLATPAK, 0)
        if n:
            self._track_empty.hide_state()
        elif self._track_loading:
            self._track_empty.show_loading("Reading the installed package "
                                           "list…")
        elif self._track_loaded:
            self._track_empty.show_state(
                "Nothing tracked",
                "No explicitly installed packages were found.",
                icon="box", colour="muted")
        else:
            # Not loaded yet: this is a load in progress, not an empty list.
            self._track_empty.show_loading("Reading the installed package "
                                           "list…")
        if n == 0 and not self._track_loaded:
            self._track_summary.setText("Loading tracked packages…")
            self._refresh_tracked_footer()
            return
        # One honest line about what is on screen right now: the sources
        # that are actually here, named in the order they matter.
        what = f"<b>{n}</b> package{'s' if n != 1 else ''}"
        if n_flat == n and n:
            what = f"<b>{n}</b> Flatpak app{'s' if n != 1 else ''}"
        elif counts.get(SRC_APPIMAGE, 0) == n and n:
            what = f"<b>{n}</b> AppImage{'s' if n != 1 else ''}"
        else:
            n_img = counts.get(SRC_APPIMAGE, 0)
            extra = []
            if n_aur:
                extra.append(f"{n_aur} from the AUR")
            if n_flat:
                extra.append(f"{n_flat} Flatpak app"
                             f"{'s' if n_flat != 1 else ''}")
            if n_img:
                extra.append(f"{n_img} AppImage{'s' if n_img != 1 else ''}")
            if extra:
                what += " · " + " · ".join(extra)
        if movable:
            what += (f" · <b>{len(movable)}</b> available from a managed "
                     "repo")
        elif n_aur and not n_flat:
            what += " — none available from a managed repo"
        self._track_summary.setText(what + ".")
        self._refresh_tracked_footer()

    def _refresh_tracked(self) -> None:
        """Reload every explicitly installed package."""
        if self._track_loader is not None and self._track_loader.isRunning():
            return
        self._log_action("Reloading the tracked package list…")
        self._track_loaded = False
        self._track_loading = True
        self._track_model.set_packages([], [])
        self._release_thread("_track_loader")
        self._track_loader = TrackedLoader()
        self._track_loader.done.connect(self._on_tracked_loaded)
        self._track_loader.start()
        self._refresh_tracked_summary()
        self._update_view_badges()


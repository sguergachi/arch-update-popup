# ── Privileged operations without a TTY ────────────────────────────────────
#
# This app is launched from the tray/systemd, so it has **no controlling
# tty**: pkexec cannot work here. With no polkit agent running it falls
# back to its *textual* authentication agent, which fails with
# "Error opening current controlling terminal (/dev/tty): No such device
# or address". Every privileged path therefore runs `sudo -A` (askpass)
# with a GUI password dialog; pkexec remains only as a fallback for the
# rare machine without sudo installed.

def make_askpass_script(prompt: str) -> str:
    """Write a temporary askpass helper for `sudo -A` and return its path.

    sudo executes the askpass program detached from any terminal, so the
    password must come from a GUI dialog: kdialog first (KDE), zenity as
    the fallback, otherwise fail — nothing runs rather than hanging.
    The caller owns the file and MUST unlink it in every exit path
    (success, failure, terminate/kill).
    """
    safe = prompt.replace("'", "'\\''")
    body = (
        '#!/bin/bash\n'
        '# GUI askpass for "sudo -A": the caller runs from the tray with\n'
        '# no controlling TTY, so authentication needs a GUI dialog.\n'
        f'prompt="${{1:-{safe}}}"\n'
        'if command -v kdialog >/dev/null 2>&1; then\n'
        '  exec kdialog --title "Arch Update" --password "$prompt" 2>/dev/null\n'
        'fi\n'
        'if command -v zenity >/dev/null 2>&1; then\n'
        '  exec zenity --title "Arch Update" --password 2>/dev/null\n'
        'fi\n'
        'exit 1\n'
    )
    fd, path = tempfile.mkstemp(suffix=".sh", prefix="arch-update-askpass-")
    with os.fdopen(fd, "w") as f:
        f.write(body)
    os.chmod(path, stat.S_IRWXU)  # 0700: only the owner may read the prompt
    return path


class UpdateRunner(QThread):
    """Runs the package update and streams per-package install progress."""
    install_progress = pyqtSignal(int, int, str)  # current, total, pkg_name
    line             = pyqtSignal(str)             # every raw output line
    build            = pyqtSignal(str)             # AUR package started building
    conflict         = pyqtSignal(str, str)        # pkg, path: file conflict
    done             = pyqtSignal(bool, str)       # success, last output lines

    def __init__(self, aur_helper: str | None, packages: list[str] | None = None,
                 overwrite: str | None = None) -> None:
        super().__init__()
        self._askpass: str | None = None
        self._proc: subprocess.Popen | None = None
        self._killed = False

        extra = ["--overwrite", overwrite] if overwrite else []
        # Explicit package lists MUST refresh the sync DBs (-Sy): a bare
        # `-S pkg` installs whatever version the on-disk DBs hold, which
        # silently reinstalls the OLD version when the DBs are stale
        # (exit code 0, nothing upgraded, packages reappear next open).
        prompt = "Enter sudo password to install updates:"
        if aur_helper:
            self._askpass = make_askpass_script(prompt)
            if packages:
                self._cmd = [aur_helper, "--sudoflags", "-A", "-Sy", *packages, "--noconfirm", *extra]
            else:
                self._cmd = [aur_helper, "--sudoflags", "-A", "-Syu", "--noconfirm", *extra]
        elif shutil.which("sudo"):
            self._askpass = make_askpass_script(prompt)
            if packages:
                self._cmd = ["sudo", "-A", "pacman", "-Sy", *packages, "--noconfirm", *extra]
            else:
                self._cmd = ["sudo", "-A", "pacman", "-Syu", "--noconfirm", *extra]
        else:
            # No sudo on the system: pkexec is the only way to authenticate.
            if packages:
                self._cmd = ["pkexec", "pacman", "-Sy", *packages, "--noconfirm", *extra]
            else:
                self._cmd = ["pkexec", "pacman", "-Syu", "--noconfirm", *extra]

    def _child_env(self) -> dict:
        """Environment for the child process, exporting SUDO_ASKPASS."""
        env = os.environ.copy()
        if self._askpass:
            env["SUDO_ASKPASS"] = self._askpass
        return env

    def run(self) -> None:
        env = self._child_env()

        # Use a pty so paru/pacman think they're writing to a terminal and
        # flush output per line rather than buffering to the pipe.
        master_fd, slave_fd = pty.openpty()
        try:
            proc = subprocess.Popen(
                self._cmd,
                stdout=slave_fd, stderr=slave_fd,
                stdin=subprocess.DEVNULL,
                env=env, close_fds=True,
            )
        except FileNotFoundError as e:
            os.close(master_fd)
            os.close(slave_fd)
            self._cleanup()
            self.done.emit(False, str(e))
            return

        os.close(slave_fd)  # parent doesn't need the slave end
        self._proc = proc
        if self._killed:
            # Cancel arrived between spawn and here — stop immediately.
            try:
                proc.terminate()
            except Exception:
                pass

        lines: list[str] = []
        buf = ""
        while True:
            try:
                ready, _, _ = select.select([master_fd], [], [], 0.05)
            except (OSError, ValueError):
                break
            if ready:
                try:
                    buf += os.read(master_fd, 4096).decode(errors="replace")
                except OSError:
                    break
                while "\n" in buf:
                    raw, buf = buf.split("\n", 1)
                    for fragment in raw.split("\r"):
                        fragment = _ANSI_RE.sub("", fragment).strip()
                        if not fragment:
                            continue
                        lines.append(fragment)
                        if len(lines) > 2000:
                            del lines[:500]
                        self.line.emit(fragment)
                        b = match_build_line(fragment)
                        if b:
                            self.build.emit(b)
                        c = match_conflict_line(fragment)
                        if c:
                            self.conflict.emit(c[0], c[1])
                        m = _INSTALL_RE.match(fragment)
                        if m:
                            self.install_progress.emit(
                                int(m.group(1)), int(m.group(2)), m.group(3)
                            )
            elif proc.poll() is not None:
                break

        try:
            os.close(master_fd)
        except OSError:
            pass

        proc.wait()
        self._cleanup()
        if self._killed:
            lines.append("Cancelled by user.")
        self.done.emit(proc.returncode == 0 and not self._killed,
                       "\n".join(lines[-80:]))

    def terminate(self) -> None:  # type: ignore[override]
        """Ask the installer to stop (Cancel button / watchdog).

        Safe to call from the GUI thread; the run loop notices the dead
        process and emits done(False, …) as usual.
        """
        self._killed = True
        proc = self._proc
        if proc is not None:
            try:
                proc.terminate()
            except Exception:
                pass

    def _cleanup(self) -> None:
        if self._askpass:
            try:
                os.unlink(self._askpass)
            except OSError:
                pass
            self._askpass = None



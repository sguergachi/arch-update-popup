    def _refresh_button(self, tooltip: str, slot) -> QPushButton:
        """The action every view footer shares: reload this tab.

        Same label, icon and slot on every page, so "refresh" always means
        the same thing wherever you are.
        """
        btn = QPushButton("Refresh")
        btn.setObjectName("secondary")
        btn.setFixedHeight(_sp(34))
        btn.setMinimumWidth(_sp(120))
        btn.setCursor(Qt.CursorShape.PointingHandCursor)
        self._icon_btn(btn, "refresh", 16)
        btn.setToolTip(tooltip)
        btn.clicked.connect(slot)
        return btn

    def _show_cancel(self, running: bool) -> None:
        """Cancel takes the primary's place while an install runs.

        The footer only ever offers actions that can actually be taken:
        no Update All while an update is in flight, and no Cancel when
        nothing is running.
        """
        self._cancel_btn.setVisible(running)
        self._update_btn.setVisible(not running)

    def _refresh_reboot_chip(self) -> None:
        btn = getattr(self, "_reboot_btn", None)
        if btn is not None:
            btn.setVisible(reboot_required())

    def _reboot_now(self) -> None:
        """Restart the machine — the only way to finish a kernel update."""
        box = QMessageBox(self)
        box.setIcon(QMessageBox.Icon.Warning)
        box.setWindowTitle("Reboot now?")
        box.setText("Restart to finish the update?")
        box.setInformativeText(
            "The new kernel only takes effect after a restart. Save your "
            "work first — anything unsaved is lost.")
        go_btn = box.addButton("Reboot now",
                               QMessageBox.ButtonRole.AcceptRole)
        box.addButton("Not yet", QMessageBox.ButtonRole.RejectRole)
        box.exec()
        if box.clickedButton() is not go_btn:
            return
        if request_reboot():
            self._set_status("Rebooting — see you on the other side.", "ok")
            self._log_action("Reboot requested")
        else:
            self._set_status(
                "Couldn't start a reboot from here — use your desktop's "
                "power menu.", "error")

    def _apply_default_geometry(self) -> None:
        """Reopen where the user left it, else at a comfortable size.

        A saved geometry is only honoured when it still lands on screen —
        a monitor that went away must not push the window out of reach.
        """
        screen = QApplication.primaryScreen()
        avail = screen.availableGeometry() if screen is not None else QRect()
        saved = load_settings().get("geometry")
        if avail.isValid() and isinstance(saved, list) and len(saved) == 4:
            x, y, w, h = (int(v) for v in saved)
            if (avail.contains(QRect(x, y, w, h).center())
                    and w >= self.minimumWidth() and h >= self.minimumHeight()):
                self.resize(w, h)
                self.move(x, y)
                return
        if not avail.isValid():
            self.resize(_sp(1320), _sp(860))
            return
        self.resize(
            max(self.minimumWidth(), min(_sp(1320), int(avail.width() * 0.9))),
            max(self.minimumHeight(), min(_sp(860), int(avail.height() * 0.9))),
        )
        self.move(avail.center().x() - self.width() // 2,
                  avail.center().y() - self.height() // 2)

    def _set_idle_header(self, n_cached: int) -> None:
        n = len(self._updates)
        self._stat_ready.set_caption("ready to install")
        self._stat_ready.set_accent(_positive_hex())
        if n == 0:
            # The placeholder inside the list carries the verdict and the
            # last-checked time, so the header just states the fact.
            self._idle_summary = "No updates pending"
            self._sub.setText(self._fit_status_line(self._idle_summary))
            return
        if n_cached < n:
            self._idle_summary = (
                f"<b>{n}</b> package{'s' if n != 1 else ''} available "
                f"<span style='color:{_secondary_hex()}'>· fetching release notes…</span>"
            )
        else:
            self._idle_summary = (
                f"<b>{n}</b> package{'s' if n != 1 else ''} available "
                f"<span style='color:{_secondary_hex()}'>· release notes loaded ✓</span>"
            )
        self._sub.setText(self._fit_status_line(self._idle_summary))

    # — Selection —
    def _select_all(self, checked: bool) -> None:
        self._model.set_all(checked)
        self._refresh_selection_ui()

    def _on_row_toggled(self, row: int) -> None:
        idx = self._model.index(row)
        cur = self._model.data(idx, Qt.ItemDataRole.CheckStateRole)
        self._model.setData(
            idx,
            Qt.CheckState.Unchecked if cur == Qt.CheckState.Checked
            else Qt.CheckState.Checked,
            Qt.ItemDataRole.CheckStateRole)
        self._refresh_selection_ui()

    def _on_model_changed(self, *args) -> None:
        self._refresh_selection_ui()

    def _refresh_selection_ui(self) -> None:
        sel = self._model.selected_count()
        total = self._model.checkable_count()
        self._list_header.set_state(sel, total)
        if self._updating:
            return
        # Nothing to install → the update action is simply off. It never
        # turns into a second "check" button and Refresh never hides: the
        # footer holds its shape whatever the list does (see AGENTS.md).
        if sel == 0 or total == 0:
            self._update_btn.setText("Update")
            self._update_btn.setEnabled(False)
        elif getattr(self, "_retry_mode", False):
            self._update_btn.setText(
                f"Retry {sel} selected" if sel != total else "Retry Update")
            self._update_btn.setEnabled(True)
        else:
            self._update_btn.setText(
                "Update All" if sel == total else f"Update {sel} selected")
            self._update_btn.setEnabled(True)

    # ── Views: Updates | Obsolete | Security ─────────────────────────────────
    def _switch_view(self, key: str) -> None:
        if key == "updates" and self._current_view == "updates":
            # Clicking the active Updates tab = Check Now.
            self._recheck_updates()
            return
        self._current_view = key
        idx = {"updates": 0, "tracked": 1, "untracked": 2,
               "obsolete": 3, "security": 4}[key]
        self._content_stack.setCurrentIndex(idx)
        self._footer_stack.setCurrentIndex(idx)
        self._view_buttons[key].setChecked(True)
        if key == "obsolete" and not self._obs_loaded:
            # Never compute on the GUI thread (pacman spawns freeze
            # the UI) — show a loading note; the checker fills it in.
            self._obs_summary.setText("Scanning for obsolete packages…")
            self._load_obsolete_async()
        if key == "untracked" and not self._untracked_loaded \
                and self._untracked_loader is None:
            # Same lazy pattern: scan only when first opened.
            self._un_loading = True
            self._un_summary.setText("Scanning for untracked software…")
            self._unapp_empty.show_loading(
                "Looking for applications pacman doesn't own…")
            self._unpkg_empty.show_loading(
                "Looking for dependency packages…")
            self._untracked_loader = UntrackedLoader()
            self._untracked_loader.done.connect(self._on_untracked_loaded)
            self._untracked_loader.start()
        self._update_view_badges()

    def _on_filter_changed(self, text: str) -> None:
        """Filter the Updates list (name, description, notes, repo)."""
        if not self._model.set_filter(text):
            return
        self._delegate.invalidate()
        self._refresh_empty_state()
        self._refresh_selection_ui()
        self._note_activity()

    def _apply_tracked_filter(self, text: str) -> None:
        if not self._track_model.set_filter(text):
            return
        self._track_delegate.invalidate()
        self._refresh_tracked_summary()

    # — Stat-strip filters: click a cell to filter, click it again to clear —
    def _toggle_update_filter(self, key: str) -> None:
        cur = self._model.filter_source()
        if not self._model.set_source_filter("" if cur == key else key):
            return
        self._delegate.invalidate()
        self._refresh_empty_state()
        self._refresh_selection_ui()
        self._refresh_stat_active()
        self._note_activity()

    def _refresh_stat_active(self) -> None:
        """Mark the cell whose filter is in force. No geometry change."""
        cur = self._model.filter_source()
        for key, card in self._update_stat_cards.items():
            card.set_active(key == cur)

    def _refresh_update_stats(self) -> None:
        """Recount the four cells from the keys their filters use, so a
        cell always counts exactly what clicking it would show."""
        counts = self._model.source_counts()
        blocked = counts.get("blocked", 0)
        repos = counts.get(SRC_OFFICIAL, 0) + counts.get(SRC_MANAGED, 0)
        self._stat_ready.set_value(str(max(len(self._updates) - blocked, 0)))
        self._stat_official.set_value(str(repos))
        self._stat_aur.set_value(str(counts.get(SRC_AUR, 0)))
        self._stat_blocked.set_value(str(blocked))
        self._stat_blocked.set_accent(_negative_hex() if blocked
                                      else _secondary_hex())
        self._refresh_stat_active()

    def _toggle_track_filter(self, key: str) -> None:
        cur = self._track_model.filter_source()
        if not self._track_model.set_source_filter("" if cur == key else key):
            return
        self._track_delegate.invalidate()
        self._refresh_tracked_summary()
        self._refresh_track_stats()

    def _refresh_track_stats(self) -> None:
        """Counts per source, and which cell is filtering."""
        counts = self._track_model.source_counts()
        self._stat_track_all.set_value(str(sum(counts.values())))
        self._stat_track_off.set_value(str(counts.get(SRC_OFFICIAL, 0)))
        self._stat_track_aur.set_value(str(counts.get(SRC_AUR, 0)))
        self._stat_track_flatpak.set_value(str(counts.get(SRC_FLATPAK, 0)))
        self._stat_track_image.set_value(str(counts.get(SRC_APPIMAGE, 0)))
        managed = sum(n for k, n in counts.items()
                      if k not in (SRC_OFFICIAL, SRC_AUR, SRC_FLATPAK,
                                   SRC_APPIMAGE))
        self._stat_track_managed.set_value(str(managed))
        cur = self._track_model.filter_source()
        for key, card in self._track_stat_cards.items():
            card.set_active(bool(key) and key == cur)

    def _toggle_un_filter(self, key: str) -> None:
        """One source filter for both untracked lists at once."""
        cur = self._unapp_model.filter_source()
        new = "" if cur == key else key
        changed = self._unapp_model.set_source_filter(new)
        changed = self._unpkg_model.set_source_filter(new) or changed
        if not changed:
            return
        self._unapp_delegate.invalidate()
        self._unpkg_delegate.invalidate()
        self._refresh_untracked_summary()
        self._refresh_un_stats()
        self._refresh_un_placeholders()

    def _refresh_un_stats(self) -> None:
        apps = self._unapp_model.source_counts()
        deps = sum(self._unpkg_model.source_counts().values())
        self._stat_un_all.set_value(str(sum(apps.values()) + deps))
        self._stat_un_apps.set_value(str(sum(apps.values())))
        self._stat_un_deps.set_value(str(deps))
        cur = self._unapp_model.filter_source()
        for key, card in self._un_stat_cards.items():
            card.set_active(bool(key) and key == cur)

    def _refresh_empty_state(self) -> None:
        """Loading, up to date, or no matches — inside the list's frame.

        Nothing here moves the surrounding layout: the frame, the header
        and the stat strip are permanent (see AGENTS.md).
        """
        rows = self._model.rowCount()
        filtered = bool(self._model.filter_text()
                        or self._model.filter_source())
        if rows == 0 and not filtered and not self._status_active:
            # "Checked just now" goes stale; re-derive it. Never over a
            # live status message, which owns the line while it is up.
            self._set_idle_header(0)
        if rows:
            self._empty_state.hide_state()
        elif self._loading:
            self._empty_state.show_loading("Checking for updates…")
        elif filtered:
            # Keep the header: the filter box is how you get back.
            source = self._model.filter_source()
            what = (f"“{self._model.filter_text()}”"
                    if self._model.filter_text()
                    else f"the {_SOURCE_META.get(source, (source, ''))[0]} "
                         "filter")
            self._empty_state.show_state(
                "No matches",
                f"Nothing here matches {what}. Clear the filter to see all "
                "packages.",
                icon="search", colour="muted")
        else:
            self._empty_state.show_state(
                "You're up to date", self._last_checked_text(),
                icon="check-circle", colour="positive")
        self._update_view_badges()

    def _last_checked_text(self) -> str:
        """When this list was last confirmed, and when it will be again."""
        interval = TrayApp._CHECK_INTERVAL_MS // 1000
        if not self._checked_at:
            return "Not checked yet."
        age = time.time() - self._checked_at
        if age < 90:
            when = "just now"
        elif age < 3600:
            when = f"{max(int(age // 60), 1)} minutes ago"
        else:
            when = ("at " + time.strftime("%H:%M",
                                          time.localtime(self._checked_at)))
        left = int((interval - age) // 60)
        if left <= 0:
            nxt = "checking again shortly"
        elif left == 1:
            nxt = "next check in a minute"
        else:
            nxt = f"next check in {left} minutes"
        return f"Last checked {when} · {nxt}."

    def _mark_checked(self) -> None:
        self._checked_at = time.time()

    # — In-window recheck (Check now button, or clicking the active
    # Updates tab) —
    def _recheck_updates(self) -> None:
        if self._updating or self._single is not None:
            self._set_status(
                "An install is still running — please wait…", "info")
            return
        if self._rechecker is not None and self._rechecker.isRunning():
            return  # already checking
        self._release_thread("_rechecker")
        self._log_action("Checking for updates…")
        self._set_status("Checking for updates…", "info")
        # The tab keeps its label: changing it would reflow the whole
        # switcher sideways (see AGENTS.md). The status line and the list
        # placeholder carry the "working" signal instead.
        self._view_buttons["updates"].setEnabled(False)
        self._recheck_btn.setEnabled(False)
        self._update_btn.setEnabled(False)
        self._set_progress_state("active")
        self._progress.setRange(0, 0)  # busy
        self._progress.setFormat("")
        # The list reports that it is working — but only when it has
        # nothing to show; over live rows the status line says it
        # (see _refresh_empty_state).
        self._loading = True
        self._refresh_empty_state()
        self._rechecker = UpdateChecker(self._aur_helper)
        self._rechecker.updates_found.connect(self._on_recheck_found)
        self._rechecker.no_updates.connect(self._on_recheck_empty)
        self._rechecker.start()

    def _seed_cached_info(self, updates: list[dict]) -> dict:
        """Seed row details from the on-disk cache (same as TrayApp)."""
        cache = load_pkg_info_cache()
        cached: dict = {}
        for i, pkg in enumerate(updates):
            entry = cache.get(pkg["name"])
            if entry and entry.get("version") == pkg["new"]:
                cached[i] = (
                    entry.get("desc") or "No description available",
                    entry.get("notes") or "",
                    entry.get("date") or "",
                    entry.get("full") or "",
                    entry.get("source") or "",
                    entry.get("source_url") or "",
                )
        return cached

    def _on_recheck_found(self, updates: list[dict]) -> None:
        self._release_thread("_rechecker")
        self._mark_checked()
        self._swap_updates_model(updates, self._seed_cached_info(updates))
        n = len(updates)
        self._log_action(
            f"Check complete — {n} update{'s' if n != 1 else ''} available")
        self._start_recheck_fetcher()

    def _on_recheck_empty(self) -> None:
        self._release_thread("_rechecker")
        self._mark_checked()
        self._swap_updates_model([], {})
        self._set_status("Check complete — system is up to date ✓", "ok")
        self._log_action("Check complete — system is up to date ✓")

    def _swap_updates_model(self, updates: list[dict], cached: dict) -> None:
        """Replace the Updates list with fresh check results.

        Drops any in-flight info feed (its rows describe the old list),
        resets run/failure state, and refreshes every count + badge.
        """
        self._stop_recheck_fetcher()
        self._info_gen += 1
        self._loading = False
        self._updates = updates
        self._compromised = any(pkg.get("compromised") for pkg in updates)
        self._model = PackageModel(updates, cached)
        self._list.setModel(self._model)
        self._model.dataChanged.connect(self._on_model_changed)
        self._model.rowsInserted.connect(lambda *a: self._refresh_empty_state())
        self._model.rowsRemoved.connect(lambda *a: self._refresh_empty_state())
        # Doc cache describes the old rows — rebuild (also repaints).
        self._delegate.refresh_theme()
        self._safe_names = []
        self._last_run_names = []
        self._done_names = set()
        self._live_conflicts = {}
        self._seen_building = set()
        self._installing_row = None
        self._retry_mode = False
        self._overwrite = None
        self._fail_sig = None
        self._fail_streak = 0
        self._hide_failure_ui()
        self._set_progress_state("normal")
        self._progress.setRange(0, 1)
        self._progress.setValue(0)
        self._progress.setFormat("")
        n = len(updates)
        self._stat_ready.set_caption("ready to install")
        self._stat_ready.set_accent(_positive_hex())
        self._refresh_update_stats()
        n_cached = len(cached)
        self._set_idle_header(n_cached)
        if n_cached < n:
            self._progress.setRange(0, max(n, 1))
            self._progress.setValue(n_cached)
        self.setWindowTitle(
            f"Arch Update — {n} package{'s' if n != 1 else ''} available")
        self._refresh_empty_state()
        self._refresh_selection_ui()
        self._refresh_reboot_chip()
        self._update_view_badges()  # restores the Updates tab text + count
        self._view_buttons["updates"].setEnabled(True)
        self._recheck_btn.setEnabled(True)
        self._refresh_view_banners()

    def _clear_container(self, slot: QWidget) -> None:
        lay = slot.layout()
        while lay.count():
            it = lay.takeAt(0)
            w = it.widget()
            if w is not None:
                w.deleteLater()

    def _rebuild_security_banner(self) -> None:
        """Security banner inside its slot, mirroring the current list.

        Hidden is the default: no compromised rows → no banner. When
        shown, this is one of the two allowed layout shifts (AGENTS.md).
        """
        self._clear_container(self._slot_security)
        comp_pkgs = [p for p in self._updates if p.get("compromised")]
        if not comp_pkgs:
            self._slot_security.setVisible(False)
            return
        banner = QWidget()
        banner.setObjectName("banner-danger")
        banner.setAttribute(Qt.WidgetAttribute.WA_StyledBackground, True)
        blay = _card_layout(banner, _negative_hex())
        btitle = QLabel(
            f"Security warning — {len(comp_pkgs)} compromised "
            f"package{'s' if len(comp_pkgs) != 1 else ''} will be skipped"
        )
        btitle.setObjectName("banner-title")
        btitle.setWordWrap(True)
        blay.addWidget(btitle)
        comp_names = "\n".join(
            f"  • {p['name']}: {'; '.join(p.get('compromise_reasons', ['unknown']))}"
            for p in comp_pkgs
        )
        bbody = QLabel(
            f"{comp_names}\n"
            "These packages will be skipped during update — safe packages "
            "can still be installed. Leave the flagged packages alone "
            "until they are verified safe."
        )
        bbody.setObjectName("banner-body")
        bbody.setWordWrap(True)
        bbody.setTextInteractionFlags(
            Qt.TextInteractionFlag.TextSelectableByMouse
        )
        blay.addWidget(bbody)
        self._slot_security.layout().addWidget(banner)
        self._slot_security.setVisible(True)

    def _rebuild_moves_banner(self, recompute: bool = False) -> None:
        """AUR→managed banner inside its slot, mirroring the current list.

        `recompute` (construction only) asks pacman for the candidate set;
        afterwards the set is just filtered to the names the fresh check
        still lists — no settle-time forks on the GUI thread.
        """
        _aur_names = {p["name"] for p in self._updates
                      if (p.get("repo") or "").lower() == "aur"}
        if not _aur_names:
            self._pending_moves = []
        elif recompute:
            # Detection is two fast local pacman calls; allowed here only
            # because the window is mid-construction (established pattern).
            try:
                self._pending_moves = [
                    m for m in find_repo_moves(list(_aur_names))
                    if m["name"] in _aur_names]
            except Exception:
                self._pending_moves = []
        else:
            self._pending_moves = [
                m for m in (self._pending_moves or []) if m["name"] in _aur_names]
        self._clear_container(self._slot_moves)
        if not self._pending_moves:
            self._slot_moves.setVisible(False)
            return
        mv = QWidget()
        mv.setObjectName("banner-moves")
        mv.setAttribute(Qt.WidgetAttribute.WA_StyledBackground, True)
        mv_body = _card_layout(mv, _accent_hex())
        mb = QHBoxLayout()
        mb.setSpacing(_sp(12))
        mv_body.addLayout(mb)
        mt = QLabel(
            f"<b>{len(self._pending_moves)} of these AUR packages "
            f"{'is' if len(self._pending_moves) == 1 else 'are'} also in "
            "a managed repo</b> — switch for a signed, prebuilt "
            "package.")
        mt.setObjectName("banner-body")
        mt.setWordWrap(True)
        mb.addWidget(mt, 1)
        review_btn = QPushButton("Review")
        review_btn.setObjectName("secondary-small")
        review_btn.setFixedHeight(_sp(28))
        review_btn.clicked.connect(self._open_moves_dialog)
        mb.addWidget(review_btn)
        self._slot_moves.layout().addWidget(mv)
        self._slot_moves.setVisible(True)

    def _refresh_view_banners(self, recompute_moves: bool = False) -> None:
        self._rebuild_security_banner()
        self._rebuild_moves_banner(recompute=recompute_moves)

    def _start_recheck_fetcher(self) -> None:
        """Fetch release notes for the fresh rows (generation-stamped)."""
        self._stop_recheck_fetcher()
        gen = self._info_gen
        self._recheck_fetcher = InfoFetcher(self._updates)
        self._recheck_fetcher.row_ready.connect(
            lambda *a: self._on_recheck_row(gen, *a))
        self._recheck_fetcher.finished.connect(
            lambda: self._on_recheck_fetch_done(gen))
        self._recheck_fetcher.start()

    def _on_recheck_row(self, gen: int, row: int, name: str, new_ver: str,
                        desc: str, notes: str, date: str, full: str,
                        source: str, source_url: str) -> None:
        if gen == self._info_gen:
            # Pass the generation through: on_info_ready drops
            # generation-less (tray) feeds once a recheck has landed.
            self.on_info_ready(row, desc, notes, date, full, source,
                               source_url, gen=gen)

    def _on_recheck_fetch_done(self, gen: int) -> None:
        if gen == self._info_gen:
            self.on_fetch_done(gen)
        self._release_thread("_recheck_fetcher")

    def _stop_recheck_fetcher(self) -> None:
        f = self._recheck_fetcher
        if f is None:
            return
        self._recheck_fetcher = None
        try:
            f.requestInterruption()
        except Exception:
            pass
        # Stale rows are fenced by the generation check; a still-running
        # fetcher is parked, never destroyed live.
        if f.isRunning() and not f.wait(5000):
            self._park_thread(f)

    # ── Obsolete view ────────────────────────────────────────────────────────
    def _refresh_obsolete_view(self) -> None:
        try:
            names = get_obsolete_packages()
        except Exception:
            names = []
        self._fill_obsolete_view(names)

    def _refresh_obsolete(self) -> None:
        """Rescan for packages no repository provides (never on this thread)."""
        if self._obs_checker is not None and self._obs_checker.isRunning():
            return
        self._log_action("Rescanning for obsolete packages…")
        self._obs_loaded = False
        self._obs_summary.setText("Rescanning for obsolete packages…")
        if not self._obs_cards:
            self._obs_empty.show_loading(
                "Looking for packages no repository provides…")
        self._load_obsolete_async()

    def _load_obsolete_async(self) -> None:
        """(Re)compute the obsolete list in the background."""
        if not self._obs_cards:
            # Never a blank box — and this must come first: opening the tab
            # while the initial scan is still running takes the early
            # return below, which would otherwise leave the box empty.
            self._obs_empty.show_loading(
                "Looking for packages no repository provides…")
        old = self._obs_checker
        if old is not None and old.isRunning():
            return  # already loading; its done signal fills the view
        self._obs_checker = ObsoleteChecker()
        self._obs_checker.done.connect(self._on_obs_preload_done)
        self._obs_checker.start()

    def _on_obs_preload_done(self, names: list[str]) -> None:
        self._release_thread("_obs_checker")
        if not self._obs_loaded:
            self._fill_obsolete_view(names)
        # Chain the tracked load AFTER obsolete finishes: never fork
        # pacman from two threads at once (multithreaded fork +
        # concurrent subprocess I/O segfaults).
        if not self._track_loaded and self._track_loader is None:
            self._track_loader = TrackedLoader()
            self._track_loader.done.connect(self._on_tracked_loaded)
            self._track_loader.start()

    def _fill_obsolete_view(self, names: list[str]) -> None:
        self._obs_loaded = True
        self._obs_names = names
        for card in self._obs_cards.values():
            self._obs_lay.removeWidget(card)
            card.deleteLater()
        self._obs_cards = {}
        for name in names:
            card = _ObsoleteRow(name)
            self._obs_cards[name] = card
            self._obs_lay.insertWidget(self._obs_lay.count() - 1, card)
        if names:
            self._obs_summary.setText(
                f"<b>{len(names)}</b> package"
                f"{'s' if len(names) != 1 else ''} no longer provided by any "
                "repository — usually split packages dropped upstream. "
                "Safe to remove.")
            self._obs_empty.hide_state()
            self._obs_footer_label.setText(
                f"{len(names)} obsolete package{'s' if len(names) != 1 else ''}")
            self._obs_remove_btn.setText(
                f"Remove {len(names)} obsolete")
        else:
            self._obs_summary.setText(
                "Nothing obsolete — every installed package is still "
                "provided by a repository.")
            self._obs_empty.show_state(
                "Nothing to clean up",
                "Every installed package is still provided by a repository.",
                icon="check-circle", colour="positive")
            self._obs_footer_label.setText("Nothing to remove")
            self._obs_remove_btn.setText("Remove obsolete")
        self._obs_remove_btn.setEnabled(bool(names))
        self._update_view_badges()

    def _remove_obsolete_from_view(self) -> None:
        if not self._obs_names or self._remover is not None:
            return
        if self._removal_can_wait("obsolete", list(self._obs_names)):
            return
        names = "\n".join(f"  • {pkg}" for pkg in self._obs_names)
        box = QMessageBox(self)
        box.setWindowTitle("Remove obsolete packages")
        box.setIcon(QMessageBox.Icon.Warning)
        box.setText(
            "These installed packages are no longer provided by any enabled\n"
            "repository (e.g. split packages dropped upstream). They can block\n"
            "future updates and are generally safe to remove:\n\n"
            f"{names}\n\n"
            "Remove them now?"
        )
        remove_btn = box.addButton("Remove", QMessageBox.ButtonRole.AcceptRole)
        box.addButton("Cancel", QMessageBox.ButtonRole.RejectRole)
        box.exec()
        if box.clickedButton() is not remove_btn:
            return
        self._obsolete_ctx = "obsolete"
        self._start_obsolete_removal(list(self._obs_names))

    # ── Security view ────────────────────────────────────────────────────────
    def _sec_placeholder_ready(self) -> None:
        """Before the first scan: say what a scan is for, in the box."""
        self._sec_empty.show_state(
            "Not scanned yet",
            "Run a scan to check every installed package against known "
            "supply-chain attacks.",
            icon="search", colour="muted")

    def _run_security_scan(self) -> None:
        if self._sec_scanner is not None and self._sec_scanner.isRunning():
            return
        self._sec_scan_btn.setEnabled(False)
        self._sec_status.setText("Scanning installed packages…")
        self._sec_empty.show_loading("Checking installed packages against "
                                     "known supply-chain attacks…")
        for card in self._sec_cards.values():
            self._sec_lay.removeWidget(card)
            card.deleteLater()
        self._sec_cards = {}
        self._sec_scanner = SystemScanner()
        self._log_action("Security scan started")
        self._sec_scanner.progress.connect(self._on_sec_progress)
        self._sec_scanner.done.connect(self._on_sec_done)
        self._sec_scanner.start()

    def _on_sec_progress(self, current: int, total: int, pkg: str) -> None:
        self._sec_status.setText(f"Scanning… {current}/{total}  ({pkg})")

    def _on_sec_done(self, results: list[dict]) -> None:
        self._release_thread("_sec_scanner")
        self._sec_scan_btn.setEnabled(True)
        n_comp = sum(1 for r in results if r.get("compromised"))
        for pkg in results:
            if not pkg.get("compromised"):
                continue  # clean list stays quiet; only findings shown
            card = _ScanRow(pkg)
            self._sec_cards[pkg["name"]] = card
            self._sec_lay.insertWidget(self._sec_lay.count() - 1, card)
        n = len(results)
        self._sec_footer_label.setText(
            f"{n_comp} compromised of {n} checked" if n_comp
            else f"{n} checked — none compromised")
        self._log_action(
            f"Security scan complete — {n} checked, "
            f"{n_comp} compromised")
        if n_comp:
            self._sec_empty.hide_state()
            self._sec_status.setText(
                f"<b style='color:{_negative_hex()}'>{n_comp} compromised package"
                f"{'s' if n_comp != 1 else ''} found</b> — review "
                f"{'it' if n_comp == 1 else 'them'} before updating.")
            self._set_status(
                f"Security scan: {n_comp} compromised package"
                f"{'s' if n_comp != 1 else ''} found — see Security view.",
                "error")
        else:
            self._sec_empty.show_state(
                "Nothing found", f"{n} packages checked — none compromised.",
                icon="check-circle", colour="positive")
            # Back to the standing instruction: the count is in the footer
            # and the verdict is in the empty state, so nothing repeats.
            self._sec_status.setText(_SEC_SCAN_HINT)
            self._set_status(
                f"Security scan complete — {n} packages checked, "
                "none compromised.", "ok")


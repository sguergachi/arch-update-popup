                    raw, buf = buf.split("\n", 1)
                    for fragment in raw.split("\r"):
                        fragment = _ANSI_RE.sub("", fragment).strip()
                        if fragment:
                            lines.append(fragment)
            elif proc.poll() is not None:
                break

        try:
            os.close(master_fd)
        except OSError:
            pass

        proc.wait()
        self._cleanup()
        if self._killed:
            lines.append("Cancelled by user.")
        self.done.emit(proc.returncode == 0 and not self._killed,
                       "\n".join(lines[-8:]))

    def terminate(self) -> None:  # type: ignore[override]
        """Ask the remover to stop (window closed mid-removal)."""
        self._killed = True
        proc = self._proc
        if proc is not None:
            try:
                proc.terminate()
            except Exception:
                pass


# ── Design system ──────────────────────────────────────────────────────────
#
# Grid — one 4px unit, an 8px rhythm. Every edge in the window lands on it:
#   window padding 24 · zone gap 16 · item gap 8 · micro gap 4
#   card padding 16 × 12 · card gap 8 · radius 6 (3 for bars and pills)
#   control height 34 · small control 28
#
# Type — a single scale, proportional to the desktop's own UI font so a
# larger system font grows the window instead of clipping it:
#   title 20 · stat 22 · body 13 · secondary 12 · eyebrow 11 (uppercase,
#   letterspaced) · mono 12. Nothing else, ever.
#
# Color — surfaces come from the desktop palette, and the *semantic* colors
# come from the active KDE color scheme, so the app inherits the user's
# accent (Breeze blue by default) instead of shipping a second palette.
# Danger/neutral/positive therefore always match the rest of the desktop.

# The UI font size the scale below was drawn for, in logical pixels
# (11pt on a 96dpi desktop). Everything in the scale is expressed in
# these units and multiplied by the real desktop font's ratio.
_BASE_PX = 14.67

# Breeze palette — the fallback when no KDE color scheme can be read.
_BREEZE = {
    False: {"bg": "#eff0f1", "fg": "#232629", "accent": "#3daee9",
            "positive": "#176837", "neutral": "#c65f00", "negative": "#b03745",
            "link": "#2d7faa", "muted": "#757575", "visited": "#7b3fa0"},
    True:  {"bg": "#202326", "fg": "#fcfcfc", "accent": "#3daee9",
            "positive": "#27ae60", "neutral": "#f67400", "negative": "#da4453",
            "link": "#3daee9", "muted": "#a9a9a9", "visited": "#9b59b6"},
}

# KDE keeps its palette in kdeglobals. Qt only surfaces a handful of those
# roles through QPalette, so the rest (positive/neutral/negative/link, the
# accent) are read from the file — the same source KColorScheme uses.
_KDE_GLOBALS = os.path.expanduser("~/.config/kdeglobals")
_KDE_CACHE: dict[tuple, dict] = {}


def _hex_from_kde(value: str) -> str | None:
    """'61,174,233' (KDE) → '#3daee9'. None when unparsable."""
    parts = [p.strip() for p in (value or "").split(",")]
    if len(parts) != 3:
        return None
    try:
        rgb = [max(0, min(255, int(p))) for p in parts]
    except ValueError:
        return None
    return "#%02x%02x%02x" % tuple(rgb)


def _kde_scheme() -> dict:
    """Semantic colors from the active KDE color scheme (cached by mtime).

    Returns {} when the file is missing or unreadable, so callers fall
    back to the Breeze table above.
    """
    try:
        st = os.stat(_KDE_GLOBALS)
        key = (_KDE_GLOBALS, st.st_mtime_ns, st.st_size)
    except OSError:
        return {}
    hit = _KDE_CACHE.get(key)
    if hit is not None:
        return hit

    raw: dict[tuple[str, str], str] = {}
    section = ""
    try:
        with open(_KDE_GLOBALS, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line or line[0] in "#;":
                    continue
                if line[0] == "[" and line.endswith("]"):
                    section = line[1:-1]
                    continue
                key_name, sep, value = line.partition("=")
                if sep:
                    raw[(section, key_name.strip())] = value.strip()
    except OSError:
        return {}

    def get(section_name: str, key_name: str) -> str | None:
        return _hex_from_kde(raw.get((section_name, key_name), ""))

    window_bg = get("Colors:Window", "BackgroundNormal")
    scheme = {
        "bg": window_bg,
        "fg": get("Colors:Window", "ForegroundNormal"),
        # A custom accent lands in [General]; otherwise the focus color is it.
        "accent": (get("General", "AccentColor")
                   or get("Colors:Window", "DecorationFocus")),
        "positive": get("Colors:Window", "ForegroundPositive"),
        "neutral": get("Colors:Window", "ForegroundNeutral"),
        "negative": get("Colors:Window", "ForegroundNegative"),
        "link": get("Colors:Window", "ForegroundLink"),
        "muted": get("Colors:Window", "ForegroundInactive"),
        "visited": get("Colors:Window", "ForegroundVisited"),
    }
    scheme = {k: v for k, v in scheme.items() if v}
    _KDE_CACHE.clear()
    _KDE_CACHE[key] = scheme
    return scheme


def _mix(a: str, b: str, t: float) -> str:
    """Blend two #rrggbb colors; t=0 → a, t=1 → b."""
    try:
        ca, cb = QColor(a), QColor(b)
        return QColor(
            round(ca.red() + (cb.red() - ca.red()) * t),
            round(ca.green() + (cb.green() - ca.green()) * t),
            round(ca.blue() + (cb.blue() - ca.blue()) * t),
        ).name()
    except Exception:
        return a


def _is_dark_theme() -> bool:
    """True when the desktop runs a dark theme (palette-based)."""
    app = QApplication.instance()
    if app is None:
        return False
    return (app.palette().color(QPalette.ColorRole.Window).lightness() < 128)


def _secondary_hex() -> str:
    """Secondary/muted text that stays readable on both themes."""
    return "#a9a9a9" if _is_dark_theme() else "#757575"


def _text_hex() -> str:
    """Primary text color from the active palette (theme-aware)."""
    app = QApplication.instance()
    if app is None:
        return "#1a1a1a"
    return app.palette().color(QPalette.ColorRole.Text).name()


def _tokens() -> dict:
    """The active color tokens, resolved once per light/dark flip."""
    dark = _is_dark_theme()
    cached = _TOKEN_CACHE.get(dark)
    if cached is not None:
        return cached

    base = dict(_BREEZE[dark])
    scheme = _kde_scheme()
    scheme_dark = None
    if scheme.get("bg"):
        scheme_dark = QColor(scheme["bg"]).lightness() < 128
    # The accent is meaningful in either mode; the other semantics only
    # when the scheme actually describes the mode we are drawing.
    if scheme.get("accent"):
        base["accent"] = scheme["accent"]
    if scheme_dark == dark:
        for key in ("positive", "neutral", "negative", "link", "visited"):
            if scheme.get(key):
                base[key] = scheme[key]

    app = QApplication.instance()
    win = (app.palette().color(QPalette.ColorRole.Window).name()
           if app is not None else base["bg"])
    text = (app.palette().color(QPalette.ColorRole.Text).name()
            if app is not None else base["fg"])
    # Two steps of surface: a recessed canvas for lists, and cards that sit
    # on top of it. Both are derived, so cards read as raised on any scheme.
    canvas = _mix(win, "#000000" if dark else text, 0.22 if dark else 0.05)
    surface = _mix(win, "#ffffff", 1.0 if not dark else 0.07)
    tokens = dict(base)
    tokens.update({
        "dark": dark,
        "window": win,
        "canvas": canvas,
        "surface": surface,
        "border": _mix(canvas, text, 0.18 if dark else 0.14),
        "hover": _mix(surface, text, 0.10),
        "text": text,
    })
    _TOKEN_CACHE.clear()
    _TOKEN_CACHE[dark] = tokens
    return tokens


_TOKEN_CACHE: dict[bool, dict] = {}


def _surface_hex() -> str:
    return _tokens()["surface"]


def _border_hex() -> str:
    return _tokens()["border"]


def _accent_hex() -> str:
    return _tokens()["accent"]


def _soft(hex_color: str, alpha: float = 0.16) -> str:
    """A color at `alpha` — the tinted pill/selection fill."""
    c = QColor(hex_color)
    return f"rgba({c.red()},{c.green()},{c.blue()},{alpha})"


def _accent_soft(alpha: float = 0.18) -> str:
    """Accent at `alpha` over the surface — for selected/focused fills."""
    return _soft(_accent_hex(), alpha)


def _on_accent_hex() -> str:
    """Text/icon color that stays legible on an accent-filled control."""
    return "#ffffff" if QColor(_accent_hex()).lightness() < 170 else "#202326"


def _on_warning_hex() -> str:
    """Text/icon color that stays legible on a warning-filled control."""
    return ("#202326" if QColor(_warning_hex()).lightness() > 150
            else "#ffffff")


def _positive_hex() -> str:
    return _tokens()["positive"]


def _warning_hex() -> str:
    return _tokens()["neutral"]


def _negative_hex() -> str:
    return _tokens()["negative"]


def _link_hex() -> str:
    return _tokens()["link"]


def _visited_hex() -> str:
    return _tokens()["visited"]


def _font_scale() -> float:
    """Type-scale factor: 1.0 at the 10pt KDE default UI font.

    Type follows the desktop's own UI font so a larger system font grows
    the window instead of clipping it. Spacing stays on the fixed 4px grid.
    """
    app = QApplication.instance()
    if app is None:
        return 1.0
    font = app.font()
    pt = font.pointSizeF()
    if pt <= 0:
        px = font.pixelSize()
        pt = (px * 72.0 / 96.0) if px > 0 else 10.0
    return max(0.9, min(1.35, (pt * 96.0 / 72.0) / _BASE_PX))


# Cached scale, refreshed by _themed_qss(): the delegates lay out hundreds
# of rows and must not re-query the application font per row.
_SCALE = 1.0


def _sp(n: int) -> int:
    """Scale a designed px value by the desktop font scale."""
    return max(1, round(n * _SCALE))



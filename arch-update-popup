        super().mousePressEvent(event)


# ── Virtualized package list ─────────────────────────────────────────────
#
# Hundreds of package cards must scroll at 60fps with no dropped frames,
# so rows are *painted* (QListView + QStyledItemDelegate) instead of
# widget trees: one paint pass per visible row, text laid out with cached
# QTextDocuments, and progress updates repaint only the affected row via
# dataChanged. Hit-testing (checkbox / links / action pill) is computed
# from the same layout the painter uses.

_SNIPPET_LEN = 120


class _FilterableModel:
    """Visible-row mapping shared by the card lists.

    `_items` stays the source of truth in source order (the order the
    info fetcher reports rows in); `_visible` holds the source indices the
    current filter lets through. Every public accessor speaks *visible*
    rows, so views, delegates and hit-testing never see a hidden row.
    """

    _items: list[dict]

    def _init_filter(self) -> None:
        self._filter = ""
        self._source = ""        # "" = every source
        self._visible = list(range(len(self._items)))

    # — Mapping —
    def _src(self, row: int) -> int:
        return self._visible[row]

    def filter_text(self) -> str:
        return self._filter

    def filter_source(self) -> str:
        return self._source

    def _matches(self, item: dict) -> bool:
        if self._source and not self._source_match(item, self._source):
            return False
        if not self._filter:
            return True
        hay = " ".join(str(item.get(key) or "") for key in
                       ("name", "title", "desc", "notes", "repo")).lower()
        return self._filter in hay

    def _item_source(self, item: dict) -> str:
        """Source key for one row — models with their own idea override."""
        return _source_key(item.get("repo", ""))

    def _source_match(self, item: dict, key: str) -> bool:
        """Does `item` belong to filter key `key`? Overridable."""
        return self._item_source(item) == key

    def set_filter(self, text: str) -> bool:
        """Apply a filter; True when the visible set actually changed."""
        needle = " ".join((text or "").lower().split())
        if needle == self._filter:
            return False
        self._filter = needle
        self._refilter()
        return True

    def set_source_filter(self, source: str) -> bool:
        """Show one source only ('' clears it). True when it changed."""
        if source == self._source:
            return False
        self._source = source
        self._refilter()
        return True

    def _refilter(self) -> None:
        self.beginResetModel()
        self._visible = [i for i, it in enumerate(self._items)
                         if self._matches(it)]
        self.endResetModel()

    def source_counts(self) -> dict[str, int]:
        """{source key: rows} across the whole list, filter or no filter."""
        counts: dict[str, int] = {}
        for it in self._items:
            key = self._item_source(it)
            counts[key] = counts.get(key, 0) + 1
        return counts

    def row_of(self, name: str) -> int | None:
        for row, src in enumerate(self._visible):
            if self._items[src]["name"] == name:
                return row
        return None

    def visible_items(self) -> list[dict]:
        return [self._items[src] for src in self._visible]

    def hidden_count(self) -> int:
        return len(self._items) - len(self._visible)

    def source_count(self) -> int:
        """Rows in the full list, filter or no filter."""
        return len(self._items)


class _ViewResizeHook(QObject):
    """Re-lay fixed-mode card rows when the viewport width changes.

    The lists use ResizeMode.Fixed: row sizes are queried once and never
    re-measured, so a narrower viewport (opening the log panel, a window
    resize) keeps the old row width — cards clip on the right and a
    horizontal scrollbar appears.
    """
    def __init__(self, view: "QListView") -> None:
        QObject.__init__(self, view)
        self._view = view

    def eventFilter(self, obj, ev) -> bool:  # noqa: N802
        if ev.type() == QEvent.Type.Resize:
            self._view.doItemsLayout()
        return False


class PackageModel(_FilterableModel, QAbstractListModel):
    """One dict per package; check state lives in Qt.CheckStateRole."""

    def _item_source(self, item: dict) -> str:
        """A compromised package answers to BLOCKED, not to its repo: the
        stat strip counts what will actually be installed."""
        if item.get("compromised"):
            return "blocked"
        return _source_key(item.get("repo", ""))

    def _source_match(self, item: dict, key: str) -> bool:
        if key == "ready":
            return not item.get("compromised")
        if key == "repos":
            return self._item_source(item) in (SRC_OFFICIAL, SRC_MANAGED)
        return self._item_source(item) == key

    def __init__(self, updates: list[dict], cached: dict) -> None:
        super().__init__()
        self._items: list[dict] = []
        for i, pkg in enumerate(updates):
            c = cached.get(i, ("", "", "", "", "", ""))
            desc, notes, date, full, src, surl = (list(c) + [""] * 6)[:6]
            comp = bool(pkg.get("compromised"))
            self._items.append({
                "name": pkg["name"], "old": pkg.get("old", ""),
                "new": pkg.get("new", ""),
                "repo": pkg.get("repo", ""), "compromised": comp,
                "reasons": list(pkg.get("compromise_reasons", [])),
                "desc": desc or "Loading description…",
                "notes": notes or "Fetching release notes…",
                "date": date or "", "full": full or notes,
                "source": src, "source_url": surl,
                "checked": not comp,
                "state": "idle", "_rev": 0,
            })
        self._init_filter()

    # — Qt interface —
    def rowCount(self, parent: QModelIndex | None = None) -> int:
        return (0 if parent is not None and parent.isValid()
                else len(self._visible))

    def item(self, row: int) -> dict:
        return self._items[self._src(row)]

    def flags(self, index: QModelIndex) -> Qt.ItemFlag:
        f = super().flags(index) | Qt.ItemFlag.ItemIsEnabled
        if index.isValid() and not self._items[index.row()]["compromised"]:
            f |= Qt.ItemFlag.ItemIsUserCheckable
        return f

    def data(self, index: QModelIndex, role: int = Qt.ItemDataRole.DisplayRole):
        if not index.isValid():
            return None
        it = self._items[index.row()]
        if role == Qt.ItemDataRole.DisplayRole:
            return it["name"]
        if role == Qt.ItemDataRole.CheckStateRole:
            return (Qt.CheckState.Checked if it["checked"]
                    else Qt.CheckState.Unchecked)
        return None

    def setData(self, index: QModelIndex, value, role: int = Qt.ItemDataRole.EditRole) -> bool:
        if (role == Qt.ItemDataRole.CheckStateRole and index.isValid()
                and not self._items[index.row()]["compromised"]):
            it = self._items[index.row()]
            it["checked"] = value in (Qt.CheckState.Checked, 2, True)
            self.dataChanged.emit(index, index, [role])
            return True
        return False

    # — Bulk helpers —
    def set_all(self, checked: bool) -> None:
        """Tick/untick everything the current filter is showing."""
        for it in self.visible_items():
            if not it["compromised"]:
                it["checked"] = checked
        if self._visible:
            self.dataChanged.emit(
                self.index(0), self.index(len(self._visible) - 1),
                [Qt.ItemDataRole.CheckStateRole])

    def checked_names(self) -> list[str]:
        return [it["name"] for it in self.visible_items()
                if it["checked"] and not it["compromised"]]

    def selected_count(self) -> int:
        return sum(1 for it in self.visible_items()
                   if it["checked"] and not it["compromised"])

    def checkable_count(self) -> int:
        return sum(1 for it in self.visible_items()
                   if not it["compromised"])

    def names(self) -> list[str]:
        return [it["name"] for it in self._items]

    def ensure_row(self, name: str) -> int:
        """Return the row for `name`, inserting a dependency row if new.

        pacman/paru often install packages that were never in the update
        list (dependencies, build deps). Without a row they are invisible:
        progress names something the list doesn't show, and a failure in
        one of them can't be highlighted. Auto rows start unchecked.
        """
        r = self.row_of(name)
        if r is not None:
            return r
        r = len(self._visible)
        self.beginInsertRows(QModelIndex(), r, r)
        self._items.append({
            "name": name, "old": "", "new": "",
            "repo": "", "compromised": False, "reasons": [],
            "desc": "Added automatically as a dependency while installing "
                    "— it wasn't in the update list.",
            "notes": "No changelog for auto-added packages.",
            "date": "", "full": "", "source": "", "source_url": "",
            "checked": False, "state": "idle", "_rev": 0, "auto": True,
        })
        # Auto-added rows are always visible: the user must be able to see
        # the dependency that is being installed for them.
        self._visible.append(len(self._items) - 1)
        self.endInsertRows()
        return r

    def set_state(self, name: str, state: str) -> None:
        r = self.row_of(name)
        if r is not None:
            self._items[r]["state"] = state
            idx = self.index(r)
            self.dataChanged.emit(idx, idx, [])

    def reset_states(self) -> None:
        for row, src in enumerate(self._visible):
            it = self._items[src]
            if it["state"] != "idle":
                it["state"] = "idle"
                idx = self.index(row)
                self.dataChanged.emit(idx, idx, [])

    def set_info(self, row: int, desc: str, notes: str, date: str,
                 full: str, source: str, source_url: str) -> None:
        """Row here is the *source* index the info fetcher reports."""
        if not 0 <= row < len(self._items):
            return
        it = self._items[row]
        it.update(desc=desc or it["desc"], notes=notes or it["notes"],
                  date=date or "", full=full or notes,
                  source=source, source_url=source_url)
        it["_rev"] += 1
        try:
            visible = self._visible.index(row)
        except ValueError:
            return  # filtered out; nothing on screen to repaint
        idx = self.index(visible)
        self.dataChanged.emit(idx, idx, [])

    # — Show-more popover (see UpdateWindow.show_popover) —


class PackageDelegate(QStyledItemDelegate):
    """Paints package cards and hit-tests their interactive zones."""

    toggled = pyqtSignal(int)            # checkbox flipped
    link_activated = pyqtSignal(str)    # external URL clicked
    more_requested = pyqtSignal(int)    # show more / less
    action_requested = pyqtSignal(str)  # retry / install-anyway for pkg

    RAIL = 28       # checkbox / status icon column
    PAD = 16        # card inner padding (horizontal, 4u)
    PTOP = 10       # card inner padding top
    PBOT = 10       # card inner padding bottom
    CDX = 8         # card inset inside the row (horizontal, 2u)
    CDY = 4         # card inset inside the row (vertical → 8px row gap)

    # Row rhythm inside a card, on the 4px grid (scaled at layout time so
    # a larger desktop font never clips its own text).
    H_NAME = 20
    H_LINE = 16
    H_NOTES = 18
    GAP = 2
    GAP_NOTES = 3

    def _rows(self) -> tuple[int, int, int]:
        return (_sp(self.H_NAME), _sp(self.H_LINE), _sp(self.H_NOTES))

    def __init__(self, view: QListView) -> None:
        super().__init__(view)
        self._view = view
        self._docs: dict = {}
        self._geo: dict = {}
        self._hover: tuple[int, str] = (-1, "")
        self._phase = 0
        self._paint_failed = False
        # Three steps only: the package name, the metadata lines, and the
        # letterspaced pill. Everything is sized from the app font, so a
        # larger desktop font scales the whole card.
        self._f_name = QFont()
        self._f_name.setBold(True)
        self._f_text = QFont()
        self._f_text.setPointSizeF(self._f_text.pointSizeF() - 1.0)
        self._f_bold = QFont(self._f_text)
        self._f_bold.setBold(True)
        self._f_strike = QFont(self._f_text)
        self._f_strike.setStrikeOut(True)
        self._f_badge = QFont()
        self._f_badge.setBold(True)
        self._f_badge.setPointSizeF(self._f_badge.pointSizeF() - 2.0)

    # — Text documents (cached per row/rev/width) —
    def _doc(self, row: int, field: str, text: str, width: int,
             font: QFont | None, html: bool, rev: int) -> QTextDocument:
        key = (row, field, width, rev)
        doc = self._docs.get(key)
        if doc is None:
            if len(self._docs) > 900:
                self._docs.clear()
            doc = QTextDocument()
            if font is not None:
                doc.setDefaultFont(font)
            # QTextDocument defaults to black text — unreadable on dark
            # cards. Pin the base color to the palette instead; explicit
            # spans in the HTML keep their own colors.
            doc.setDefaultStyleSheet(f"body {{ color: {_text_hex()}; }}")
            doc.setDocumentMargin(0)
            if html:
                doc.setHtml(text)
            else:
                doc.setPlainText(text)
            doc.setTextWidth(width)
            self._docs[key] = doc
        return doc

    def refresh_theme(self) -> None:
        """Drop cached documents and repaint after a dark/light switch.

        The HTML baked into each QTextDocument carries the old theme's
        colors, so the cache must go — not just a repaint.
        """
        self._docs.clear()
        self._view.viewport().update()

    def invalidate(self) -> None:
        """Forget cached per-row geometry (the rows themselves changed)."""
        self._docs.clear()
        self._geo.clear()
        self._hover = (-1, "")
        self._view.viewport().update()

    # — Geometry: single source of truth for paint + hit-testing —
    def _layout(self, row: int, item: dict, width: int) -> dict:
        # The view may query geometry before it has a real width (and tests
        # do too) — never lay out on a degenerate width.
        width = max(int(width or 0), 60)
        rev = item["_rev"]
        key = (row, width, item["state"], rev)
        lay = self._geo.get(key)
        if lay is not None:
            return lay
        if len(self._geo) > 600:
            self._geo.clear()

        cw = width - 2 * self.CDX - 2 * self.PAD - self.RAIL
        x0 = self.CDX + self.PAD + self.RAIL
        right = width - self.CDX - self.PAD
        y = self.CDY + self.PTOP
        fm = QFontMetrics(self._f_text)
        fm_name = QFontMetrics(self._f_name)
        fm_bold = QFontMetrics(self._f_bold)

        # ── Row 1 · name + repo pill, with the one row action top-right ────
        # No page for this source means no link — never a wrong one.
        link_txt = ("View package  ↗"
                    if _package_url(item["name"], item.get("repo", ""),
                                    item.get("url", "")) else "")
        link_w = fm.horizontalAdvance(link_txt) if link_txt else 0
        badge_txt = (item["repo"] or "").upper()
        badge_w = (QFontMetrics(self._f_badge).horizontalAdvance(badge_txt) + 14
                   if badge_txt else 0)
        # +14 slack: rendered text can exceed horizontalAdvance by a few px
        # (hinting/glyph fallback), so the pill must clear the name.
        name_avail = max(60, right - link_w - 20 - x0 - badge_w - 12)
        name_full_w = fm_name.horizontalAdvance(item["name"])
        name_w = min(name_full_w + 14, name_avail)
        name_txt = fm_name.elidedText(item["name"],
                                      Qt.TextElideMode.ElideRight, name_w)

        # ── Row 2 · version + release date + description, one metadata line ─
        old_txt, new_txt = item["old"], item["new"]
        arrow = "  →  "
        if item.get("auto"):
            # Nothing to show in the version slot: the metadata line below
            # carries the single sentence that explains the row. Drawing a
            # version here too would print the two on top of each other.
            ver_w = 0
            ver_old = ""
            ver_new = ""
        elif old_txt:
            ver_w = (fm.horizontalAdvance(old_txt)
                     + fm.horizontalAdvance(arrow)
                     + fm_bold.horizontalAdvance(new_txt))
            ver_old, ver_new = old_txt, new_txt
        else:
            ver_w = fm_bold.horizontalAdvance(new_txt)
            ver_old, ver_new = "", new_txt

        # The description rides along on the metadata line, so there is no
        # row of its own — `desc` stays a null rect for hit-testing parity.
        desc_txt = " ".join((item["desc"] or "").split())

        # ── Row 4 · what's new, with Show more on the right ────────────────
        full = (item["full"] or "").strip()
        notes = (item["notes"] or "").strip()
        has_more = bool(full) and full != notes
        shown = (notes[:_SNIPPET_LEN].rstrip() + "…"
                 if len(notes) > _SNIPPET_LEN else notes)
        more_txt = "Show more  ↓" if has_more else ""
        more_w = fm.horizontalAdvance(more_txt) if more_txt else 0
        prefix = "What's new: "
        prefix_w = fm.horizontalAdvance(prefix)
        single = " ".join(shown.split())
        notes_avail = max(40, cw - prefix_w - (more_w + 24 if more_txt else 0))
        elided = fm.elidedText(single, Qt.TextElideMode.ElideRight,
                               notes_avail)
        notes_html = (f"<span style='color:{_secondary_hex()}'><b>What's new: </b></span>"
                      + html.escape(elided))
        notes_doc = self._doc(row, "notes", notes_html, cw,
                              self._f_text, True, rev)
        h_name, h_line, h_notes = self._rows()

        # Every card is exactly this tall, whatever it contains: state is
        # shown inside the fixed rows (progress in the bottom padding, the
        # retry pill on the notes row) instead of adding rows. Uniform
        # heights are what keep a pixel-scrolled list from drifting.
        ver_top = y + h_name + self.GAP
        notes_top = ver_top + h_line + self.GAP_NOTES
        action_txt = ""
        if item["state"] == "failed":
            action_txt = "Retry"
        elif item["compromised"]:
            action_txt = "Install anyway"
        action_w = fm.horizontalAdvance(action_txt) + 24 if action_txt else 0

        lay = {
            "check": QRect(x0 - self.RAIL + 4, y + 1, 18, 18),
            # The rail doubles as the per-row status column: the checkbox
            # while idle, the state icon as soon as work starts.
            "state_icon": QRect(x0 - self.RAIL + 4, y + 1, 18, 18)
            if (item["state"] != "idle" or item["compromised"]) else QRect(),
            "name": QRect(x0, y, name_w, h_name),
            "badge": QRect(x0 + name_w + 8, y + 3, badge_w, 15),
            # Zero-width when there is no link: nothing to hover or hit.
            "link": (QRect(right - link_w - 4, y, link_w + 4, h_name)
                     if link_w else QRect()),
            "ver": QRect(x0, ver_top, cw, h_line),
            "ver_old": ver_old, "ver_new": ver_new, "ver_w": ver_w,
            "desc": QRect(),
            # The notes rect stops where its row action begins: it
            # describes exactly the space the text is elided into.
            "notes": QRect(x0, notes_top,
                           max(40, cw - (max(more_w, action_w) + 12
                                         if (more_txt or action_txt) else 0)),
                           h_notes),
            "more": (QRect(right - more_w - 4, notes_top, more_w + 4, h_notes)
                     if (more_txt and not action_txt) else QRect()),
            "action": (QRect(right - action_w, notes_top, action_w, h_notes)
                       if action_txt else QRect()),
            "action_txt": action_txt,
            # Thin progress line inside the bottom padding — no extra row.
            "progress": (QRect(x0, notes_top + h_notes + 3, cw, 3)
                         if item["state"] in ("installing", "done", "failed")
                         else QRect()),
            "card": QRect(self.CDX, self.CDY, width - 2 * self.CDX, 0),
        }

        total = (notes_top + h_notes + self.GAP_NOTES + 4 + self.PBOT
                 + self.CDY)
        lay["card"].setHeight(total - 2 * self.CDY)
        lay["height"] = total
        lay["notes_doc"] = notes_doc
        lay["desc_txt"] = desc_txt
        lay["name_txt"] = name_txt
        lay["more_txt"] = more_txt
        lay["link_txt"] = link_txt
        lay["badge_txt"] = badge_txt
        self._geo[key] = lay
        return lay

    def sizeHint(self, option, index) -> QSize:
        """One height for every row (see _layout): no per-row measurement,
        so the view never re-anchors and the list cannot drift."""
        try:
            item = index.model().item(index.row())
            w = (self._view.viewport().width() or option.rect.width() or 400)
            return QSize(w, self._layout(index.row(), item, w)["height"])
        except Exception:
            traceback.print_exc()
            return QSize(option.rect.width() or 400, 120)

    # — Painting — (guarded: an exception here must degrade one row, not
    # abort the process)
    def paint(self, painter: QPainter, option, index) -> None:
        try:
            self._paint_inner(painter, option, index)
        except Exception:
            if not self._paint_failed:
                self._paint_failed = True
                traceback.print_exc()

    def _paint_inner(self, painter: QPainter, option, index) -> None:
        model = index.model()
        item = model.item(index.row())
        w = option.rect.width()
        lay = self._layout(index.row(), item, w)
        p = painter
        p.save()
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        pal = option.palette
        card = QRect(lay["card"])
        card.translate(option.rect.topLeft())

        def move(r: QRect) -> QRect:
            return QRect(r).translated(option.rect.topLeft())

        # Card: one surface step off the list, with a derived hairline so
        # the edge stays visible on every color scheme.
        p.setPen(QPen(QColor(_border_hex()), 1))
        p.setBrush(QBrush(QColor(_surface_hex())))
        p.drawRoundedRect(card, 6, 6)

        # Left state accent
        accent = {"installing": _accent_hex(), "done": _positive_hex(),
                  "failed": _negative_hex()}.get(item["state"])
        if item["compromised"]:
            accent = _negative_hex()
        if accent:
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(QBrush(QColor(accent)))
            p.drawRoundedRect(
                QRect(card.left(), card.top() + 8, 3, card.height() - 16), 2, 2)

        # Rail: the checkbox while idle, the row's state icon once work
        # starts (or when the package is blocked).
        if item["state"] != "idle" or item["compromised"]:
            icon = {"installing": "info-circle", "done": "check-circle",
                    "failed": "error-circle"}.get(item["state"],
                                                  "warn-triangle")
            app_icon(icon, 18).paint(p, move(lay["state_icon"]))
        else:
            opt = QStyleOptionButton()
            opt.rect = move(lay["check"])
            opt.state = (QStyle.StateFlag.State_Enabled
                         | (QStyle.StateFlag.State_On if item["checked"]
                            else QStyle.StateFlag.State_Off))
            self.parent().style().drawPrimitive(
                QStyle.PrimitiveElement.PE_IndicatorCheckBox, opt, p, self._view)

        # Name + repo badge
        p.setPen(QPen(pal.color(pal.ColorRole.Text)))
        p.setFont(self._f_name)
        p.drawText(move(lay["name"]),
                   Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter,
                   lay["name_txt"])
        if lay["badge_txt"]:
            rgb, fg = _repo_tint(item["repo"])
            br = move(lay["badge"])
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(QBrush(QColor(*rgb, 41)))
            p.drawRoundedRect(br, 3, 3)
            p.setPen(QPen(QColor(fg)))
            p.setFont(self._f_badge)
            p.drawText(br, Qt.AlignmentFlag.AlignCenter, lay["badge_txt"])

        # Metadata line: old → new, then date · description, all muted.
        vr = move(lay["ver"])
        fm = QFontMetrics(self._f_text)
        x = vr.left()
        if lay["ver_old"]:
            p.setFont(self._f_strike)
            p.setPen(QPen(QColor(_secondary_hex())))
            p.drawText(vr, Qt.AlignmentFlag.AlignLeft
                       | Qt.AlignmentFlag.AlignVCenter, lay["ver_old"])
            x += fm.horizontalAdvance(lay["ver_old"])
            p.setFont(self._f_text)
            p.drawText(QRect(x, vr.top(), fm.horizontalAdvance("  →  "),
                             vr.height()),
                       Qt.AlignmentFlag.AlignLeft
                       | Qt.AlignmentFlag.AlignVCenter, "  →  ")
            x += fm.horizontalAdvance("  →  ")
        if lay["ver_new"]:
            p.setFont(self._f_bold)
            p.setPen(QPen(QColor(_positive_hex())))
            p.drawText(QRect(x, vr.top(), max(10, vr.right() - x),
                             vr.height()),
                       Qt.AlignmentFlag.AlignLeft
                       | Qt.AlignmentFlag.AlignVCenter, lay["ver_new"])
            x += QFontMetrics(self._f_bold).horizontalAdvance(lay["ver_new"])
        # The description follows the version after a small gap — but a row
        # with no version (an auto-added dependency) starts it flush left.
        gap = 12 if (lay["ver_old"] or lay["ver_new"]) else 0
        meta = " · ".join(p for p in (item["date"], lay["desc_txt"]) if p)
        if meta:
            p.setFont(self._f_text)
            p.setPen(QPen(QColor(_secondary_hex())))
            avail = max(0, vr.right() - x - gap)
            if avail > 40:
                p.drawText(QRect(x + gap, vr.top(), avail, vr.height()),
                           Qt.AlignmentFlag.AlignLeft
                           | Qt.AlignmentFlag.AlignVCenter,
                           fm.elidedText(meta, Qt.TextElideMode.ElideRight,
                                         avail))

        # What's new row (rich text: the label is bold + muted).
        nr = move(lay["notes"])
        p.save()
        p.translate(nr.topLeft())
        lay["notes_doc"].drawContents(p, QRectF(0, 0, nr.width(), nr.height()))
        p.restore()

        # Action links
        hover = self._hover if self._hover[0] == index.row() else (-1, "")
        p.setFont(self._f_text)
        if lay["more_txt"]:
            mr = move(lay["more"])
            f = p.font()
            f.setUnderline(hover[1] == "more")
            p.setFont(f)
            p.setPen(QPen(QColor(_link_hex())))
            p.drawText(mr, Qt.AlignmentFlag.AlignRight
                       | Qt.AlignmentFlag.AlignVCenter, lay["more_txt"])
        lr = move(lay["link"])
        f = self._f_text
        f.setUnderline(hover[1] == "link")
        p.setFont(f)
        p.setPen(QPen(QColor(_link_hex())))
        p.drawText(lr, Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter,
                   lay["link_txt"])
        # Underline is sticky on the painter: reset so the action pill
        # below never inherits a link hover underline.
        p.setFont(self._f_text)

        # Per-item progress
        if not lay["progress"].isNull():
            pr = move(lay["progress"])
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(QBrush(QColor(_border_hex())))
            p.drawRoundedRect(pr, 2, 2)
            color = {"installing": _accent_hex(), "done": _positive_hex(),
                     "failed": _negative_hex()}[item["state"]]
            p.setBrush(QBrush(QColor(color)))
            if item["state"] == "installing":
                frac = 0.35
                x = pr.left() + int(
                    (pr.width() * (1 - frac)) * (self._phase % 20) / 19)
                p.drawRoundedRect(QRect(x, pr.top(), int(pr.width() * frac),
                                        pr.height()), 2, 2)
            else:
                p.drawRoundedRect(pr, 2, 2)

        # Action pill (Retry / Install anyway)
        if not lay["action"].isNull():
            ar = move(lay["action"])
            danger = item["compromised"]
            col = _negative_hex() if danger else _accent_hex()
            if hover[1] == "action":
                p.setBrush(QBrush(QColor(col)))
                p.setPen(Qt.PenStyle.NoPen)
                p.drawRoundedRect(ar, 6, 6)
                p.setPen(QPen(QColor(_on_accent_hex())))
            else:
                p.setBrush(Qt.BrushStyle.NoBrush)
                p.setPen(QPen(QColor(col), 1.5))
                p.drawRoundedRect(ar, 6, 6)
                p.setPen(QPen(QColor(col)))
            p.drawText(ar, Qt.AlignmentFlag.AlignCenter, lay["action_txt"])

        p.restore()

    # — Interaction —
    def _hit(self, option, index) -> tuple[dict, object]:
        lay = self._layout(index.row(), index.model().item(index.row()),
                           option.rect.width())
        return lay, option.rect.topLeft()

    def editorEvent(self, event, model, option, index) -> bool:
        # Never let exceptions escape into Qt event dispatch (sip turns
        # them into a hard abort). Log and ignore instead.
        try:
            return self._editor_event_inner(event, model, option, index)
        except Exception:
            traceback.print_exc()
            return False

    def _editor_event_inner(self, event, model, option, index) -> bool:
        if event.type() == QEvent.Type.MouseMove:
            lay, origin = self._hit(option, index)
            pos = event.position().toPoint() - origin
            kind = ""
            for k in ("check", "link", "more", "action"):
                r = lay.get(k)
                if r is not None and not r.isNull() and r.contains(pos):
                    # The rail is only a checkbox while the row is idle;
                    # a blocked or running row shows status there instead.
                    if k == "check" and (model.item(index.row())["compromised"]
                                         or model.item(index.row())["state"]
                                         != "idle"):
                        continue
                    kind = k
                    break
            if (index.row(), kind) != self._hover:
                old_row = self._hover[0]
                self._hover = (index.row(), kind)
                # NOTE: QListView.update() takes a QModelIndex, not a QRect
                # (it shadows QWidget.update) — repaint via the viewport.
                vp = self._view.viewport()
                if old_row >= 0:
                    vp.update(self._view.visualRect(model.index(old_row)))
                vp.update(option.rect)
                vp.setCursor(
                    Qt.CursorShape.PointingHandCursor if kind
                    else Qt.CursorShape.ArrowCursor)
            return False
        if (event.type() == QEvent.Type.MouseButtonRelease
                and event.button() == Qt.MouseButton.LeftButton):
            lay, origin = self._hit(option, index)
            pos = event.position().toPoint() - origin
            item = model.item(index.row())
            if (lay["check"].contains(pos) and not item["compromised"]
                    and item["state"] == "idle"):
                self.toggled.emit(index.row())
                return True
            if not lay["link"].isNull() and lay["link"].contains(pos):
                self.link_activated.emit(
                    _package_url(item["name"], item["repo"],
                                 item.get("url", "")))
                return True
            if not lay["more"].isNull() and lay["more"].contains(pos):
                self.more_requested.emit(index.row())
                return True
            if not lay["action"].isNull() and lay["action"].contains(pos):
                self.action_requested.emit(item["name"])
                return True
        return False

    def tick(self, model: PackageModel) -> None:
        """Advance the indeterminate animation; repaint installing rows only."""
        self._phase += 1
        for r, it in enumerate(model._items):
            if it["state"] == "installing":
                idx = model.index(r)
                model.dataChanged.emit(idx, idx, [])


# ── Tracked packages list (virtualized) ──────────────────────────────────
#
# All explicitly installed packages with their source repo. AUR rows that
# also exist in the official repos get an inline Switch pill (same
# one-at-a-time semantics as MovesDialog — pacman has a single lock).

class TrackedModel(_FilterableModel, QAbstractListModel):
    """One dict per explicitly installed package."""

    def __init__(self, own_source: str = "") -> None:
        super().__init__()
        self._items: list[dict] = []
        # A list that is itself one source (the dependency packages in the
        # Untracked tab) answers to that source, not to each row's repo.
        self._own_source = own_source
        self._init_filter()

    def _item_source(self, item: dict) -> str:
        if self._own_source:
            return self._own_source
        return _source_key(item.get("repo", ""))

    def set_packages(self, installed: list[dict],
                     moves: list[dict]) -> None:
        by_name = {m["name"]: m for m in moves}
        items = []
        for pkg in installed:
            m = by_name.get(pkg["name"])
            items.append({
                "name": pkg["name"], "version": pkg.get("version", ""),
                "repo": pkg.get("repo", ""),
                # Rows that arrive knowing their own title (Flatpak apps,
                # AppImages) keep it; the enricher fills the rest in later.
                "title": pkg.get("title", ""),
                # AppImage rows: the file to delete on Uninstall.
                "path": pkg.get("path", ""),
                # The app's own page (AppImages, manual installs).
                "url": pkg.get("url", ""),
                "target": m["target"] if m else "",
                "source": m["source"] if m else "",
                "relation": m["relation"] if m else "",
                "state": "idle",
                "failed_op": "",
                # GUI launcher (.desktop path): None = not resolved yet,
                # "" = no launcher, path = Open pill shown.
                "desktop": pkg.get("desktop") or None,
                # Package description (Updates-style row): "" until resolved.
                "desc": pkg.get("desc", ""),
                # Checkbox multi-select for batch uninstall (default off:
                # removal is destructive, so selection is explicit).
                "checked": False,
            })
        # Movable packages float to the top, then by the name on screen.
        items.sort(key=lambda it: (not it["target"],
                                   (it["title"] or it["name"]).lower()))
        self.beginResetModel()
        self._items = items
        self._reapply_filter()
        self.endResetModel()

    def set_items(self, items: list[dict]) -> None:
        """Replace rows verbatim (pre-sorted, fully populated dicts).

        Used by the Untracked tab, which builds rows from desktop files
        and dependency queries instead of explicit packages + moves.
        """
        self.beginResetModel()
        self._items = items
        self._reapply_filter()
        self.endResetModel()

    def _reapply_filter(self) -> None:
        self._visible = [i for i, it in enumerate(self._items)
                         if self._matches(it)]

    def rowCount(self, parent: QModelIndex | None = None) -> int:
        return (0 if parent is not None and parent.isValid()
                else len(self._visible))

    def item(self, row: int) -> dict:
        return self._items[self._src(row)]

    def data(self, index: QModelIndex, role: int = Qt.ItemDataRole.DisplayRole):
        if not index.isValid():
            return None
        item = self.item(index.row())
        if role == Qt.ItemDataRole.DisplayRole:
            return item["name"]
        if role == Qt.ItemDataRole.CheckStateRole:
            return (Qt.CheckState.Checked if item["checked"]
                    else Qt.CheckState.Unchecked)
        return None

    def flags(self, index: QModelIndex) -> Qt.ItemFlag:
        f = super().flags(index) | Qt.ItemFlag.ItemIsEnabled
        if index.isValid():
            f |= Qt.ItemFlag.ItemIsUserCheckable
        return f

    def setData(self, index: QModelIndex, value, role: int = Qt.ItemDataRole.EditRole) -> bool:
        if role == Qt.ItemDataRole.CheckStateRole and index.isValid():
            self.item(index.row())["checked"] = (
                value == Qt.CheckState.Checked)
            self.dataChanged.emit(index, index, [])
            return True
        return False

    def checked_names(self) -> list[str]:
        return [it["name"] for it in self.visible_items() if it["checked"]]

    def set_all(self, checked: bool) -> None:
        """Tick/untick everything the current filter is showing."""
        for it in self.visible_items():
            it["checked"] = checked
        if self._visible:
            self.dataChanged.emit(self.index(0),
                                  self.index(len(self._visible) - 1), [])

    def set_state(self, name: str, state: str, op: str | None = None) -> None:
        for row, src in enumerate(self._visible):
            it = self._items[src]
            if it["name"] != name:
                continue
            it["state"] = state
            if op is not None:
                it["failed_op"] = op
            elif state != "failed":
                it["failed_op"] = ""
            idx = self.index(row)
            self.dataChanged.emit(idx, idx, [])
            return

    def set_desktop(self, name: str, path: str) -> None:
        r = self.row_of(name)
        if r is None:
            return
        it = self._items[self._src(r)]
        if it["desktop"] != path:
            it["desktop"] = path
            idx = self.index(r)
            self.dataChanged.emit(idx, idx, [])

    def set_desc(self, name: str, desc: str) -> None:
        r = self.row_of(name)
        if r is None:
            return
        it = self._items[self._src(r)]
        if it["desc"] != desc:
            it["desc"] = desc
            idx = self.index(r)
            self.dataChanged.emit(idx, idx, [])

    def remove_row(self, name: str) -> None:
        r = self.row_of(name)
        if r is None:
            return
        self.beginRemoveRows(QModelIndex(), r, r)
        src = self._visible.pop(r)
        del self._items[src]
        # Source indices above the removed one shift down by one.
        self._visible = [i - 1 if i > src else i for i in self._visible]
        self.endRemoveRows()

    def movable_names(self) -> list[str]:
        """Movable packages in the current view (drives Select all)."""
        return [it["name"] for it in self.visible_items() if it["target"]]


class TrackedDelegate(QStyledItemDelegate):
    """Same card design as the Updates list: checkbox rail, name + repo
    pill, View package link top-right, version line, description, status
    hint + Open + Uninstall + Switch pills along the bottom."""

    switch_requested = pyqtSignal(str)
    uninstall_requested = pyqtSignal(str)
    open_requested = pyqtSignal(str)
    link_activated = pyqtSignal(str)    # external URL clicked
    toggled = pyqtSignal(int)           # checkbox flipped

    CDX = 8         # card inset inside the row (horizontal, 2u)
    PAD = 16        # card inner padding (horizontal, 4u)
    PTOP = 10       # card inner padding top
    PBOT = 10       # card inner padding bottom
    CDY = 4         # card inset inside the row (vertical → 8px row gap)
    RAIL = 28       # checkbox column (same as the Updates list)

    H_NAME = 20
    H_LINE = 16
    GAP = 2
    H_PILL = 24

    def _rows(self) -> tuple[int, int, int]:
        return (_sp(self.H_NAME), _sp(self.H_LINE), _sp(self.H_PILL))

    def __init__(self, view: QListView) -> None:
        super().__init__(view)
        self._view = view
        self._hover: tuple[int, str] = (-1, "")
        self._f_name = QFont()
        self._f_name.setBold(True)
        self._f_text = QFont()
        self._f_text.setPointSizeF(self._f_text.pointSizeF() - 1.0)
        self._f_badge = QFont()
        self._f_badge.setBold(True)
        self._f_badge.setPointSizeF(self._f_badge.pointSizeF() - 2.0)
        # Bold twin of the text font for the official-version half of
        # the version line (mirrors the Updates list's green new-version).
        self._f_bold = QFont(self._f_text)
        self._f_bold.setBold(True)

    def _geom(self, row: int, item: dict, width: int) -> dict:
        # Same card as the Updates list: rail, name row with the one row
        # action top-right, one muted metadata line (version · description),
        # then the hint and pills sharing the bottom row.
        width = max(int(width or 0), 60)
        fm = QFontMetrics(self._f_text)
        fm_name = QFontMetrics(self._f_name)
        fm_bold = QFontMetrics(self._f_bold)
        x0 = self.CDX + self.PAD + self.RAIL
        right = width - self.CDX - self.PAD
        cw = right - x0
        y = self.CDY + self.PTOP
        link_txt = ("View package  ↗"
                    if _package_url(item["name"], item.get("repo", ""),
                                    item.get("url", "")) else "")
        link_w = fm.horizontalAdvance(link_txt) if link_txt else 0
        # Display title: usually the package name; Untracked app rows
        # show the human-readable application name instead.
        title = item.get("title") or item["name"]
        badge_txt = (item["repo"] or "").upper()
        badge_w = (QFontMetrics(self._f_badge).horizontalAdvance(badge_txt) + 14
                   if badge_txt else 0)
        name_avail = max(60, right - link_w - 20 - x0 - badge_w - 12)
        name_w = min(fm_name.horizontalAdvance(title) + 14, name_avail)
        title_txt = fm_name.elidedText(title, Qt.TextElideMode.ElideRight,
                                       name_w)
        # Metadata line: installed version, or "installed → cachyos" when
        # a managed repo carries it (mirrors the Updates old → new line),
        # followed by the description when there is room for it. The repo
        # is named, because "some other source has this" is the whole
        # point of switching off the AUR.
        target = item["target"] or ""
        source = item["source"] or ""
        # Untracked app rows show the human application name as their
        # title — the *package* name (what Uninstall removes) must stay
        # visible, so it rides on the version line.
        pkg_txt = ""
        if (item.get("title") or "").strip() and item["title"] != item["name"]:
            pkg_txt = item["name"] if not item["version"] \
                else f" · {item['name']}"
        if target:
            ver_left = f"{item['version']} → " if item["version"] else ""
            ver_left_w = fm.horizontalAdvance(ver_left)
            ver_right = fm_bold.elidedText(
                f"{_repo_label(source)} {target}", Qt.TextElideMode.ElideRight,
                max(20, cw - ver_left_w))
        else:
            ver_left = fm.elidedText(item["version"],
                                     Qt.TextElideMode.ElideRight,
                                     max(20, cw
                                         - fm.horizontalAdvance(pkg_txt)))
            ver_left += pkg_txt
            ver_left_w = 0
            ver_right = ""
        h_name, h_line, h_pill = self._rows()
        ver_top = y + h_name + self.GAP
        desc_avail = max(0, cw - ver_left_w
                         - (fm_bold.horizontalAdvance(ver_right) if target
                            else fm.horizontalAdvance(ver_left)))
        desc_txt = (fm.elidedText(item.get("desc") or "",
                                  Qt.TextElideMode.ElideRight, desc_avail)
                    if desc_avail > 60 else "")
        # The description row is always reserved (even when empty) so every
        # card is the same height — a pixel-scrolled list of uniform rows
        # can never drift under the cursor.
        desc_top = ver_top + h_line + self.GAP
        bottom_top = desc_top + h_line + self.GAP
        # Pills sit on the bottom baseline, right-aligned (Switch
        # rightmost, then Uninstall, then Open) — like the Updates
        # action pill below its notes line.
        switch_failed = (item["state"] == "failed"
                         and item.get("failed_op", "switch") == "switch")
        pills_w = 0
        if target:
            if item["state"] == "switching":
                txt = "Switching…"
            elif item["state"] == "done":
                txt = "Switched ✓"
            elif switch_failed:
                txt = "Retry"
            else:
                txt = "Switch"
            aw = fm.horizontalAdvance(txt) + 22
            action = QRect(right - aw, bottom_top, aw, h_pill)
            pills_w += aw + 8
        else:
            action, txt = QRect(), ""
        # Uninstall pill: always present, left of Switch when both show.
        if item["state"] == "uninstalling":
            uni_txt = "Removing…"
        elif (item["state"] == "failed"
                and item.get("failed_op") == "uninstall"):
            uni_txt = "Retry"
        else:
            uni_txt = "Uninstall"
        uw = fm.horizontalAdvance(uni_txt) + 22
        action2 = QRect(right - pills_w - uw, bottom_top, uw, h_pill)
        pills_w += uw + 8
        # Open pill: leftmost, only for packages with a GUI launcher.
        if item.get("desktop"):
            ow = fm.horizontalAdvance("Open") + 22
            open_rect = QRect(right - pills_w - ow, bottom_top, ow, h_pill)
            pills_w += ow + 8
        else:
            open_rect = QRect()
        ycur = bottom_top + h_pill
        # Row = card + CDY on both sides, so cards keep an 8px gap and
        # the card itself always has PBOT below its last element.
        total = ycur + self.PBOT + self.CDY
        # Bottom-line hint: what switching would buy you. The source is
        # named and the two kinds read differently — an official build is
        # Arch's own, a managed source is somebody else's build farm, which
        # is still a signed, prebuilt package rather than a PKGBUILD run
        # here. Only an actionable hint earns a line: the AUR badge already
        # says "AUR", so "not in the official repos" was just noise.
        if target:
            label = _repo_label(source)
            if _repo_kind(source) == "official":
                hint_txt = (f"{label.capitalize()} {target} available"
                            " — switch for signed builds")
            else:
                hint_txt = (f"{label} {target} available — switch for a"
                            " prebuilt, signed package")
            hint_col = _positive_hex()
        else:
            hint_txt = ""
            hint_col = _secondary_hex()
        return {
            "check": QRect(x0 - self.RAIL + 4, y + 1, 18, 18),
            "name": QRect(x0, y, name_w, h_name),
            "title": title,
            "title_txt": title_txt,
            "badge": QRect(x0 + name_w + 8, y + 3, badge_w, 15),
            # Zero-width when there is no link: nothing to hover or hit.
            "link": (QRect(right - link_w - 4, y, link_w + 4, h_name)
                     if link_w else QRect()),
            "link_txt": link_txt,
            "ver": QRect(x0, ver_top, cw, h_line),
            "ver_left": ver_left,
            "ver_left_w": ver_left_w,
            "ver_right": ver_right,
            "desc": QRect(x0, desc_top, cw, h_line),
            "desc_txt": desc_txt,
            "hint": QRect(x0, bottom_top + 4,
                          max(10, cw - pills_w - 12), h_line),
            "hint_txt": hint_txt,
            "hint_col": hint_col,
            "action": action,
            "action_txt": txt,
            "action2": action2,
            "action2_txt": uni_txt,
            "open": open_rect,
            "open_txt": "Open" if not open_rect.isNull() else "",
            "card": QRect(self.CDX, self.CDY, width - 2 * self.CDX,
                          total - 2 * self.CDY),
            "height": total,
            "badge_txt": badge_txt,
        }

    def sizeHint(self, option, index) -> QSize:
        """One height for every row (see _geom) — see PackageDelegate."""
        try:
            item = index.model().item(index.row())
            w = (self._view.viewport().width() or option.rect.width() or 400)
            return QSize(int(w), self._geom(index.row(), item, int(w))["height"])
        except Exception:
            traceback.print_exc()
            return QSize(option.rect.width() or 400, 100)

    def refresh_theme(self) -> None:
        """Repaint after a dark/light switch.

        Everything here resolves theme colors live per paint call, so a
        repaint is all it takes (unlike PackageDelegate's doc cache).
        """
        self._view.viewport().update()

    def invalidate(self) -> None:
        """Forget cached per-row geometry (the rows themselves changed).

        This delegate lays rows out per paint (nothing cached), so the
        hover hit-test state is all there is to drop.
        """
        self._hover = (-1, "")
        self._view.viewport().update()

    def paint(self, painter: QPainter, option, index) -> None:
        try:
            self._paint_inner(painter, option, index)
        except Exception:
            traceback.print_exc()

    def _paint_inner(self, painter: QPainter, option, index) -> None:
        item = index.model().item(index.row())
        lay = self._geom(index.row(), item, option.rect.width())
        p = painter
        p.save()
        p.setRenderHint(QPainter.RenderHint.Antialiasing)
        pal = option.palette
        card = QRect(lay["card"])
        card.translate(option.rect.topLeft())

        def move(r: QRect) -> QRect:
            return QRect(r).translated(option.rect.topLeft())

        p.setPen(QPen(QColor(_border_hex()), 1))
        p.setBrush(QBrush(QColor(_surface_hex())))
        p.drawRoundedRect(card, 6, 6)
        accent = {"switching": _accent_hex(), "uninstalling": _accent_hex(),
                  "done": _positive_hex(),
                  "failed": _negative_hex()}.get(item["state"])
        if accent:
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(QBrush(QColor(accent)))
            p.drawRoundedRect(
                QRect(card.left(), card.top() + 8, 3, card.height() - 16), 2, 2)

        p.setPen(QPen(pal.color(pal.ColorRole.Text)))
        p.setFont(self._f_name)
        # Checkbox rail (multi-select for batch uninstall).
        _copt = QStyleOptionButton()
        _copt.rect = move(lay["check"])
        _copt.state = (QStyle.StateFlag.State_Enabled
                       | (QStyle.StateFlag.State_On if item["checked"]
                          else QStyle.StateFlag.State_Off))
        self.parent().style().drawPrimitive(
            QStyle.PrimitiveElement.PE_IndicatorCheckBox, _copt, p, self._view)
        p.drawText(move(lay["name"]),
                   Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter,
                   lay["title_txt"])
        if lay["badge_txt"]:
            rgb, fg = _repo_tint(item["repo"])
            br = move(lay["badge"])
            p.setPen(Qt.PenStyle.NoPen)
            p.setBrush(QBrush(QColor(*rgb, 41)))
            p.drawRoundedRect(br, 3, 3)
            p.setPen(QPen(QColor(fg)))
            p.setFont(self._f_badge)
            p.drawText(br, Qt.AlignmentFlag.AlignCenter, lay["badge_txt"])
        # View package link, top right — the same corner the Updates
        # list uses. Painted in the measured text font (whatever the
        # previous row painted would overflow the rect).
        hover = self._hover if self._hover[0] == index.row() else (-1, "")
        p.setFont(self._f_text)
        p.setPen(QPen(QColor(_link_hex())))
        f = p.font()
        f.setUnderline(hover[1] == "link")
        p.setFont(f)
        p.drawText(move(lay["link"]),
                   Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter,
                   lay["link_txt"])
        p.setFont(self._f_text)
        # Version line: installed version, or installed → <repo> when a
        # managed repo carries it (mirrors Updates' old → new line).
        p.setPen(QPen(QColor(_secondary_hex())))
        vr = move(lay["ver"])
        if lay["ver_right"]:
            p.drawText(vr,
                       Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter,
                       lay["ver_left"])
            p.setFont(self._f_bold)
            p.setPen(QPen(QColor(_positive_hex())))
            p.drawText(QRect(vr.left() + lay["ver_left_w"], vr.top(),
                             max(10, vr.width() - lay["ver_left_w"]),
                             vr.height()),
                       Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter,
                       lay["ver_right"])
            p.setFont(self._f_text)
        else:
            p.drawText(vr,
                       Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter,
                       lay["ver_left"])
        # Description line, muted, right of the version — the pills live
        # on the bottom row now, not mid-card.
        if lay["desc_txt"]:
            p.setPen(QPen(QColor(_secondary_hex())))
            p.drawText(move(lay["desc"]),
                       Qt.AlignmentFlag.AlignLeft
                       | Qt.AlignmentFlag.AlignVCenter, lay["desc_txt"])
        # Bottom line: status hint left, pills right.
        p.setFont(self._f_text)
        if lay["hint_txt"]:
            p.setPen(QPen(QColor(lay["hint_col"])))
            p.drawText(move(lay["hint"]),
                       Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter,
                       fm_elided(self._f_text, lay["hint_txt"],
                                 lay["hint"].width()))
        # The link underline flag above is sticky on the painter: the
        # font was already reset, so pills never inherit it.
        p.setFont(self._f_text)

        if not lay["action"].isNull():
            ar = move(lay["action"])
            hover = self._hover if self._hover[0] == index.row() else (-1, "")
            danger = item["state"] == "failed" and item.get(
                "failed_op", "switch") == "switch"
            col = _negative_hex() if danger else _accent_hex()
            if hover[1] == "action" or item["state"] in ("switching", "done"):
                p.setBrush(QBrush(QColor(col)))
                p.setPen(Qt.PenStyle.NoPen)
                p.drawRoundedRect(ar, 6, 6)
                p.setPen(QPen(QColor(_on_accent_hex())))
            else:
                p.setBrush(Qt.BrushStyle.NoBrush)
                p.setPen(QPen(QColor(col), 1.5))
                p.drawRoundedRect(ar, 6, 6)
                p.setPen(QPen(QColor(col)))
            p.drawText(ar, Qt.AlignmentFlag.AlignCenter, lay["action_txt"])
        if not lay["action2"].isNull():
            ur = move(lay["action2"])
            hover = self._hover if self._hover[0] == index.row() else (-1, "")
            udanger = (item["state"] == "failed"
                       and item.get("failed_op") == "uninstall")
            ucol = _negative_hex() if udanger else _secondary_hex()
            if hover[1] == "action2" or item["state"] == "uninstalling":
                p.setBrush(QBrush(QColor(ucol)))
                p.setPen(Qt.PenStyle.NoPen)
                p.drawRoundedRect(ur, 6, 6)
                p.setPen(QPen(QColor(_on_accent_hex())))
            else:
                p.setBrush(Qt.BrushStyle.NoBrush)
                p.setPen(QPen(QColor(ucol), 1.5))
                p.drawRoundedRect(ur, 6, 6)
                p.setPen(QPen(QColor(ucol)))
            p.drawText(ur, Qt.AlignmentFlag.AlignCenter, lay["action2_txt"])
        if not lay["open"].isNull():
            opr = move(lay["open"])
            hover = self._hover if self._hover[0] == index.row() else (-1, "")
            if hover[1] == "open":
                p.setBrush(QBrush(QColor(_secondary_hex())))
                p.setPen(Qt.PenStyle.NoPen)
                p.drawRoundedRect(opr, 6, 6)
                p.setPen(QPen(QColor(_surface_hex())))
            else:
                p.setBrush(Qt.BrushStyle.NoBrush)
                p.setPen(QPen(QColor(_secondary_hex()), 1.5))
                p.drawRoundedRect(opr, 6, 6)
                p.setPen(QPen(QColor(_secondary_hex())))
            p.drawText(opr, Qt.AlignmentFlag.AlignCenter, lay["open_txt"])
        p.restore()

    def editorEvent(self, event, model, option, index) -> bool:
        try:
            return self._editor_event_inner(event, model, option, index)
        except Exception:
            traceback.print_exc()
            return False

    def _editor_event_inner(self, event, model, option, index) -> bool:
        if event.type() == QEvent.Type.MouseMove:
            lay = self._geom(index.row(), model.item(index.row()),
                             option.rect.width())
            pos = event.position().toPoint() - option.rect.topLeft()
            kind = ""
            for k in ("check", "action", "action2", "open", "link"):
                if not lay[k].isNull() and lay[k].contains(pos):
                    kind = k
                    break
            if (index.row(), kind) != self._hover:
                old_row = self._hover[0]
                self._hover = (index.row(), kind)
                vp = self._view.viewport()
                if old_row >= 0:
                    vp.update(self._view.visualRect(model.index(old_row)))
                vp.update(option.rect)
                vp.setCursor(Qt.CursorShape.PointingHandCursor if kind
                             else Qt.CursorShape.ArrowCursor)
            return False
        if (event.type() == QEvent.Type.MouseButtonRelease
                and event.button() == Qt.MouseButton.LeftButton):
            lay = self._geom(index.row(), model.item(index.row()),
                             option.rect.width())
            pos = event.position().toPoint() - option.rect.topLeft()
            if lay["check"].contains(pos):
                self.toggled.emit(index.row())
                return True
            if not lay["action"].isNull() and lay["action"].contains(pos):
                self.switch_requested.emit(model.item(index.row())["name"])
                return True
            if not lay["action2"].isNull() and lay["action2"].contains(pos):
                self.uninstall_requested.emit(model.item(index.row())["name"])
                return True
            if not lay["open"].isNull() and lay["open"].contains(pos):
                self.open_requested.emit(model.item(index.row())["name"])
                return True
            if not lay["link"].isNull() and lay["link"].contains(pos):
                it = model.item(index.row())
                self.link_activated.emit(
                    _package_url(it["name"], it["repo"], it.get("url", "")))
                return True
        return False


def fm_elided(font: QFont, text: str, width: int) -> str:
    """Elide `text` to fit `width` pixels (single line)."""
    return QFontMetrics(font).elidedText(text, Qt.TextElideMode.ElideRight,
                                         max(20, width))


class NotesPopover(QDialog):
    """'Show more' popover: full release notes + source + actions."""

    def __init__(self, parent: QWidget, item: dict) -> None:
        super().__init__(parent, Qt.WindowType.Popup)
        self.setWindowTitle(f"{item['name']} — what's new")
        self.setMinimumSize(560, 420)
        self.setStyleSheet(_themed_qss())
        lay = QVBoxLayout(self)
        lay.setContentsMargins(20, 16, 20, 16)
        lay.setSpacing(10)

        eyebrow = QLabel("WHAT'S NEW · FULL DETAILS")
        eyebrow.setObjectName("eyebrow")
        lay.addWidget(eyebrow)
        title = QLabel(
            f"{item['name']} &nbsp;<span style='color:{_secondary_hex()}'>"
            f"{item['old']} → <b style='color:{_positive_hex()}'>{item['new']}</b>"
            "</span>")
        title.setObjectName("title")
        title.setStyleSheet(f"font-size: {_sp(17)}px;")
        lay.addWidget(title)

        if item.get("source"):
            src_html = (f"<span style='color:{_secondary_hex()}'>"
                        f"Source: {html.escape(item['source'])}</span>")
            if item.get("source_url"):
                src_html += (f" &nbsp;·&nbsp; <a href='{item['source_url']}'"
                             f" style='text-decoration:none;"
                             f" color:{_link_hex()}'>open source ↗</a>")
            src = QLabel(src_html)
            src.setObjectName("package-link")
            src.setOpenExternalLinks(True)
            lay.addWidget(src)

        browser = QTextBrowser()
        browser.setObjectName("details")
        browser.setPlainText((item.get("full") or item.get("notes") or "").strip())
        browser.setFont(QFont("monospace"))
        lay.addWidget(browser, 1)

        row = QHBoxLayout()
        row.setSpacing(8)
        pkg_url = _package_url(item["name"], item["repo"], item.get("url", ""))
        if pkg_url:
            pkg_link = QLabel(
                f"<a style='text-decoration:none; color:{_link_hex()}' "
                f"href='{pkg_url}'>Open package page ↗</a>")
            pkg_link.setStyleSheet(f"color: {_secondary_hex()};")
            pkg_link.setObjectName("package-link")
            pkg_link.setOpenExternalLinks(True)
            row.addWidget(pkg_link)
        row.addStretch()
        copy_btn = QPushButton("Copy")
        copy_btn.setObjectName("secondary-small")
        copy_btn.setFixedHeight(_sp(30))
        copy_btn.setIcon(app_icon("copy", 14))
        copy_btn.clicked.connect(
            lambda: QApplication.clipboard().setText(browser.toPlainText()))
        row.addWidget(copy_btn)
        close_btn = QPushButton("Close")
        close_btn.setObjectName("primary")
        close_btn.setFixedHeight(_sp(30))
        close_btn.clicked.connect(self.close)
        row.addWidget(close_btn)
        lay.addLayout(row)

        # Position near the cursor, clamped on-screen.
        pos = QCursor.pos()
        geo = QApplication.primaryScreen().availableGeometry()
        self.adjustSize()
        x = min(max(pos.x() - 280, geo.left()), geo.right() - self.width())
        y = min(max(pos.y() - 100, geo.top()), geo.bottom() - self.height())
        self.move(x, y)


class UpdateWindow(QMainWindow):
    closed           = pyqtSignal()
    update_succeeded = pyqtSignal()

    def __init__(
        self,
        updates:     list[dict],
        cached_info: dict[int, tuple],
        aur_helper:  str | None,
    ) -> None:
        super().__init__()
        self._updates    = updates
        self._aur_helper = aur_helper
        self._runner:    UpdateRunner | None = None
        self._single:    UpdateRunner | None = None
        self._single_name: str | None = None
        self._single_overwrite: str | None = None
        self._remover:   ObsoleteRemover | None = None
        self._obsolete_ctx = "updates"  # or "obsolete" (view-owned removal)
        self._safe_names: list[str] = []
        self._last_run_names: list[str] = []
        self._done_names: set[str] = set()  # own honest completion tracking
        self._live_conflicts: dict[str, list[str]] = {}
        self._seen_building: set[str] = set()
        self._updating   = False
        self._retry_mode = False
        self._overwrite:  str | None = None
        self._current_view = "updates"  # active tab (re-click = Check Now)
        self._rechecker:  UpdateChecker | None = None
        self._recheck_fetcher: InfoFetcher | None = None
        # Feed generation: tray info feeds arriving after an in-window
        # recheck describe the OLD list — ignore them (see on_info_ready).
        self._info_gen = 0
        self._last_error: str = ""
        self._installing_row: int | None = None
        self._popover: NotesPopover | None = None
        self._orphans: set = set()  # parked threads (see _park_thread)
        self._moves_dialog: MovesDialog | None = None
        self._sources_dialog: ManagedSourcesDialog | None = None
        # Buttons whose icons bake the theme's grey: re-resolved live in
        # _apply_theme(). Registered via _icon_btn(), keyed by button so a
        # repeat registration never accumulates duplicates.
        self._theme_icons: dict = {}
        # The primary is always the update action; it is disabled rather
        # than morphing into something else (see AGENTS.md).
        # Last theme _apply_theme() rendered (None = never). Guards both
        # redundant work and StyleChange re-entrancy from setStyleSheet.
        self._theme_dark: bool | None = None
        qapp = QApplication.instance()
        if qapp is not None:
            # Bound method: Qt auto-disconnects when the window is destroyed.
            qapp.paletteChanged.connect(self._on_app_palette_changed)
        self._fail_notif_id = 0  # single updating failure notification
        # Repeat-failure guard: same signature failing over and over means
        # the auto-fix isn't working — stop nagging, show the manual fix.
        self._fail_sig: tuple | None = None
        self._fail_streak = 0
        self._offer_open = False
        # Watchdog: silence from the installer means it may be stuck.
        self._last_activity = 0.0
        self._stuck_warned = False
        self._watchdog = QTimer(self)
        self._watchdog.setInterval(5000)
        self._watchdog.timeout.connect(self._watchdog_tick)
        self._compromised = any(pkg.get("compromised") for pkg in updates)
        # When the list was last confirmed: the empty state says so.
        self._checked_at = 0.0
        # True while _sub carries a live message rather than the resting
        # summary (see _set_status / _refresh_empty_state).
        self._status_active = False
        # Single-flight guard for the failure dialog (see _show_error_dialog).
        self._error_dialog_open = False
        # Set when a change (e.g. enabling a source) needs a restart to
        # take effect; drives the "Restart to apply" button.
        self._restart_needed = False
        # The full status sentence, whatever the one-line label shows.
        self._status_full = ""
        # Per-list "working" flags: a loading placeholder must never cover
        # rows that are still on screen.
        self._loading = False
        self._track_loading = False
        self._un_loading = False
        n = len(updates)

        self.setWindowTitle(f"Arch Update — {n} package{'s' if n != 1 else ''} available")
        self.setMinimumSize(_sp(1040), _sp(620))
        # Record the theme before the first stylesheet call: setStyleSheet
        # fires a StyleChange that would otherwise run _apply_theme() on a
        # half-built window.
        self._theme_dark = _is_dark_theme()
        self.setStyleSheet(_themed_qss())
        self._apply_default_geometry()

        root = QWidget()
        root.setObjectName("root")
        self.setCentralWidget(root)
        lay = QVBoxLayout(root)
        lay.setContentsMargins(_sp(24), _sp(24), _sp(24), _sp(24))
        lay.setSpacing(_sp(16))

        # ── Zone 1 · Header: identity left, view switcher right ─────────────
        head = QHBoxLayout()
        head.setSpacing(_sp(16))
        icon_lbl = QLabel()
        self._icon_lbl = icon_lbl
        icon_lbl.setPixmap(_app_icon().pixmap(_sp(36), _sp(36)))
        icon_lbl.setFixedSize(_sp(36), _sp(36))
        head.addWidget(icon_lbl, 0, Qt.AlignmentFlag.AlignTop)

        title_block = QVBoxLayout()
        title_block.setSpacing(_sp(4))
        self._title = QLabel("Arch Update")
        self._title.setObjectName("title")
        title_block.addWidget(self._title)
        self._sub = QLabel()
        self._sub.setObjectName("subtitle")
        # One line, always the same height: a message that wraps would push
        # the whole window down (see AGENTS.md). Long messages are elided
        # and the full text goes in the tooltip.
        self._sub.setWordWrap(False)
        self._sub.setFixedHeight(_sp(18))
        self._sub.setSizePolicy(
            QSizePolicy.Policy.Expanding, QSizePolicy.Policy.Fixed)
        self._sub.setTextInteractionFlags(
            Qt.TextInteractionFlag.TextSelectableByMouse
        )
        title_block.addWidget(self._sub)
        # THE unified status line: every user-facing message in this
        # window renders here (see _set_status). _idle_summary holds the
        # resting text that empty messages restore.
        self._idle_summary = ""
        # Stretch factor 1 (and no dead spacer): the block claims all
        # free header width so the status line only wraps when it must.
        head.addLayout(title_block, 1)

        # View switcher lives here, right of the title: Updates | Tracked |
        # Untracked | Obsolete | Security. Borderless segments that only
        # fill with the accent when active, so the group reads as one
        # control rather than five loose pills.
        self._view_buttons: dict[str, QPushButton] = {}
        self._view_group = QButtonGroup(self)
        self._view_group.setExclusive(True)
        for _key, _label in (("updates", "Updates"), ("tracked", "Tracked"),
                             ("untracked", "Untracked"),
                             ("obsolete", "Obsolete"),
                             ("security", "Security")):
            _btn = QPushButton(_label)
            _btn.setObjectName("view-tab")
            _btn.setCheckable(True)
            _btn.setFixedHeight(_sp(34))
            _btn.setCursor(Qt.CursorShape.PointingHandCursor)
            _btn.clicked.connect(
                lambda _c=False, k=_key: self._switch_view(k))
            self._view_group.addButton(_btn)
            self._view_buttons[_key] = _btn
            head.addWidget(_btn, 0, Qt.AlignmentFlag.AlignVCenter)
        # The Updates tab doubles as Check Now: clicking it while active
        # re-runs the update check (see _switch_view).
        self._view_buttons["updates"].setToolTip(
            "Show updates — click again to check now")
        # Log toggle stays at the far right: it governs the side panel,
        # which spans the full content height below.
        self._log_btn = QPushButton("Log")
        self._log_btn.setObjectName("secondary-small")
        self._log_btn.setFixedHeight(_sp(34))
        self._log_btn.setCheckable(True)
        self._log_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        self._icon_btn(self._log_btn, "terminal", 14)
        self._log_btn.setToolTip("Show the live installer log beside the list")
        self._log_btn.toggled.connect(self._on_log_toggled)
        head.addWidget(self._log_btn, 0, Qt.AlignmentFlag.AlignVCenter)
        self._head_row = head
        lay.addLayout(head)

        lay.addWidget(_divider())

        # ── Zone 2 · Content row: list column left, log panel right ─────────
        # Everything update-related packs into the left column so the log
        # panel can span the full content height when opened.
        content = QHBoxLayout()
        content.setSpacing(_sp(12))
        left = QVBoxLayout()
        left.setSpacing(_sp(12))
        content.addLayout(left, 1)
        self._left_col = left

        self._content_stack = QStackedWidget()
        left.addWidget(self._content_stack, 1)
        self._up_page = QWidget()
        up = QVBoxLayout(self._up_page)
        up.setContentsMargins(0, 0, 0, 0)
        up.setSpacing(_sp(16))
        self._content_stack.addWidget(self._up_page)
        self._view_buttons["updates"].setChecked(True)

        # ── Stats ───────────────────────────────────────────────────────────
        # In a container: with nothing pending, the strip stands down
        # instead of advertising three zeros.
        self._stats_row = QWidget()
        stats = QHBoxLayout(self._stats_row)
        stats.setContentsMargins(0, 0, 0, 0)
        stats.setSpacing(_sp(8))
        n_comp = sum(1 for p in updates if p.get("compromised"))
        n_repos = sum(1 for p in updates if not p.get("compromised")
                      and _source_key(p.get("repo", ""))
                      in (SRC_OFFICIAL, SRC_MANAGED))
        n_aur = sum(1 for p in updates if not p.get("compromised")
                    and _source_key(p.get("repo", "")) == SRC_AUR)
        self._stat_ready = _StatCard(str(n - n_comp), "ready to install",
                                     _positive_hex())
        self._stat_official = _StatCard(str(n_repos), "from repos",
                                        _accent_hex())
        self._stat_aur = _StatCard(str(n_aur), "aur", _warning_hex())
        # Always four cells: adding one later would resize the other three.
        self._stat_blocked = _StatCard(str(n_comp), "blocked · skipped",
                                       _negative_hex() if n_comp
                                       else _secondary_hex())
        self._update_stat_cards = {
            "ready": self._stat_ready,
            "repos": self._stat_official,
            SRC_AUR: self._stat_aur,
            "blocked": self._stat_blocked,
        }
        self._stat_official.setToolTip(
            "Show packages from pacman repositories — official, CachyOS, "
            "Chaotic-AUR, archlinuxcn")
        self._stat_ready.setToolTip(
            "Show every package that can be installed")
        for key, card in self._update_stat_cards.items():
            card.clicked.connect(
                lambda _=False, k=key: self._toggle_update_filter(k))
        for card in (self._stat_ready, self._stat_official,
                     self._stat_aur, self._stat_blocked):
            stats.addWidget(card, 1)
        # Left-aligned grid: any leftover width is honest whitespace, not
        # a stretched empty card.
        stats.addStretch()
        up.addWidget(self._stats_row)

        # ── Failure banner slot ─────────────────────────────────────────────
        # NOTE: intentionally no top banner widget. A dynamically shown
        # nested container gets squeezed below its children's minimums
        # when the window overflows, overlapping its own text. The status
        # box below (a direct layout child) renders reliably, names the
        # failing packages, and the list auto-scrolls to the failed row.
        self._fail_row: int | None = None

        # ── View banners (two deliberate, allowed layout shifts) ────────────

def _package_url(name: str, repo: str) -> str:
    """Deep link to a package: exact AUR page, or Arch package search."""
    if (repo or "").lower() == "aur":
        return f"https://aur.archlinux.org/packages/{name}"
    return f"https://archlinux.org/packages/?q={name}"


def _repo_tint(repo: str) -> tuple[tuple[int, int, int], str]:
    """(rgb, foreground hex) pill colors per repo, readable both themes.

    Callers choose the format: stylesheets take CSS rgba(), QPainter
    takes QColor(*rgb, alpha).
    """
    r = (repo or "").lower()
    if r == "aur":
        return (230, 97, 0), "#e66100"
    if "testing" in r:
        return (145, 65, 172), "#9141ac"
    return (53, 132, 228), "#3584e4"


class _ScanRow(QWidget):
    """One scanned package as a card: identity + verdict."""

    def __init__(self, pkg: dict) -> None:
        super().__init__()
        is_comp = bool(pkg.get("compromised"))
        self.setAttribute(Qt.WidgetAttribute.WA_StyledBackground, True)
        self.setObjectName(
            "package-card-blocked" if is_comp else "package-card"
        )
        outer = QVBoxLayout(self)
        outer.setContentsMargins(14, 10, 14, 12)
        outer.setSpacing(4)

        top = QHBoxLayout()
        top.setSpacing(8)
        name = QLabel(pkg["name"])
        name.setObjectName("package-name")
        top.addWidget(name)
        rgb, fg = _repo_tint(pkg.get("repo", ""))
        badge = QLabel((pkg.get("repo") or "").upper())
        badge.setObjectName("repo-badge")
        badge.setStyleSheet(
            f"background: rgba({rgb[0]},{rgb[1]},{rgb[2]},0.16); color: {fg};"
            "border-radius: 8px; padding: 2px 8px;"
            "font-size: 11px; font-weight: 700;")
        top.addWidget(badge)
        ver = QLabel(pkg.get("version", ""))
        ver.setObjectName("package-date")
        top.addWidget(ver)
        top.addStretch()
        link = QLabel(
            f"<a href='{_package_url(pkg['name'], pkg.get('repo', ''))}'>"
            "View package ↗</a>"
        )
        link.setObjectName("package-link")
        link.setOpenExternalLinks(True)
        top.addWidget(link)
        outer.addLayout(top)

        if is_comp:
            reasons = "; ".join(pkg.get("reasons", ["unknown"]))
            verdict = QLabel(f"⚠️ COMPROMISED — {reasons}")
            verdict.setStyleSheet(
                "font-size: 12px; font-weight: 600; color: #e01b24;")
        else:
            verdict = QLabel("✓ Clean")
            verdict.setStyleSheet(
                f"font-size: 12px; font-weight: 600; color: {_CLEAN_GREEN};")
        verdict.setWordWrap(True)
        outer.addWidget(verdict)



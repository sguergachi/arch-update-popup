        self._list.setModel(self._model)
        self._delegate = PackageDelegate(self._list)
        self._list.setItemDelegate(self._delegate)
        # Perf: no per-cell widgets, per-pixel smooth scrolling, and rows
        # only repaint when their own dataChanged fires.
        self._list.setSelectionMode(
            QAbstractItemView.SelectionMode.NoSelection)
        self._list.setVerticalScrollMode(
            QAbstractItemView.ScrollMode.ScrollPerPixel)
        # Fixed, not Adjust: every row is the same height (see the
        # delegate), so the view never re-measures mid-scroll.
        self._list.setResizeMode(QListView.ResizeMode.Fixed)
        self._list.setSpacing(0)
        self._list.setFrameShape(QFrame.Shape.NoFrame)
        # Same rhythm as every other list: cards breathe at the top and
        # bottom instead of flushing against the viewport edge.
        self._list.setViewportMargins(0, 8, 0, 8)
        self._list.setMouseTracking(True)
        self._list.viewport().setMouseTracking(True)
        # Fixed rows carry their own width: re-measure when the viewport
        # narrows (log panel, window resize) or the cards clip.
        self._list.viewport().installEventFilter(_ViewResizeHook(self._list))
        self._delegate.toggled.connect(self._on_row_toggled)
        self._delegate.link_activated.connect(
            lambda url: QDesktopServices.openUrl(QUrl(url)))
        self._delegate.more_requested.connect(self._on_more_requested)
        self._delegate.action_requested.connect(self._on_row_action)
        self._model.dataChanged.connect(self._on_model_changed)
        # Empty state: the window opens even with nothing to update.
        # Empty state: icon, headline, one muted line — centred *inside*
        # the list's own frame, so an empty window still reads as "a list
        # with nothing in it" rather than text floating in space.
        # The placeholder lives inside the list's frame; the frame, the
        # header and the stat strip never move (see AGENTS.md).
        self._empty_state = _placeholder_overlay(self._list)
        self._empty_icon = self._empty_state.icon
        self._empty_title = self._empty_state.title
        self._empty_label = self._empty_state.body

        # Row controls sit with the rows: select-all, the count when the
        # selection is partial, and the filter.
        self._list_header = _ListHeader("Filter packages…")
        self._list_header.select_all.connect(self._select_all)
        self._list_header.filter_changed.connect(self._on_filter_changed)
        self._sel_label = self._list_header.count
        up.addWidget(self._list_header)
        up.addWidget(self._list, 1)
        self._model.rowsInserted.connect(lambda *a: self._refresh_empty_state())
        self._model.rowsRemoved.connect(lambda *a: self._refresh_empty_state())
        self._refresh_empty_state()

        # Side log panel: fixed width, hidden until toggled or failure.
        self._log_panel = QWidget()
        self._log_panel.setObjectName("log-panel")
        self._log_panel.setFixedWidth(_sp(360))
        self._log_panel.setVisible(False)
        log_lay = QVBoxLayout(self._log_panel)
        log_lay.setContentsMargins(_sp(12), _sp(12), _sp(12), _sp(12))
        log_lay.setSpacing(_sp(8))
        # Error details live at the top of the side area, above the log:
        # one place for all failure inspection. Hidden unless an update
        # fails (which also auto-opens the panel).

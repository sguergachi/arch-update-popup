        close_btn.setMinimumWidth(120)
        close_btn.clicked.connect(self.close)
        footer.addWidget(close_btn)
        lay.addLayout(footer)

    # — Switch flow (strictly sequential: pacman has one lock) —
    def request_switch(self, name: str) -> None:
        if name in self._queue or name == self._current:
            return
        move = self._moves.get(name)
        if move is None:
            return
        if move["relation"] == "downgrade" and self._rows[name]._switch_btn.text() != "Retry":
            box = QMessageBox(self)
            box.setWindowTitle(f"Switch {name}?")
            box.setIcon(QMessageBox.Icon.Warning)
            box.setText(
                f"The {_repo_label(move['source'])} build "
                f"({move['target']}) is OLDER than your "
                f"installed AUR build ({move['installed']}).\n\n"
                "Switching will downgrade the package. Proceed?")
            go_btn = box.addButton("Switch anyway",
                                   QMessageBox.ButtonRole.AcceptRole)
            box.addButton("Cancel", QMessageBox.ButtonRole.RejectRole)
            box.exec()
            if box.clickedButton() is not go_btn:
                return
        if os.path.exists(_PACMAN_LOCK):
            self._status.setText(
                "Another package operation is running — "
                "close the update window or wait, then retry.")
            return
        self._queue.append(name)
        self._rows[name].set_row_state("idle", "Queued — waiting for turn…")
        self._run_next()

    def _run_next(self) -> None:
        if self._runner is not None or not self._queue:
            return
        if os.path.exists(_PACMAN_LOCK):
            self._status.setText(
                "Pacman database is locked — retry when the other "
                "operation finishes.")
            for name in self._queue:
                self._rows[name].set_row_state("idle")
            self._queue.clear()
            return
        name = self._queue.pop(0)
        self._current = name
        self._rows[name].set_row_state("switching", "Installing official build…")
        self._status.setText(f"Switching {name}… (a password dialog may appear)")
        self.logged.emit(f"Switching {name} to the official build…")
        # Force the pacman path: deterministic official-repo install.
        self._runner = UpdateRunner(None, [name])
        self._runner.done.connect(self._on_switch_done)
        self._runner.start()

    def _on_switch_done(self, success: bool, output: str) -> None:
        name = self._current or ""
        if self._runner is not None:
            self._runner.wait(5000)
            self._runner = None
        self._current = None
        move = self._moves.get(name, {})
        verified = False
        if success and move:
            verified = not verify_upgraded({name: move["target"]})
        if not success and classify_update_failure(output)[0] == "cancelled":
            # Circuit breaker: auth dismissed — nothing ran.
            self._rows[name].set_row_state("idle")
            self.logged.emit(f"Switching {name} cancelled")
            self._status.setText(
                "Cancelled — nothing was changed."
                if not self._queue else f"Continuing ({len(self._queue)} queued)…")
            self._run_next()
            return
        if success and verified:
            self._rows[name].set_row_state(
                "done",
                f"Now tracking {_repo_label(move['source'])} "
                f"{move['target']} ✓")
            self._changed = True
            self.logged.emit(f"{name} now tracks the official build ✓")
            self.moves_done.emit()
        else:
            if success:
                # Exit 0 but version didn't land (stale DB edge).
                output += (f"\n{name}: still not at "
                           f"{move.get('target', '?')} — "
                           "was not upgraded (stale sync database)")
            lines = [l for l in output.splitlines() if l.strip()]
            hint = " · ".join(lines[-2:]) if lines else "No output captured"
            self.logged.emit(f"Switching {name} failed: {hint}")
            self._rows[name].set_row_state("failed", hint)
        self._status.setText(
            "Done — reopen the update window or Check Now to refresh."
            if not self._queue else f"Continuing ({len(self._queue)} queued)…")
        self._run_next()

    def closeEvent(self, event) -> None:  # type: ignore[override]
        # Never destroy a running QThread (aborts the process). The
        # runner stops gracefully via terminate(); if it won't stop,
        # park it instead of dropping the wrapper.
        if self._runner is not None:
            if self._runner.isRunning():
                try:
                    self._runner.terminate()
                except Exception:
                    pass
                if not self._runner.wait(8000):
                    self._runner.finished.connect(self._runner.deleteLater)
                    self._runner.finished.connect(
                        lambda: self._orphans.discard(self._runner))
                    self._orphans.add(self._runner)
            self._runner = None
        super().closeEvent(event)
        self.closed.emit()

    def changeEvent(self, event) -> None:  # type: ignore[override]
        super().changeEvent(event)
        if event.type() in _THEME_CHANGE_TYPES:
            self.setStyleSheet(_themed_qss())


# ── System tray application ────────────────────────────────────────────────────

class TrayApp(QObject):
    _CHECK_INTERVAL_MS = 30 * 60 * 1000   # 30 minutes

    def __init__(self, app: QApplication, icon: QIcon) -> None:
        super().__init__()
        self._app        = app
        self._aur_helper = _find_aur_helper()
        self._updates:     list[dict]                      = []
        self._cached_info: dict[int, tuple[str, str, str]] = {}
        self._window:      UpdateWindow | None             = None
        self._checker:     UpdateChecker | None            = None
        self._fetcher:     InfoFetcher | None              = None
        self._orphans: set = set()  # parked threads (see _park_thread)
        app.aboutToQuit.connect(self._shutdown)

        # ── Tray icon ──────────────────────────────────────────────────────────
        self._tray = QSystemTrayIcon(icon, self)
        self._tray.setToolTip("Arch Update")
        self._tray.activated.connect(self._on_tray_activated)
        self._tray.messageClicked.connect(self._open_window)

        # ── Context menu ───────────────────────────────────────────────────────
        menu = QMenu()
        self._status_act = menu.addAction("Checking for updates…")
        self._status_act.setEnabled(False)
        menu.addSeparator()
        self._show_act = menu.addAction("Show Updates…")
        self._show_act.triggered.connect(self._open_window)
        self._show_act.setEnabled(True)
        self._check_act = menu.addAction("Check Now")
        self._check_act.triggered.connect(self.check_now)
        menu.addSeparator()
        quit_act = menu.addAction("Quit")
        quit_act.triggered.connect(app.quit)
        self._tray.setContextMenu(menu)
        self._tray.show()

        # ── Periodic check timer ───────────────────────────────────────────────
        timer = QTimer(self)
        timer.timeout.connect(self.check_now)
        timer.start(self._CHECK_INTERVAL_MS)

        # Initial check after a short delay (let the desktop settle)
        QTimer.singleShot(2000, self.check_now)

    # ── Check cycle ────────────────────────────────────────────────────────────

    def check_now(self) -> None:
        if self._checker and self._checker.isRunning():
            return
        self._status_act.setText("Checking for updates…")
        self._check_act.setEnabled(False)
        self._checker = UpdateChecker(self._aur_helper)
        self._checker.updates_found.connect(self._on_updates_found)
        self._checker.no_updates.connect(self._on_no_updates)
        self._checker.finished.connect(lambda: self._check_act.setEnabled(True))
        self._checker.start()

    def _on_updates_found(self, updates: list[dict]) -> None:
        self._stop_fetcher()
        self._updates = updates
        # Seed from the on-disk cache so the window is instantly populated
        # when a previous check already fetched this exact version.
        cache = load_pkg_info_cache()
        self._cached_info = {}
        for i, pkg in enumerate(updates):
            entry = cache.get(pkg["name"])
            if entry and entry.get("version") == pkg["new"]:
                self._cached_info[i] = (
                    entry.get("desc") or "No description available",
                    entry.get("notes") or "",
                    entry.get("date") or "",
                    entry.get("full") or "",
                    entry.get("source") or "",
                    entry.get("source_url") or "",
                )
        n = len(updates)
        compromised = [p for p in updates if p.get("compromised")]

        if compromised:
            names = ", ".join(p["name"] for p in compromised)
            self._tray.setToolTip(
                f"⚠️  ARCH UPDATE - SUPPLY CHAIN ATTACK DETECTED  ⚠️\n"
                f"Compromised packages: {names}"
            )
            self._status_act.setText(
                f"⚠️ {len(compromised)} compromised package{'s' if len(compromised) != 1 else ''} blocked"
            )
            self._show_act.setEnabled(True)
            self._tray.showMessage(
                "⚠️ AUR Supply-Chain Attack Detected",
                f"{len(compromised)} package{'s' if len(compromised) != 1 else ''} "
                f"({names}) flagged as compromised. They will be skipped during update.\n"
                f"Safe packages can still be installed.",
                QSystemTrayIcon.MessageIcon.Critical,
                12000,
            )
        else:
            self._tray.setToolTip(f"Arch Update  —  {n} update{'s' if n != 1 else ''} available")
            self._status_act.setText(f"{n} update{'s' if n != 1 else ''} available")
            self._show_act.setEnabled(True)

            self._tray.showMessage(
                "Arch Update",
                f"{n} package{'s' if n != 1 else ''} available — click to update",
                QSystemTrayIcon.MessageIcon.Information,
                6000,
            )

        self._fetcher = InfoFetcher(updates)
        self._fetcher.row_ready.connect(self._on_row_cached)
        self._fetcher.finished.connect(self._on_fetch_done)
        self._fetcher.start()

    def _on_no_updates(self) -> None:
        self._stop_fetcher()
        self._updates = []
        self._cached_info = {}
        self._tray.setToolTip("Arch Update  —  system up to date")
        self._status_act.setText("System is up to date")
        self._show_act.setEnabled(True)

    # ── Fetcher lifecycle ──────────────────────────────────────────────────────

    def _stop_fetcher(self) -> None:
        if self._fetcher is None:
            return
        # Disconnect before interrupting to prevent stale callbacks on cleared data.
        try:
            self._fetcher.row_ready.disconnect(self._on_row_cached)
            self._fetcher.finished.disconnect(self._on_fetch_done)
        except TypeError:
            pass
        if self._fetcher.isRunning():
            self._fetcher.requestInterruption()
            if not self._fetcher.wait(5000):
                # Still blocked in network I/O — never destroy a running
                # QThread (sip aborts the process). Park it instead: it
                # exits on its own once the request finishes.
                self._park_thread(self._fetcher)
        self._fetcher = None

    def _park_thread(self, thread: QThread) -> None:
        """Keep a still-running thread alive until it finishes itself.

        The finished signal deletes it; the set holds the Python reference
        so sip can't garbage-collect a live QThread (hard abort).
        """
        thread.finished.connect(thread.deleteLater)
        thread.finished.connect(lambda: self._orphans.discard(thread))
        self._orphans.add(thread)
        if thread.isFinished():
            thread.deleteLater()
            self._orphans.discard(thread)

    def _release_thread(self, attr: str) -> None:
        """Drop a finished worker reference, safely (see window version)."""
        thread = getattr(self, attr, None)
        if thread is None:
            return
        if thread.isRunning() and not thread.wait(5000):
            self._park_thread(thread)
        setattr(self, attr, None)

    def _on_row_cached(self, row: int, name: str, new_ver: str,
                       desc: str, notes: str, date: str,
                       full: str, source: str, source_url: str) -> None:
        self._cached_info[row] = (desc, notes, date, full, source, source_url)
        if self._window is not None:
            self._window.on_info_ready(row, desc, notes, date,
                                       full, source, source_url)

    def _on_fetch_done(self) -> None:
        if self._window is not None:
            self._window.on_fetch_done()
        self._release_thread("_fetcher")

    # ── Tray interaction ───────────────────────────────────────────────────────

    def _on_tray_activated(self, reason: QSystemTrayIcon.ActivationReason) -> None:
        if reason in (
            QSystemTrayIcon.ActivationReason.Trigger,
            QSystemTrayIcon.ActivationReason.DoubleClick,
        ):
            self._open_window()

    def _open_window(self) -> None:
        # The window always opens — even with nothing to update — so the
        # Obsolete and Security tools are reachable from the main app.
        if self._window is not None:
            self._window.raise_()
            self._window.activateWindow()
            return
        self._window = UpdateWindow(self._updates, self._cached_info, self._aur_helper)
        self._window.closed.connect(self._on_window_closed)
        self._window.update_succeeded.connect(self._on_update_succeeded)
        self._window.show()
        self._window.raise_()
        self._window.activateWindow()

    def _on_window_closed(self) -> None:
        self._window = None

    def _shutdown(self) -> None:
        """Stop every worker thread before Qt tears down.

        Destroying a running QThread aborts the process, so: stop the
        window's runners first, then park anything still running.
        """
        if self._window is not None:
            try:
                self._window._stop_runners()
            except Exception:
                pass
        if self._checker is not None:
            if self._checker.isRunning():
                self._park_thread(self._checker)
            self._checker = None
        self._stop_fetcher()

    def _on_update_succeeded(self) -> None:
        self._updates = []
        self._cached_info = {}
        self._stop_fetcher()
        self._tray.setToolTip("Arch Update  —  system up to date")
        self._status_act.setText("System is up to date")
        self._show_act.setEnabled(True)
        QTimer.singleShot(5000, self.check_now)


# ── Icon ───────────────────────────────────────────────────────────────────────

def _app_icon() -> QIcon:
    """Render the app mark into a QIcon, in the active accent color."""
    renderer = QSvgRenderer(QByteArray(
        _icon_svg(_accent_hex(), _on_accent_hex())))
    pm = QPixmap(64, 64)
    pm.fill(QColor(0, 0, 0, 0))
    painter = QPainter(pm)
    renderer.render(painter, QRectF(0, 0, 64, 64))
    painter.end()
    return QIcon(pm)


# ── Entry point ────────────────────────────────────────────────────────────────

def main() -> None:
    os.environ.setdefault("WAYLAND_DISPLAY", "wayland-0")
    os.environ.setdefault("QT_QPA_PLATFORM", "wayland;xcb")

    # --show opens the window straight away (a tray app has no other way in
    # from a terminal, and it makes the app scriptable from a launcher).
    show_now = any(arg in ("--show", "-s") for arg in sys.argv[1:])

    app = QApplication(sys.argv)
    app.setApplicationName("arch-update-popup")
    app.setApplicationDisplayName("Arch Update")
    app.setQuitOnLastWindowClosed(False)   # keep alive in tray after window closes

    icon = _app_icon()
    app.setWindowIcon(icon)

    if not QSystemTrayIcon.isSystemTrayAvailable():
        print("No system tray available.", file=sys.stderr)
        sys.exit(1)

    _tray_app = TrayApp(app, icon)  # noqa: F841 — keep reference alive
    if show_now:
        QTimer.singleShot(0, _tray_app._open_window)
    sys.exit(app.exec())


if __name__ == "__main__":
    main()

    def _on_moves_dialog_closed(self) -> None:
        self._moves_dialog = None

    def _on_moves_changed(self) -> None:
        self._set_status(
            "Switched to managed repos — press Check Now (tray) or "
            "reopen this window to refresh the list.", "ok")

    def show_popover(self, row: int) -> None:
        self._popover = NotesPopover(self, self._model.item(row))
        self._popover.show()

    # — Per-package actions —
    def _on_row_action(self, name: str) -> None:
        r = self._model.row_of(name)
        if r is None:
            return
        item = self._model.item(r)
        if item["compromised"]:
            self._confirm_install_anyway(name, item)
        else:
            self._run_single(name)

    def _confirm_install_anyway(self, name: str, item: dict) -> None:
        reasons = "; ".join(item.get("reasons", ["unknown"]))
        box = QMessageBox(self)
        box.setWindowTitle(f"Install {name} anyway?")
        box.setIcon(QMessageBox.Icon.Critical)
        box.setText(
            f"⚠️  {name} is flagged as COMPROMISED and was skipped for your safety:\n\n"
            f"{reasons}\n\n"
            "Installing it may compromise your system. Only proceed if you have "
            "personally verified the package is safe (e.g. the upstream issue "
            "was resolved and the package was rebuilt)."
        )
        go_btn = box.addButton("I verified — install anyway",
                               QMessageBox.ButtonRole.AcceptRole)
        box.addButton("Cancel", QMessageBox.ButtonRole.RejectRole)
        box.exec()
        if box.clickedButton() is go_btn:
            self._run_single(name)

    def _run_single(self, name: str, overwrite: str | None = None) -> None:
        """Install exactly one package (retry a failure, or install-anyway)."""
        if self._updating or self._single is not None:
            self._set_status(
                "Another install is already running — please wait…", "info")
            return
        if self._rechecker is not None and self._rechecker.isRunning():
            self._set_status(
                "A check is still running — please wait…", "info")
            return
        self._single_name = name
        self._single_overwrite = overwrite
        self._model.set_state(name, "installing")
        self._anim.start()
        self._note_activity()
        self._stuck_warned = False
        self._watchdog.start()
        self._show_log()
        self._set_status(f"Installing {name}…", "info")
        self._log_action(
            f"Installing {name}" + (" with --overwrite" if overwrite else ""))
        self._show_cancel(True)
        self._cancel_btn.setEnabled(True)
        self._recheck_btn.setEnabled(False)
        self._single = UpdateRunner(
            self._aur_helper, [name], overwrite=overwrite)
        self._single.line.connect(self._on_log_line)
        self._single.conflict.connect(self._on_live_conflict)
        self._single.done.connect(self._on_single_done)
        self._single.start()

    def _on_single_done(self, success: bool, output: str) -> None:
        name = self._single_name or ""
        self._release_thread("_single")
        self._single_name = None
        self._anim.stop()
        self._watchdog.stop()
        self._show_cancel(False)
        self._cancel_btn.setEnabled(True)
        self._recheck_btn.setEnabled(True)
        r = self._model.row_of(name)
        if r is None:
            return
        if success:
            want = self._model.item(r).get("new", "")
            stale = verify_upgraded({name: want}) if want else []
            if stale:
                have = stale[0][1]
                output = ((output + "\n") if output else "") + (
                    f"{name}: still {have}, expected {want} — "
                    "was not upgraded (stale sync database)")
                success = False
        if success:
            self._model.set_state(name, "done")
            _notify_close(self._fail_notif_id)
            self._fail_notif_id = 0
            self._sub.setText(f"<b>{name}</b> installed ✓")
            self._log_action(f"{name} installed ✓")
            subprocess.Popen([
                "notify-send", "Arch Update", f"{name} installed.",
                "-i", "system-software-update", "-t", "6000",
            ])
            return
        self._model.set_state(name, "failed")
        kind = classify_update_failure(output)[0]
        if kind == "cancelled":
            # Circuit breaker: auth dismissed — nothing ran. Back to idle,
            # no failure UI at all.
            self._model.set_state(name, "idle")
            self._hide_failure_ui()
            self._set_status(f"{name} install cancelled — nothing was "
                             "changed.", "info")
            self._log_action(f"{name} install cancelled")
            self._show_cancel(False)
            self._cancel_btn.setEnabled(True)
            return
        kind, title, advice = classify_update_failure(output)
        lines = [l for l in output.splitlines() if l.strip()]
        self._last_error = "\n".join(lines[-40:]) if lines else "(no output captured)"
        self._details.setPlainText(self._last_error)
        self._details_label.setVisible(True)
        self._details.setVisible(True)
        self._copy_btn.setVisible(True)
        self._dismiss_btn.setVisible(True)
        self._set_status(f"{name}: {title}. {advice}", "error")
        self._fail_row = r
        self._scroll_to_failed()
        self._show_log()
        self._log_action(f"{name} failed: {title}")
        self._show_error_dialog(
            "install failed",
            f"Installing {name} failed — {title}.",
            f"{advice} Use Retry on its row, or open the log panel for the "
            "full output.",
            self._last_error)
        self._fail_notif_id = _notify_update(
            "Arch Update Failed", f"{title}: {name}",
            replaces_id=self._fail_notif_id)
        if self._offer_open:
            return
        self._offer_open = True
        try:
            self._maybe_offer_overwrite_retry(kind, output, single_name=name)
        finally:
            self._offer_open = False
        self._drain_pending_removals()

    def _maybe_offer_obsolete_cleanup(self, output: str) -> None:
        """If the failed update looks blocked by dropped packages, offer to remove them."""
        try:
            obsolete = get_obsolete_packages()
        except Exception:
            obsolete = []
        culprits = obsolete_conflict_culprits(output, obsolete)
        if not culprits:
            return

        names = "\n".join(f"  • {pkg}" for pkg in culprits)
        box = QMessageBox(self)
        box.setWindowTitle("Obsolete packages blocking the update")
        box.setIcon(QMessageBox.Icon.Warning)
        box.setText(
            "The update failed, possibly because these packages are no longer\n"
            "provided by any repository and are blocking the upgrade:\n\n"
            f"{names}\n\n"
            "They are usually split packages dropped upstream and are safe to remove.\n"
            "Remove them now and retry the update?"
        )
        remove_btn = box.addButton("Remove & Retry", QMessageBox.ButtonRole.AcceptRole)
        box.addButton("Cancel", QMessageBox.ButtonRole.RejectRole)
        box.exec()
        if box.clickedButton() is remove_btn:
            self._start_obsolete_removal(culprits)

    def _start_obsolete_removal(self, packages: list[str]) -> None:
        force = False
        blocked = find_blocked_obsolete_packages(packages)
        if blocked:
            names = ", ".join(blocked)
            box = QMessageBox(self)
            box.setWindowTitle("Obsolete packages still required")
            box.setIcon(QMessageBox.Icon.Warning)
            box.setText(
                f"{names} is/are still required by other installed packages.\n\n"
                "Removing them requires ignoring dependencies (-Rdd).\n"
                "Only do this if the packages requiring them are being upgraded\n"
                "to versions that no longer depend on them."
            )
            force_btn = box.addButton("Force Removal", QMessageBox.ButtonRole.AcceptRole)
            box.addButton("Cancel", QMessageBox.ButtonRole.RejectRole)
            box.exec()
            if box.clickedButton() is not force_btn:
                return
            force = True

        self._update_btn.setEnabled(False)
        self._cancel_btn.setEnabled(False)
        self._progress.setRange(0, 0)
        self._progress.setFormat("")
        self._set_progress_state("normal")
        self._set_status("Removing obsolete packages… (a password dialog may appear)", "info")

        self._remover = ObsoleteRemover(packages, force=force)
        self._log_action(
            f"Removing obsolete packages: {', '.join(packages)}"
            + (" (forced)" if force else ""))
        self._remover.done.connect(self._on_obsolete_removal_done)
        self._remover.start()

    def _on_obsolete_removal_done(self, success: bool, output: str) -> None:
        self._release_thread("_remover")
        if not success:
            if classify_update_failure(output)[0] == "cancelled":
                # Circuit breaker: auth dismissed — nothing was removed.
                self._set_status(
                    "Authentication was dismissed — nothing was changed.",
                    "info")
                self._log_action("Obsolete removal cancelled by authentication")
                self._update_btn.setEnabled(True)
                self._cancel_btn.setEnabled(True)
                return
            last = [l for l in output.splitlines() if l.strip()][-2:]
            hint = " · ".join(last) if last else "No output captured"
            self._log_action(f"Obsolete removal failed: {hint}")
            self._set_status(f"Obsolete removal failed: {hint}", "error")
            self._show_error_dialog(
                "removal failed",
                "Removing the obsolete packages failed.",
                f"{hint}\n\nUse Retry on the affected rows, or open the log "
                "panel for the full output.",
                output)
            self._update_btn.setEnabled(True)
            self._cancel_btn.setEnabled(True)
            return
        if getattr(self, "_obsolete_ctx", "updates") == "obsolete":
            # View-owned removal: reload async (never on GUI thread),
            # stay in the view.
            self._obsolete_ctx = "updates"
            self._obs_loaded = False
            self._set_status("Obsolete packages removed ✓ — rescanning…", "ok")
            self._log_action("Obsolete packages removed ✓")
            self._update_btn.setEnabled(True)
            self._cancel_btn.setEnabled(True)
            self._show_cancel(False)
            self._refresh_selection_ui()
            self._obs_summary.setText("Scanning for obsolete packages…")
            self._load_obsolete_async()
            return
        self._set_status("Obsolete packages removed — retrying update…", "info")
        self._log_action("Obsolete packages removed ✓ — retrying update")
        self.start_update()

    def _icon_btn(self, btn: QPushButton, name: str, size: int = 16,
                  token: str | None = None) -> None:
        """Set a bundled icon, remembering it for theme-change refresh."""
        btn.setIcon(app_icon(name, size, token))
        self._theme_icons[id(btn)] = (btn, name, size, token)

    def _on_app_palette_changed(self, _pal) -> None:
        self._apply_theme()

    def _apply_theme(self) -> None:
        """Re-resolve every baked theme color after a dark/light switch.

        The stylesheet hex, button-icon greys, and the Updates delegate's
        cached documents all snapshot the theme at creation time — without
        this the list view keeps the old theme until the window is reopened.
        Skips when the dark/light value didn't actually flip (spurious
        palette noise, and StyleChange re-entrancy from setStyleSheet).
        """
        dark = _is_dark_theme()
        if dark == self._theme_dark:
            return
        self._theme_dark = dark
        self.setStyleSheet(_themed_qss())
        for btn, name, size, token in self._theme_icons.values():
            btn.setIcon(app_icon(name, size, token))
        # Delegates may not exist yet if a style event fires mid-__init__.
        delegate = getattr(self, "_delegate", None)
        if delegate is not None:
            delegate.refresh_theme()
        track = getattr(self, "_track_delegate", None)
        if track is not None:
            track.refresh_theme()
        for attr in ("_list", "_track_list"):
            view = getattr(self, attr, None)
            if view is not None:
                view.viewport().update()
        self._refresh_baked_colors()

    def _refresh_baked_colors(self) -> None:
        """Re-resolve the colors baked into widgets, not the stylesheet.

        Inline stylesheets and pixmaps snapshot the theme when they are
        built, so a live light/dark flip has to rebuild them too.
        """
        icon_lbl = getattr(self, "_icon_lbl", None)
        if icon_lbl is not None:
            icon_lbl.setPixmap(_app_icon().pixmap(_sp(36), _sp(36)))
        for attr, color in (("_stat_ready", _positive_hex()),
                            ("_stat_official", _accent_hex()),
                            ("_stat_aur", _warning_hex()),
                            ("_stat_blocked",
                             _negative_hex() if self._compromised
                             else _secondary_hex())):
            card = getattr(self, attr, None)
            if card is not None:
                card.set_accent(color)
        # Mid-__init__ style events reach here before the model exists.
        if hasattr(self, "_model"):
            self._refresh_selection_ui()

    def resizeEvent(self, event) -> None:  # type: ignore[override]
        super().resizeEvent(event)
        # The elision depends on the width; re-fit rather than reflow.
        self._sub.setText(self._fit_status_line(self._sub.text()))

    def changeEvent(self, event) -> None:  # type: ignore[override]
        super().changeEvent(event)
        if event.type() in _THEME_CHANGE_TYPES:
            self._apply_theme()

    def keyPressEvent(self, event) -> None:  # type: ignore[override]
        if event.key() == Qt.Key.Key_Escape:
            self.close()
        elif (
            event.key() in (Qt.Key.Key_Return, Qt.Key.Key_Enter)
            and self._update_btn.isEnabled()
            and self._content_stack.currentIndex() == 0
        ):
            self._on_update_btn_clicked()
        else:
            super().keyPressEvent(event)

    def _save_ui_state(self) -> None:
        """Remember the window box for the next launch."""
        try:
            rect = self.geometry()
            state = load_settings()
            state["geometry"] = [rect.x(), rect.y(), rect.width(),
                                 rect.height()]
            save_settings(state)
        except Exception:
            pass

    def closeEvent(self, event) -> None:  # type: ignore[override]
        # Never destroy a running QThread: sip turns that into a hard
        # abort ("QThread: Destroyed while thread is still running").
        # Stopping first also kills the child installer, so closing the
        # window mid-update is an explicit cancel.
        self._stop_runners()
        runner = getattr(self, "_enable_runner", None)
        if runner is not None:
            if runner.isRunning():
                runner.terminate()
                runner.wait(8000)
            self._enable_runner = None
        progress = getattr(self, "_enable_progress", None)
        if progress is not None:
            progress.close()
            self._enable_progress = None
        self._save_ui_state()
        super().closeEvent(event)
        self.closed.emit()

    def _park_thread(self, thread) -> None:
        """Keep a still-running thread alive until it finishes itself.

        NEVER destroy (or raw-terminate) a running QThread: terminate()
        poisons its state so the later wrapper drop aborts the process
        ("QThread: Destroyed while thread is still running"). Parked
        threads are deleted by Qt once finished.

        This runs while the window is closing, so it must never raise —
        an exception escaping closeEvent aborts the whole app.
        """
        try:
            finished = getattr(thread, "finished", None)
            if finished is None:      # not a QThread: just drop the handle
                self._orphans.add(thread)
                return
            finished.connect(thread.deleteLater)
            finished.connect(lambda: self._orphans.discard(thread))
            self._orphans.add(thread)
            if thread.isFinished():
                thread.deleteLater()
                self._orphans.discard(thread)
        except Exception:
            traceback.print_exc()

    def _release_thread(self, attr: str) -> None:
        """Drop a finished worker reference, safely.

        wait() releases the GIL while blocking, so a worker still
        unwinding from its final emit always finishes first — destroying
        its wrapper a moment earlier aborts the whole process. Falls
        back to parking if it somehow never finishes.
        """
        thread = getattr(self, attr, None)
        if thread is None:
            return
        if thread.isRunning() and not thread.wait(5000):
            self._park_thread(thread)
        setattr(self, attr, None)

    def _stop_runners(self) -> None:
        """Stop all workers. Installers get a graceful terminate (their
        run loops notice the dead child and exit normally); pure-compute
        threads only ever get interruption + parking."""
        # Recheck threads never block window close: park them instantly
        # instead of waiting (a check runs pacman/network I/O).
        for attr in ("_rechecker", "_recheck_fetcher"):
            thread = getattr(self, attr, None)
            if thread is None:
                continue
            try:
                thread.requestInterruption()
            except Exception:
                pass
            if thread.isRunning():
                self._park_thread(thread)
            setattr(self, attr, None)
        for attr in ("_runner", "_single", "_remover", "_track_runner",
                     "_track_uninstaller", "_untracked_uninstaller"):
            thread = getattr(self, attr, None)
            if thread is not None:
                if thread.isRunning():
                    try:
                        thread.terminate()  # graceful override: kills child
                    except Exception:
                        pass
                    if not thread.wait(8000):
                        self._park_thread(thread)
                setattr(self, attr, None)
        for attr in ("_sec_scanner", "_obs_checker", "_track_loader",
                       "_track_apps", "_untracked_loader"):
            thread = getattr(self, attr, None)
            if thread is None:
                continue
            if thread.isRunning():
                try:
                    thread.requestInterruption()
                except Exception:
                    pass
                if not thread.wait(12000):
                    self._park_thread(thread)
            setattr(self, attr, None)


# ── Enabling a managed source (privileged, one sudo -A prompt) ─────────


class _SourceEnableRunner(QThread):
    """Runs a bash script as root under `sudo -A`, streaming its output."""

    line = pyqtSignal(str)           # one output line, as it arrives
    done = pyqtSignal(bool, str)    # success, tail of output

    def __init__(self, script_body: str) -> None:
        super().__init__()
        self._proc: subprocess.Popen | None = None
        self._killed = False
        self._script = script_body
        self._askpass: str | None = None
        # Build the command shape at construction, like ObsoleteRemover, so
        # tests can inspect it without running anything. The temp script path
        # is filled in run().
        if shutil.which("sudo"):
            self._askpass = make_askpass_script(
                "Enter sudo password to enable the managed source:")
            self._cmd = ["sudo", "-A", "bash", "<script>"]
        else:
            self._cmd = ["pkexec", "bash", "<script>"]

    def _child_env(self) -> dict:
        """Environment for the child process, exporting SUDO_ASKPASS."""
        env = os.environ.copy()
        if self._askpass:
            env["SUDO_ASKPASS"] = self._askpass
        return env

    def _cleanup(self) -> None:
        if self._askpass:
            try:
                os.unlink(self._askpass)
            except OSError:
                pass
            self._askpass = None

    def run(self) -> None:
        import tempfile
        path = ""
        fd = -1
        try:
            fd, path = tempfile.mkstemp(suffix=".sh", prefix="arch-update-enable-")
            with os.fdopen(fd, "w") as f:
                f.write(self._script)
            fd = -1
            os.chmod(path, stat.S_IRWXU)
            self._cmd = ["sudo", "-A", "bash", path] if self._askpass else \
                ["pkexec", "bash", path]
            env = self._child_env()
            master_fd, slave_fd = pty.openpty()
            try:
                proc = subprocess.Popen(
                    self._cmd,
                    stdout=slave_fd, stderr=slave_fd,
                    stdin=subprocess.DEVNULL, env=env, close_fds=True)
            except FileNotFoundError as e:
                os.close(master_fd); os.close(slave_fd)
                self.done.emit(False, str(e))
                return
            os.close(slave_fd)
            self._proc = proc
            lines: list[str] = []
            buf = ""
            while True:
                try:
                    ready, _, _ = select.select([master_fd], [], [], 0.05)
                except (OSError, ValueError):
                    break
                if ready:
                    try:
                        buf += os.read(master_fd, 4096).decode(
                            errors="replace")
                    except OSError:
                        break
                    while "\n" in buf:
                        raw, buf = buf.split("\n", 1)
                        for fragment in raw.split("\r"):
                            fragment = _ANSI_RE.sub("", fragment).strip()
                            if fragment:
                                lines.append(fragment)
                                self.line.emit(fragment)
                elif proc.poll() is not None:
                    break
            try:
                os.close(master_fd)
            except OSError:
                pass
            proc.wait()
            ok = proc.returncode == 0 and not self._killed
            self.done.emit(ok, "\n".join(lines[-40:]))
        finally:
            if fd >= 0:
                try:
                    os.close(fd)
                except OSError:
                    pass
            self._cleanup()
            if path:
                try:
                    os.unlink(path)
                except OSError:
                    pass

    def terminate(self) -> None:  # type: ignore[override]
        self._killed = True
        proc = self._proc
        if proc is not None:
            try:
                proc.terminate()
            except Exception:
                pass




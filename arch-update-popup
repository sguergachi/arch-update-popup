    # — Inline AUR → official switching (one at a time: one pacman lock) —
    def _request_track_switch(self, name: str) -> None:
        r = self._track_model.row_of(name)
        if r is None:
            return
        item = self._track_model.item(r)
        if not item["target"] or name in self._track_queue \
                or name == self._track_current:
            return
        if item["relation"] == "downgrade" and item["state"] != "failed":
            box = QMessageBox(self)
            box.setWindowTitle(f"Switch {name}?")
            box.setIcon(QMessageBox.Icon.Warning)
            box.setText(
                f"The {_repo_label(item['source'])} build "
                f"({item['target']}) is OLDER than your "
                f"installed AUR build ({item['version']}).\n\n"
                "Switching will downgrade the package. Proceed?")
            go_btn = box.addButton("Switch anyway",
                                   QMessageBox.ButtonRole.AcceptRole)
            box.addButton("Cancel", QMessageBox.ButtonRole.RejectRole)
            box.exec()
            if box.clickedButton() is not go_btn:
                return
        if os.path.exists(_PACMAN_LOCK):
            self._set_status(
                "Another package operation is running — wait for it to "
                "finish, then retry.", "error")
            return
        self._track_queue.append(name)
        self._track_model.set_state(name, "idle")
        self._run_next_track_switch()

    def _move_all_tracked(self) -> None:
        for name in self._track_model.movable_names():
            if name not in self._track_queue and name != self._track_current:
                r = self._track_model.row_of(name)
                if r is not None and self._track_model.item(r)["relation"] != "downgrade":
                    self._track_queue.append(name)
        # Downgrades need individual confirmation — skip them in bulk.
        self._run_next_track_switch()
        self._set_status(
            f"Queued {len(self._track_queue)} move"
            f"{'s' if len(self._track_queue) != 1 else ''} to managed repos…",
            "info")
        self._log_action(
            f"Queued {len(self._track_queue)} move"
            f"{'s' if len(self._track_queue) != 1 else ''} to managed repos")

    def _run_next_track_switch(self) -> None:
        if self._track_runner is not None or not self._track_queue:
            return
        if os.path.exists(_PACMAN_LOCK):
            self._set_status(
                "Pacman database is locked — retry when the other "
                "operation finishes.", "error")
            self._track_queue.clear()
            return
        name = self._track_queue.pop(0)
        self._track_current = name
        self._track_model.set_state(name, "switching")
        row = self._track_model.row_of(name)
        source = (self._track_model.item(row)["source"]
                  if row is not None else "")
        label = _repo_label(source)
        self._set_status(f"Switching {name} to the {label} build…", "info")
        self._log_action(f"Switching {name} to the {label} build…")
        self._track_runner = UpdateRunner(None, [name])
        self._track_runner.done.connect(self._on_track_switch_done)
        self._track_runner.start()

    def _on_track_switch_done(self, success: bool, output: str) -> None:
        name = self._track_current or ""
        self._release_thread("_track_runner")
        self._track_current = None
        r = self._track_model.row_of(name)
        if r is None:
            self._run_next_track_switch()
            return
        item = self._track_model.item(r)
        verified = False
        if success:
            verified = not verify_upgraded({name: item["target"]})
        if not success and classify_update_failure(output)[0] == "cancelled":
            # Circuit breaker: auth dismissed — nothing ran.
            self._track_model.set_state(name, "idle")
            self._set_status(f"Switching {name} cancelled — nothing was "
                             "changed.", "info")
            self._log_action(f"Switching {name} cancelled")
            self._refresh_tracked_summary()
            self._update_view_badges()
            self._run_next_track_switch()
            return
        if success and verified:
            self._track_model.set_state(name, "done")
            label = _repo_label(item["source"])
            self._set_status(f"{name} now tracks the {label} build ✓", "ok")
            self._log_action(f"{name} now tracks the {label} build ✓")
        else:
            if success:
                output += (f"\n{name}: still not at {item['target']} — "
                           "was not upgraded (stale sync database)")
            self._track_model.set_state(name, "failed", op="switch")
            self._log_action(f"Switching {name} failed")
            self._set_status(
                f"Switching {name} failed — use Retry on its row.", "error")
            lines = [l for l in output.splitlines() if l.strip()]
            self._show_error_dialog(
                "switch failed",
                f"Switching {name} to the "
                f"{_repo_label(item['source'])} build failed.",
                "Use Retry on its row, or open the log panel for the full "
                "output.",
                "\n".join(lines[-40:]) if lines else "(no output captured)")
        self._refresh_tracked_summary()
        self._update_view_badges()
        self._run_next_track_switch()

    # — Per-package uninstall (Tracked tab) —
    def _busy_with_update(self) -> bool:
        """An install/update run is holding pacman's database."""
        return self._updating or self._single is not None

    def _removal_can_wait(self, kind: str, names: list[str]) -> bool:
        """Stop a removal that cannot run now; offer to do it afterwards.

        Returns True when the caller must stop. A run this app started is
        known to end, so those removals queue and run by themselves; a
        database locked by something else is refused with the reason and
        what to do about it. Either way nothing is launched that would
        print an error and change nothing.
        """
        label = names[0] if len(names) == 1 else f"{len(names)} packages"
        if self._busy_with_update():
            box = QMessageBox(self)
            box.setWindowTitle("An update is running")
            box.setIcon(QMessageBox.Icon.Information)
            box.setText(
                f"<b>{label}</b> can't be removed while the update is "
                "running — pacman's database is busy, so a removal now "
                "would do nothing.<br><br>"
                "Remove it as soon as the update finishes?")
            later_btn = box.addButton("Remove when it finishes",
                                      QMessageBox.ButtonRole.AcceptRole)
            box.addButton("Cancel", QMessageBox.ButtonRole.RejectRole)
            box.exec()
            if box.clickedButton() is not later_btn:
                return True
            self._pending_removals.append((kind, list(names)))
            self._set_status(
                f"{label} will be removed when the update finishes.", "info")
            self._log_action(f"Queued {label} for removal after the update")
            return True
        if pacman_lock_held():
            box = QMessageBox(self)
            box.setWindowTitle("Another package manager is running")
            box.setIcon(QMessageBox.Icon.Warning)
            box.setText(
                "pacman's database is locked, so a removal right now would "
                "do nothing.<br><br>"
                "Wait for the other package manager to finish and try "
                "again. If nothing else is running, the lock is stale — "
                "delete <b>/var/lib/pacman/db.lck</b> and retry.")
            box.exec()
            self._set_status(
                "Nothing was changed — pacman's database is locked by "
                "another package manager.", "info")
            self._log_action(f"Removing {label} refused: pacman's database "
                             "is locked")
            return True
        return False

    def _drain_pending_removals(self) -> bool:
        """Run the removals queued while an update was running.

        Returns True when at least one removal was started (the caller
        must then keep the window alive: closing stops the runners)."""
        if self._busy_with_update() or not self._pending_removals:
            return False
        queued, self._pending_removals = self._pending_removals, []
        started = False
        for kind, names in queued:
            if kind == "track":
                self._start_track_uninstall(names, confirmed=True)
                started = True
            elif kind == "untracked":
                self._start_untracked_uninstall(names, confirmed=True)
                started = True
            elif kind == "obsolete":
                self._obsolete_ctx = "obsolete"
                self._start_obsolete_removal(list(names))
                started = True
        return started

    def _track_label(self, name: str) -> str:
        """What to call a Tracked row in a dialog: its title, not its id."""
        r = self._track_model.row_of(name)
        if r is None:
            return name
        return self._track_model.item(r).get("title") or name

    def _track_source(self, name: str) -> str:
        """Canonical source key of a Tracked row ('' when unknown)."""
        r = self._track_model.row_of(name)
        if r is None:
            return ""
        return _source_key(self._track_model.item(r)["repo"])

    def _request_track_uninstall(self, name: str) -> None:
        self._start_track_uninstall([name])

    def _uninstall_tracked_selected(self) -> None:
        names = self._track_model.checked_names()
        if not names:
            return
        self._start_track_uninstall(names)

    def _start_track_uninstall(self, names: list[str],
                               confirmed: bool = False) -> None:
        names = [n for n in names if self._track_model.row_of(n) is not None]
        if not names:
            return
        if self._track_uninstaller is not None:
            self._set_status(
                "A removal is already running — please wait…", "info")
            return
        if self._removal_can_wait("track", names):
            return
        single = len(names) == 1
        flatpak_ids = [n for n in names if self._track_source(n) == SRC_FLATPAK]
        image_names = [n for n in names if self._track_source(n) == SRC_APPIMAGE]
        pacman_names = [n for n in names
                        if n not in flatpak_ids and n not in image_names]
        if not confirmed:
            if pacman_names:
                how = "pacman -Rns"
                if flatpak_ids or image_names:
                    how += " · Flatpak / the AppImage file for the rest"
            elif flatpak_ids and not image_names:
                how = "uninstalled by Flatpak"
            elif image_names and not flatpak_ids:
                how = "deleted — an AppImage is the file, nothing else"
            else:
                how = "Flatpak for one, the file for the other"
            box = QMessageBox(self)
            box.setWindowTitle(
                f"Remove {names[0]}?" if single
                else f"Remove {len(names)} packages?")
            box.setIcon(QMessageBox.Icon.Warning)
            if single:
                box.setText(
                    f"Remove <b>{self._track_label(names[0])}</b> and any "
                    f"dependencies that become unneeded ({how})?\n\n"
                    "Configuration files in your home directory are kept.")
            else:
                listed = "<br>".join(f"  • <b>{n}</b>" for n in names[:12])
                more = (f"<br>  • …and {len(names) - 12} more"
                        if len(names) > 12 else "")
                box.setText(
                    f"Remove <b>{len(names)}</b> packages and any "
                    f"dependencies that become unneeded ({how})?"
                    f"<br><br>{listed}{more}<br><br>"
                    "Configuration files in your home directory are kept.")
            go_btn = box.addButton("Remove",
                                   QMessageBox.ButtonRole.AcceptRole)
            box.addButton("Cancel", QMessageBox.ButtonRole.RejectRole)
            box.exec()
            if box.clickedButton() is not go_btn:
                return
        force = False
        # Only pacman packages can be "still required": a Flatpak app id
        # and an AppImage file are not in pacman's database at all.
        blocked = (find_blocked_obsolete_packages(pacman_names)
                   if pacman_names else [])
        if blocked:
            box2 = QMessageBox(self)
            box2.setWindowTitle(
                f"{blocked[0]} is still required" if len(blocked) == 1
                else f"{len(blocked)} packages still required")
            box2.setIcon(QMessageBox.Icon.Warning)
            box2.setText(
                f"<b>{', '.join(blocked[:8])}</b>"
                f"{'…' if len(blocked) > 8 else ''} "
                "is still required by other installed packages.\n\n"
                "Force removal (-Rdd) can break those packages and is "
                "only safe if you know they no longer need it.")
            force_btn = box2.addButton("Force Removal",
                                       QMessageBox.ButtonRole.AcceptRole)
            box2.addButton("Cancel", QMessageBox.ButtonRole.RejectRole)
            box2.exec()
            if box2.clickedButton() is not force_btn:
                return
            force = True
        self._track_uninstall_names = list(names)
        self._track_uninstall_current = names[0] if single else None
        for n in names:
            self._track_model.set_state(n, "uninstalling")
        label = (self._track_label(names[0]) if single
                 else f"{len(names)} packages")
        # One remover at a time, pacman first (one password prompt for
        # the privileged half), then whatever else was selected.
        batches = [b for b in (pacman_names, flatpak_ids, image_names) if b]
        self._track_pending = batches[1:]
        self._track_gone: list[str] = []
        self._track_failed: list[str] = []
        self._track_outputs: list[str] = []
        self._start_track_remover(batches[0], force, label)
        self._refresh_tracked_footer()

    def _start_track_remover(self, names: list[str], force: bool,
                             label: str) -> None:
        """Run the remover that owns this batch (pacman, Flatpak, file)."""
        self._track_kind = ("flatpak" if self._track_source(names[0])
                            == SRC_FLATPAK else
                            "appimage" if self._track_source(names[0])
                            == SRC_APPIMAGE else "pacman")
        self._track_batch = list(names)
        if self._track_kind == "flatpak":
            self._track_uninstaller = FlatpakRemover(
                names, {a: i for a, (_v, i) in _flatpak_apps().items()})
            self._log_action(f"Removing {label} with Flatpak…")
            self._set_status(f"Removing {label} with Flatpak…", "info")
        elif self._track_kind == "appimage":
            paths = [self._track_path(n) for n in names]
            self._track_uninstaller = AppImageRemover(
                [p for p in paths if p])
            self._log_action(f"Removing {label} (the file itself)…")
            self._set_status(f"Removing {label}…", "info")
        else:
            self._track_uninstaller = ObsoleteRemover(names, force=force)
            self._log_action(
                f"Removing {label}…" + (" (forced)" if force else ""))
            self._set_status(
                f"Removing {label}… (a password dialog may appear)", "info")
        self._track_uninstaller.done.connect(self._on_track_uninstall_done)
        self._track_uninstaller.start()

    def _track_path(self, name: str) -> str:
        """The file behind an AppImage row ('' for anything else)."""
        r = self._track_model.row_of(name)
        if r is None:
            return ""
        return self._track_model.item(r).get("path", "")

    def _removal_step(self, names: list[str], kind: str,
                      success: bool, output: str) -> tuple[list[str], list[str]]:
        """Verify one finished batch → (gone, failed).

        Partial success is normal, so every name is checked on its own —
        against the database that actually owns it.
        """
        gone: list[str] = []
        failed: list[str] = []
        if not success:
            return gone, list(names)
        if kind == "appimage":
            # An AppImage is a file: it is gone when the file is gone.
            for n in names:
                path = self._track_path(n)
                (failed if path and os.path.exists(path) else gone).append(n)
        elif kind == "flatpak":
            # Flatpak keeps its own list; ask it, never pacman.
            try:
                still_here = set(_flatpak_apps())
            except Exception:
                still_here = set(names)
            for n in names:
                (failed if n in still_here else gone).append(n)
        else:
            for n in names:
                try:
                    still = _run(["pacman", "-Q", n], capture_output=True,
                                 timeout=30).returncode == 0
                except Exception:
                    still = True
                (failed if still else gone).append(n)
        return gone, failed

    def _on_track_uninstall_done(self, success: bool, output: str) -> None:
        names = list(self._track_batch) or list(self._track_uninstall_names)
        kind = self._track_kind
        self._release_thread("_track_uninstaller")
        if not names:
            self._track_batch = []
            self._track_pending = []
            self._track_uninstall_names = []
            return
        if not success and classify_update_failure(output)[0] == "cancelled":
            # Circuit breaker: auth dismissed — nothing was removed. Drop
            # the rest of the selection too: it needs the same password.
            for n in [*names, *self._track_pending]:
                if self._track_model.row_of(n) is not None:
                    self._track_model.set_state(n, "idle")
            label = names[0] if len(names) == 1 else f"{len(names)} packages"
            self._track_batch = []
            self._track_pending = []
            self._track_uninstall_names = []
            self._track_uninstall_current = None
            self._set_status(
                "Authentication was dismissed — nothing was changed.", "info")
            self._log_action(f"Removing {label} cancelled by authentication")
            self._refresh_tracked_summary()
            self._update_view_badges()
            return
        gone, failed = self._removal_step(names, kind, success, output)
        self._track_gone.extend(gone)
        self._track_failed.extend(failed)
        self._track_outputs.append(output)
        for n in gone:
            # remove_row is a silent no-op when the row is already gone.
            self._track_model.remove_row(n)
        self._track_batch = []
        if self._track_pending:
            # A mixed selection runs one remover at a time; the summary
            # waits for the whole selection.
            nxt = self._track_pending.pop(0)
            label = (self._track_label(nxt[0]) if len(nxt) == 1
                     else f"{len(nxt)} packages")
            self._start_track_remover(nxt, force=False, label=label)
            return
        self._track_uninstall_names = []
        self._track_uninstall_current = None
        gone, failed = self._track_gone, self._track_failed
        output = "\n".join(o for o in self._track_outputs if o)
        self._track_gone, self._track_failed, self._track_outputs = [], [], []
        if gone:
            what = (f"{gone[0]} uninstalled ✓" if len(gone) == 1
                    else f"{len(gone)} packages uninstalled ✓")
            self._set_status(what, "ok")
            self._log_action(what)
        if failed:
            if not output:
                output = "removal failed"
            lines = [l for l in output.splitlines() if l.strip()]
            hint = " · ".join(lines[-2:]) if lines else "No output captured"
            for n in failed:
                if self._track_model.row_of(n) is not None:
                    self._track_model.set_state(n, "failed", op="uninstall")
            label = failed[0] if len(failed) == 1 else f"{len(failed)} packages"
            self._log_action(f"Removing {label} failed: {hint}")
            self._set_status(
                f"Removing {label} failed: {hint} — use Retry on "
                f"{'its' if len(failed) == 1 else 'their'} row.", "error")
            self._show_error_dialog(
                "removal failed",
                f"Removing {label} failed.",
                f"{hint}\n\nUse Retry on "
                f"{'its' if len(failed) == 1 else 'their'} row, or open the "
                "log panel for the full output.",
                output)
        self._refresh_tracked_summary()
        self._update_view_badges()

    # ── Untracked view (GUI apps on disk + dependency packages) ──────────
    def _make_card_list(self, model):
        """A virtualized Tracked-style card list for one untracked model.

        Wires checkbox flips, Open/Uninstall pills and View-package links
        to the untracked slots; footer refresh follows model signals.
        """
        view = QListView()
        view.setObjectName("package-list")
        view.setModel(model)
        delegate = TrackedDelegate(view)
        view.setItemDelegate(delegate)
        # Fixed rows carry their own width: re-measure when the viewport
        # narrows (log panel, window resize) or the cards clip.
        view.viewport().installEventFilter(_ViewResizeHook(view))
        view.setSelectionMode(
            QAbstractItemView.SelectionMode.NoSelection)
        view.setVerticalScrollMode(
            QAbstractItemView.ScrollMode.ScrollPerPixel)
        view.setResizeMode(QListView.ResizeMode.Fixed)
        view.setSpacing(0)
        view.setFrameShape(QFrame.Shape.NoFrame)
        view.setHorizontalScrollBarPolicy(
            Qt.ScrollBarPolicy.ScrollBarAlwaysOff)
        view.setViewportMargins(0, 8, 0, 8)
        view.setMouseTracking(True)
        view.viewport().setMouseTracking(True)
        delegate.uninstall_requested.connect(
            self._request_untracked_uninstall)
        delegate.open_requested.connect(self._open_untracked_app)
        delegate.link_activated.connect(
            lambda url: QDesktopServices.openUrl(QUrl(url)))
        delegate.toggled.connect(
            lambda row, m=model: self._toggle_card_check(m, row))
        model.dataChanged.connect(
            lambda *a: self._refresh_untracked_footer())
        model.rowsInserted.connect(
            lambda *a: self._refresh_untracked_footer())
        model.rowsRemoved.connect(
            lambda *a: self._refresh_untracked_footer())
        return view, delegate

    def _toggle_card_check(self, model, row: int) -> None:
        idx = model.index(row)
        cur = model.data(idx, Qt.ItemDataRole.CheckStateRole)
        model.setData(
            idx,
            Qt.CheckState.Unchecked if cur == Qt.CheckState.Checked
            else Qt.CheckState.Checked,
            Qt.ItemDataRole.CheckStateRole)

    def _un_models(self):
        return (self._unapp_model, self._unpkg_model)

    def _un_selected_names(self) -> list[str]:
        seen: list[str] = []
        for m in self._un_models():
            for n in m.checked_names():
                if n not in seen:
                    seen.append(n)
        return seen

    def _un_set_state(self, name: str, state: str,
                      op: str | None = None) -> None:
        for m in self._un_models():
            if m.row_of(name) is not None:
                m.set_state(name, state, op=op)

    def _un_source(self, name: str) -> str:
        """Canonical source key of an untracked row ('' when unknown)."""
        for m in self._un_models():
            r = m.row_of(name)
            if r is not None:
                return _source_key(m.item(r)["repo"])
        return ""

    def _un_owned(self, name: str) -> bool:
        """False for app rows no package owns (nothing to uninstall)."""
        for m in self._un_models():
            r = m.row_of(name)
            if r is not None:
                it = m.item(r)
                if it["version"] or it["repo"]:
                    return True
        return False

    def _on_untracked_loaded(self, apps: list[dict],
                             pkgs: list[dict]) -> None:
        self._release_thread("_untracked_loader")
        self._untracked_loaded = True
        self._un_loading = False
        self._unapp_model.set_items(apps)
        self._unpkg_model.set_items(pkgs)
        self._refresh_un_placeholders()
        self._refresh_untracked_summary()
        self._update_view_badges()

    def _refresh_un_placeholders(self) -> None:
        """Empty states for both untracked lists — filter-aware, so a
        filter that hides everything says so instead of showing a blank."""
        self._show_un_empty(
            self._unapp_model, self._unapp_empty,
            "No untracked applications",
            "Every application with a launcher is owned by a package — "
            "or came from Flatpak, which lives in Tracked.")
        self._show_un_empty(
            self._unpkg_model, self._unpkg_empty,
            "No stray dependencies",
            "No dependency-installed packages were found.")

    def _show_un_empty(self, model, placeholder, title: str,
                       blurb: str) -> None:
        if model.rowCount():
            placeholder.hide_state()
            return
        src = model.filter_source()
        if src:
            label = _SOURCE_META.get(src, (src, ""))[0]
            placeholder.show_state(
                "No matches",
                f"Nothing here is {label}. Clear the filter to see "
                "everything pacman doesn't track.",
                icon="search", colour="muted")
            return
        if not self._untracked_loaded:
            return          # the loading placeholder is already up
        placeholder.show_state(title, blurb, icon="check-circle",
                               colour="positive")

    def _refresh_untracked(self) -> None:
        """Scan again for applications and packages pacman doesn't own."""
        if (self._untracked_loader is not None
                and self._untracked_loader.isRunning()):
            return
        self._log_action("Scanning for untracked software…")
        self._untracked_loaded = False
        self._un_loading = True
        self._unapp_model.set_items([])
        self._unpkg_model.set_items([])
        self._release_thread("_untracked_loader")
        self._untracked_loader = UntrackedLoader()
        self._untracked_loader.done.connect(self._on_untracked_loaded)
        self._untracked_loader.start()
        self._refresh_untracked_summary()
        self._update_view_badges()

    def _refresh_untracked_summary(self) -> None:
        self._refresh_un_stats()
        na = self._unapp_model.rowCount()
        np = self._unpkg_model.rowCount()
        if na == 0 and np == 0 and not self._untracked_loaded:
            self._un_summary.setText("Scanning for untracked software…")
            self._un_footer_label.setText("Loading…")
            if self._un_loading:
                self._unapp_empty.show_loading(
                    "Looking for applications pacman doesn't own…")
                self._unpkg_empty.show_loading(
                    "Looking for dependency packages…")
            else:
                self._unapp_empty.hide_state()
                self._unpkg_empty.hide_state()
        else:
            self._un_summary.setText(
                f"<b>{na}</b> application{'s' if na != 1 else ''} · "
                f"<b>{np}</b> dependency package{'s' if np != 1 else ''} — "
                "not explicitly installed")
            self._un_footer_label.setText(f"{na} apps · {np} packages")
        self._refresh_untracked_footer()

    def _refresh_untracked_footer(self) -> None:
        sel = self._un_selected_names()
        n_sel = len(sel)
        n = (self._unapp_model.rowCount() + self._unpkg_model.rowCount())
        # The header's count is kept current even while the scan runs, so
        # that strip never looks half-empty.
        self._un_header.set_state(n_sel, n)
        if not getattr(self, "_untracked_loaded", False):
            self._un_footer_label.setText("Loading…")
            self._un_uninstall_btn.setText("Uninstall selected")
            self._un_uninstall_btn.setEnabled(False)
            return
        running = self._untracked_uninstaller is not None
        if running:
            self._un_footer_label.setText(
                f"Removing {len(self._untracked_uninstall_names)} "
                f"package{'s' if len(self._untracked_uninstall_names) != 1 else ''}…")
            self._un_uninstall_btn.setText("Removing…")
            self._un_uninstall_btn.setEnabled(False)
            return
        if n_sel:
            self._un_footer_label.setText("")
            self._un_uninstall_btn.setText(
                f"Uninstall {n_sel} selected")
            self._un_uninstall_btn.setEnabled(True)
            return
        na = self._unapp_model.rowCount()
        np = self._unpkg_model.rowCount()
        self._un_footer_label.setText(
            f"{na} app{'s' if na != 1 else ''} · "
            f"{np} package{'s' if np != 1 else ''}")
        self._un_uninstall_btn.setText("Uninstall selected")
        self._un_uninstall_btn.setEnabled(False)

    def _select_untracked_all(self, checked: bool) -> None:
        for m in self._un_models():
            m.set_all(checked)
        self._refresh_untracked_footer()

    def _open_untracked_app(self, name: str) -> None:
        desktop = ""
        for m in self._un_models():
            r = m.row_of(name)
            if r is not None and m.item(r)["desktop"]:
                desktop = m.item(r)["desktop"]
                break
        if not desktop:
            return
        try:
            ok = _launch_desktop(desktop)
        except Exception:
            ok = False
        if ok:
            self._log_action(f"Opened {name}")
        else:
            self._set_status(f"Couldn't open {name}", "error")

    # — Untracked uninstall (single rows + batch selection) —
    def _request_untracked_uninstall(self, name: str) -> None:
        self._start_untracked_uninstall([name])

    def _uninstall_untracked_selected(self) -> None:
        names = self._un_selected_names()
        if not names:
            return
        self._start_untracked_uninstall(names)

    def _start_untracked_uninstall(self, names: list[str],
                                   confirmed: bool = False) -> None:
        known = [n for n in names
                 if any(m.row_of(n) is not None for m in self._un_models())
                 and self._un_owned(n)]
        skipped = [n for n in names if n not in known]
        if not known:
            self._set_status(
                "Nothing to remove — "
                f"{names[0] if names else 'that'} isn't owned by any "
                "package.", "info")
            return
        if self._untracked_uninstaller is not None:
            self._set_status(
                "A removal is already running — please wait…", "info")
            return
        if self._removal_can_wait("untracked", known):
            return
        single = len(known) == 1
        if not confirmed:
            box = QMessageBox(self)
            box.setWindowTitle(
                f"Remove {known[0]}?" if single
                else f"Remove {len(known)} packages?")
            box.setIcon(QMessageBox.Icon.Warning)
            if single:
                box.setText(
                    f"Remove <b>{known[0]}</b> and any dependencies that "
                    "become unneeded (pacman -Rns)?\n\n"
                    "Configuration files in your home directory are kept.")
            else:
                listed = "<br>".join(f"  • <b>{n}</b>" for n in known[:12])
                more = (f"<br>  • …and {len(known) - 12} more"
                        if len(known) > 12 else "")
                skip_note = (f"<br><br>Skipped {len(skipped)} not owned by "
                             "any package." if skipped else "")
                box.setText(
                    f"Remove <b>{len(known)}</b> packages and any "
                    "dependencies that become unneeded (pacman -Rns)?"
                    f"<br><br>{listed}{more}{skip_note}<br><br>"
                    "Configuration files in your home directory are kept.")
            go_btn = box.addButton("Remove",
                                   QMessageBox.ButtonRole.AcceptRole)
            box.addButton("Cancel", QMessageBox.ButtonRole.RejectRole)
            box.exec()
            if box.clickedButton() is not go_btn:
                return
        force = False
        # Only pacman packages can be "still required": a Flatpak app id is
        # not in pacman's database at all, and asking would report it as
        # blocked forever.
        pacman_known = [n for n in known
                        if self._un_source(n) != SRC_FLATPAK]
        blocked = (find_blocked_obsolete_packages(pacman_known)
                   if pacman_known else [])
        if blocked:
            box2 = QMessageBox(self)
            box2.setWindowTitle(
                f"{blocked[0]} is still required" if len(blocked) == 1
                else f"{len(blocked)} packages still required")
            box2.setIcon(QMessageBox.Icon.Warning)
            box2.setText(
                f"<b>{', '.join(blocked[:8])}</b>"
                f"{'…' if len(blocked) > 8 else ''} "
                "is still required by other installed packages.\n\n"
                "Force removal (-Rdd) can break those packages and is "
                "only safe if you know they no longer need it.")
            force_btn = box2.addButton("Force Removal",
                                       QMessageBox.ButtonRole.AcceptRole)
            box2.addButton("Cancel", QMessageBox.ButtonRole.RejectRole)
            box2.exec()
            if box2.clickedButton() is not force_btn:
                return
            force = True
        self._untracked_uninstall_names = list(known)
        for n in known:
            self._un_set_state(n, "uninstalling")
        label = known[0] if single else f"{len(known)} packages"
        # Flatpak apps are removed by Flatpak, not pacman: split the
        # selection and run the pacman batch first (one password prompt).
        flat = [n for n in known if self._un_source(n) == SRC_FLATPAK]
        pacman_names = [n for n in known if n not in flat]
        self._un_pending = []
        if flat and pacman_names:
            self._un_pending = flat
        self._start_un_remover(pacman_names if pacman_names else flat,
                               force=force, label=label)
        self._refresh_untracked_footer()

    def _start_un_remover(self, names: list[str], force: bool,
                          label: str) -> None:
        """Run the remover that owns this batch (pacman or Flatpak)."""
        self._un_kind = ("flatpak" if self._un_source(names[0]) == SRC_FLATPAK
                         else "pacman")
        self._un_batch = list(names)
        if self._un_kind == "flatpak":
            self._untracked_uninstaller = FlatpakRemover(
                names, {a: i for a, (_v, i) in _flatpak_apps().items()})
            self._log_action(f"Removing {label} with Flatpak…")
            self._set_status(f"Removing {label} with Flatpak…", "info")
        else:
            self._untracked_uninstaller = ObsoleteRemover(names, force=force)
            self._log_action(
                f"Removing {label}…" + (" (forced)" if force else ""))
            self._set_status(
                f"Removing {label}… (a password dialog may appear)", "info")
        self._untracked_uninstaller.done.connect(
            self._on_untracked_uninstall_done)
        self._untracked_uninstaller.start()

    def _on_untracked_uninstall_done(self, success: bool,
                                     output: str) -> None:
        names = list(self._un_batch) or list(self._untracked_uninstall_names)
        kind = self._un_kind
        self._release_thread("_untracked_uninstaller")
        if not names:
            self._un_batch = []
            self._un_pending = []
            self._untracked_uninstall_names = []
            return
        if not success and classify_update_failure(output)[0] == "cancelled":
            # Circuit breaker: auth dismissed — nothing was removed. Drop
            # the rest of the selection too: it needs the same password.
            for n in [*names, *self._un_pending]:
                self._un_set_state(n, "idle")
            label = (names[0] if len(names) == 1
                     else f"{len(names)} packages")
            self._un_batch = []
            self._un_pending = []
            self._untracked_uninstall_names = []
            self._set_status(
                "Authentication was dismissed — nothing was changed.", "info")
            self._log_action(f"Removing {label} cancelled by authentication")
            self._refresh_untracked_summary()
            self._update_view_badges()
            return
        gone, failed = self._removal_step(names, kind, success, output)
        self._un_gone.extend(gone)
        self._un_failed.extend(failed)
        self._un_outputs.append(output)
        for n in gone:
            for m in self._un_models():
                m.remove_row(n)  # silent no-op when already gone
        self._un_batch = []
        if self._un_pending:
            # A mixed selection runs one remover at a time: the Flatpak
            # half goes now and the summary waits for the whole selection.
            pending = list(self._un_pending)
            self._un_pending = []
            label = (pending[0] if len(pending) == 1
                     else f"{len(pending)} packages")
            self._start_un_remover(pending, force=False, label=label)
            return
        self._untracked_uninstall_names = []
        gone, failed = self._un_gone, self._un_failed
        output = "\n".join(o for o in self._un_outputs if o)
        self._un_gone, self._un_failed, self._un_outputs = [], [], []
        if gone:
            what = (f"{gone[0]} uninstalled ✓" if len(gone) == 1
                    else f"{len(gone)} packages uninstalled ✓")
            self._set_status(what, "ok")
            self._log_action(what)
        if failed:
            if not output:
                output = "removal failed"
            lines = [l for l in output.splitlines() if l.strip()]
            hint = " · ".join(lines[-2:]) if lines else "No output captured"
            for n in failed:
                self._un_set_state(n, "failed", op="uninstall")
            label = failed[0] if len(failed) == 1 else f"{len(failed)} packages"
            self._log_action(f"Removing {label} failed: {hint}")
            self._set_status(
                f"Removing {label} failed: {hint} — use Retry on "
                f"{'its' if len(failed) == 1 else 'their'} row.", "error")
            self._show_error_dialog(
                "removal failed",
                f"Removing {label} failed.",
                f"{hint}\n\nUse Retry on "
                f"{'its' if len(failed) == 1 else 'their'} row, or open the "
                "log panel for the full output.",
                output)
        self._refresh_untracked_summary()
        self._update_view_badges()

    # ── Unified status line (header, under the title) ────────────────────
    # Every user-facing message in this window renders here — idle
    # summaries, install progress, auth prompts, errors, success notes.
    # Color-coded with a glyph prefix; empty text restores the idle
    # summary instead of leaving a hole.

    def _show_error_dialog(self, title: str, headline: str,
                           advice: str = "", detail: str = "") -> None:
        """Show a failure in a dialog, not only as a line in the header.

        The header line is elided to one line and the details panel has to
        be opened by hand, so a failure the user did not ask for deserves
        to be seen. The raw output lives behind "Show Details", and one
        dialog is open at a time (an exec() is modal, so a second call
        cannot stack behind it anyway).
        """
        if self._error_dialog_open:
            return
        box = self._build_error_dialog(title, headline, advice, detail)
        self._error_dialog_open = True
        try:
            box.exec()
        finally:
            self._error_dialog_open = False

    def _build_error_dialog(self, title: str, headline: str, advice: str,
                            detail: str) -> QMessageBox:
        """Build (do not show) the failure dialog — see _show_error_dialog."""
        box = QMessageBox(self)
        box.setIcon(QMessageBox.Icon.Critical)
        box.setWindowTitle(f"Arch Update — {title}")
        box.setText(headline)
        if advice:
            box.setInformativeText(advice)
        detail = (detail or "").strip()
        if detail:
            box.setDetailedText(detail)
        copy_btn = box.addButton("Copy error",
                                 QMessageBox.ButtonRole.ActionRole)
        box.addButton(QMessageBox.StandardButton.Close)
        box.setStyleSheet(_themed_qss())

        def _copy() -> None:
            QApplication.clipboard().setText(detail or headline)
            copy_btn.setText("Copied ✓")

        copy_btn.clicked.connect(_copy)
        return box

    def _fit_status_line(self, text: str) -> str:
        """Keep the status line to one line, eliding rather than wrapping.

        Returns the HTML when it fits; otherwise a plain, elided version.
        The full sentence is kept in _status_full (and the tooltip), so
        nothing is lost and the line never changes height (see AGENTS.md).
        """
        plain = html.unescape(re.sub(r"<[^>]+>", "", text))
        self._status_full = " ".join(plain.split())
        avail = self._sub.width() - 4
        if avail < 200:
            # Not laid out yet; the next status write will fit properly.
            self._sub.setToolTip(self._status_full)
            return text
        fm = QFontMetrics(self._sub.font())
        self._sub.setToolTip(self._status_full)
        if fm.horizontalAdvance(self._status_full) <= avail:
            return text
        return fm.elidedText(self._status_full, Qt.TextElideMode.ElideRight,
                             avail)

    def _set_status(self, text: str, kind: str = "info") -> None:
        """Show a status message.

        kind: "info" (plain), "error" (red ✕), "ok" (green ✓).
        """
        if not text:
            self._status_active = False
            self._sub.setText(self._fit_status_line(self._idle_summary))
            return
        if kind == "error":
            text = f"<b style='color:{_negative_hex()}'>✕</b> {text}"
        elif kind == "ok":
            text = f"<b style='color:{_positive_hex()}'>✓</b> {text}"
        self._status_active = True
        self._sub.setText(self._fit_status_line(text))

    def _set_progress_state(self, state: str, text: str = "") -> None:
        """Recolor the divider-track: 'normal' (idle green), 'active'
        (working blue), 'error' (red), 'ok' (done green)."""
        chunk = {"normal": _positive_hex(), "active": _accent_hex(),
                 "error": _negative_hex(), "ok": _positive_hex()}[state]
        self._progress.setStyleSheet(
            "QProgressBar { border: none; background: palette(midlight);"
            " border-radius: 2px; min-height: 3px; max-height: 3px;"
            " color: transparent; }"
            "QProgressBar::chunk { background: %s; border-radius: 2px; }"
            % chunk
        )
        if text:
            self._progress.setFormat(text)

    def _hide_failure_ui(self) -> None:
        self._fail_row = None
        self._details_label.setVisible(False)
        self._details.clear()
        self._details.setVisible(False)
        self._copy_btn.setVisible(False)
        self._dismiss_btn.setVisible(False)
        self._last_error = ""

    def _dismiss_error(self) -> None:
        """Close the error details box; rows keep their Retry pills."""
        self._details_label.setVisible(False)
        self._details.clear()
        self._details.setVisible(False)
        self._copy_btn.setVisible(False)
        self._dismiss_btn.setVisible(False)

    def _scroll_to_failed(self) -> None:
        if self._fail_row is not None:
            self._list.scrollTo(self._model.index(self._fail_row),
                                QAbstractItemView.ScrollHint.PositionAtCenter)
            self._list.setCurrentIndex(self._model.index(self._fail_row))

    def _on_show_failed(self) -> None:
        self._scroll_to_failed()

    # ── Called by TrayApp as background data arrives ───────────────────────────

    def on_info_ready(self, row: int, desc: str, notes: str, date: str,
                      full: str = "", source: str = "", source_url: str = "",
                      gen: int | None = None) -> None:
        # Tray feeds carry no generation: once an in-window recheck has
        # replaced the model, they describe the OLD list — drop them.
        if gen is None and self._info_gen != 0:
            return
        # The fetcher addresses rows by source index: validate against the
        # whole list, not the filtered subset, or a filtered-out package
        # would silently never receive its release notes.
        if 0 <= row < self._model.source_count():
            self._model.set_info(row, desc, notes, date, full, source,
                                 source_url)
        if not self._updating:
            if self._progress.maximum() <= 1:
                # Hairline → determinate on first fresh arrival.
                self._progress.setRange(0, max(self._model.rowCount(), 1))
            self._progress.setValue(
                min(self._progress.value() + 1, self._progress.maximum()))

    def on_fetch_done(self, gen: int | None = None) -> None:
        # Same stale-feed fence as on_info_ready (tray calls pass no gen).
        if gen is None and self._info_gen != 0:
            return
        if not self._updating:
            self._set_idle_header(len(self._updates))
            # Release notes in: relax to an empty hairline divider.
            self._set_progress_state("normal")
            self._progress.setRange(0, 1)
            self._progress.setValue(0)

    # ── Update flow ────────────────────────────────────────────────────────────

    def _on_update_btn_clicked(self) -> None:
        """The primary footer button: install what is selected."""
        self.start_update()

    def start_update(self) -> None:
        if self._single is not None:
            self._set_status(
                "A single-package install is still running — please wait…",
                "info")
            return
        if self._rechecker is not None and self._rechecker.isRunning():
            self._set_status(
                "A check is still running — please wait…", "info")
            return
        # A removal holds pacman's database just like an install does:
        # starting now would only produce a lock error.
        if any(getattr(self, attr, None) is not None
               for attr in ("_track_uninstaller", "_untracked_uninstaller",
                            "_remover")):
            self._set_status(
                "A removal is still running — please wait…", "info")
            return
        safe_names = self._model.checked_names()
        if not safe_names:
            return
        self._updating = True
        self._retry_mode = False
        if safe_names != self._last_run_names:
            # Different selection → different problem possibly; reset guard.
            self._fail_sig = None
            self._fail_streak = 0
        self._last_run_names = list(safe_names)
        self._update_btn.setEnabled(False)
        self._cancel_btn.setEnabled(True)
        self._show_cancel(True)
        self._recheck_btn.setEnabled(False)
        # New run supersedes the old failure: dismiss its state and its
        # notification slot bubble so nothing stale lingers.
        _notify_close(self._fail_notif_id)
        self._fail_notif_id = 0
        self._hide_failure_ui()
        self._model.reset_states()
        self._done_names = set()
        self._live_conflicts = {}
        self._seen_building = set()
        if self._log_view.toPlainText().strip():
            self._log_view.appendPlainText("── New run ──")
            self._refresh_log_empty()
        else:
            self._log_preview.setText("")
            self._preview_last = ""
        self._note_activity()
        self._stuck_warned = False
        self._watchdog.start()

        comp_pkgs = [p for p in self._updates if p.get("compromised")]
        self._safe_names = safe_names

        n = len(safe_names)
        self._stat_ready.set_value(str(n))
        self._stat_ready.set_caption("remaining")
        self._stat_ready.set_accent(_positive_hex())
        msg = "Waiting for authentication — a password dialog should appear…"
        if comp_pkgs:
            skipped = ", ".join(p["name"] for p in comp_pkgs)
            msg = f"Skipping compromised: {skipped}. {msg}"
        if self._overwrite:
            msg += " (retrying with --overwrite)"
        self._set_status(msg, "info")
        self._set_progress_state("active")
        self._progress.setRange(0, max(n, 1))
        self._progress.setValue(0)
        self._progress.setFormat("")
        self._anim.start()

        self._runner = UpdateRunner(
            self._aur_helper, safe_names, overwrite=self._overwrite)
        self._log_action(
            f"Installing {n} update{'s' if n != 1 else ''}: "
            f"{', '.join(safe_names)}")
        self._runner.install_progress.connect(self._on_install_progress)
        self._runner.line.connect(self._on_log_line)
        self._runner.build.connect(self._on_build_started)
        self._runner.conflict.connect(self._on_live_conflict)
        self._runner.done.connect(self._on_update_done)
        self._runner.start()

    def _done_selected_count(self) -> int:
        return sum(1 for name in (self._safe_names or [])
                   if name in self._done_names)

    def _progress_phrase(self) -> str:
        """'43% · 3 of 7 done' — one honest readout of the whole run.

        pacman's own (current/total) counts only its current transaction
        (paru splits repo and AUR jobs), so the run's progress is always
        measured against the packages the user actually selected.
        """
        total = max(len(self._safe_names or []), 1)
        done = min(self._done_selected_count(), total)
        return (f"<b>{round(done * 100 / total)}%</b>"
                f" <span style='color:{_secondary_hex()}'>·</span> "
                f"{done} of {total} done")

    def _on_install_progress(self, current: int, total: int, pkg: str) -> None:
        # pacman's (current/total) counts its own transaction only — paru
        # splits repo and AUR into separate transactions, so those numbers
        # lie about the overall run. Our bar/counts use our own done set.
        self._set_progress_state("active")
        n = max(len(self._safe_names or []), 1)
        if self._progress.maximum() != n:
            self._progress.setRange(0, n)
        self._note_activity()
        r = self._model.ensure_row(pkg)
        if self._installing_row is not None and self._installing_row != r:
            prev = self._model.item(self._installing_row)["name"]
            if prev not in self._done_names:
                self._done_names.add(prev)
            self._model.set_state(prev, "done")
        done = self._done_selected_count()
        self._progress.setValue(min(done, n))
        self._stat_ready.set_value(str(max(n - done, 0)))
        if self._model.item(r).get("auto"):
            self._set_status(
                f"Installing <b>{pkg}</b> — {self._progress_phrase()} "
                f"<span style='color:{_secondary_hex()}'>"
                f"(dependency, added below)</span>")
        else:
            self._set_status(f"Installing <b>{pkg}</b> — "
                             f"{self._progress_phrase()}")
        self._installing_row = r
        self._model.set_state(pkg, "installing")
        self._list.scrollTo(self._model.index(r),
                            QAbstractItemView.ScrollHint.EnsureVisible)

    def _on_build_started(self, pkg: str) -> None:
        """An AUR package started building (no pacman count lines exist)."""
        self._note_activity()
        self._set_progress_state("active")
        if pkg in self._seen_building:
            return
        self._seen_building.add(pkg)
        r = self._model.ensure_row(pkg)
        self._set_status(
            f"Building AUR package <b>{pkg}</b> — {self._progress_phrase()} "
            f"<span style='color:{_secondary_hex()}'>"
            f"(builds report no count)</span>")
        self._model.set_state(pkg, "installing")
        self._list.scrollTo(self._model.index(r),
                            QAbstractItemView.ScrollHint.EnsureVisible)

    def _on_live_conflict(self, pkg: str, path: str) -> None:
        """A 'exists in filesystem' error appeared mid-run — surface it now."""
        self._note_activity()
        self._live_conflicts.setdefault(pkg, [])
        if path not in self._live_conflicts[pkg]:
            self._live_conflicts[pkg].append(path)
        r = self._model.ensure_row(pkg)
        self._model.set_state(pkg, "failed")
        self._set_status(
            f"Files already exist on disk: {pkg} "
            f"({path}). Finishing output — retry help will appear below.",
            "error")
        self._show_log()
        self._list.scrollTo(self._model.index(r),
                            QAbstractItemView.ScrollHint.EnsureVisible)

    # — Live log window: every action the app takes lands here —
    def _on_log_line(self, line: str) -> None:
        self._note_activity()
        if is_log_noise(line):
            return
        if not self._log_has_content:
            self._log_has_content = True
            self._refresh_log_empty()
        self._log_view.appendPlainText(line)
        self._preview_log_line(line)

    def _log_action(self, text: str) -> None:
        """Log something the app itself did (switch, remove, open, scan…).

        Timestamped so the panel reads as a universal activity history,
        not just installer output. Never auto-opens the panel — routine
        entries shouldn't yank the UI open.
        """
        self._note_activity()
        stamp = time.strftime("%H:%M:%S")
        line = f"[{stamp}] ◆ {text}"
        if not self._log_has_content:
            self._log_has_content = True
            self._refresh_log_empty()
        self._log_view.appendPlainText(line)
        self._preview_log_line(line)

    def _refresh_log_empty(self) -> None:
        """The log panel shows a quiet placeholder until it has content.

        Reads a flag rather than the buffer: this runs for every line of
        installer output, and toPlainText() copies the whole log each time.
        """
        empty = not self._log_has_content
        self._log_empty.setVisible(empty)
        self._log_view.setVisible(not empty)

    def _clear_log(self) -> None:
        self._log_view.clear()
        self._log_has_content = False
        self._refresh_log_empty()

    def _preview_log_line(self, line: str) -> None:
        # Keep a one-line preview above the progress bar; it hides while
        # the full panel is open (redundant then).
        if line == self._preview_last:
            return
        self._preview_last = line
        short = line.strip()
        # Strip our own log prefix so the preview reads as plain prose.
        short = re.sub(r"^\[[0-9:]+\]\s*◆\s*", "", short)
        if len(short) > 140:
            short = short[:139] + "…"
        self._log_preview.setText(
            f"<span style='color:{_secondary_hex()}'>▸</span> {html.escape(short)}")
        self._log_preview.setToolTip(short)
        self._refresh_log_preview()

    def _refresh_log_preview(self) -> None:
        """Empty the preview while the full panel is open (it is redundant
        then) — but the line itself stays, so nothing below it moves."""
        if self._log_panel.isVisible():
            self._log_preview.clear()

    # — Watchdog + cancel —
    def _note_activity(self) -> None:
        self._last_activity = time.time()

    def _watchdog_tick(self) -> None:
        if not (self._updating or self._single is not None):
            return
        if self._stuck_warned:
            return
        if time.time() - self._last_activity > 120:
            self._stuck_warned = True
            self._set_status(
                "No installer output for 2 minutes — it may be waiting for "
                "input. Check the Log, or press Cancel update.", "error")
            self._show_log()

    def _on_skip_or_cancel(self) -> None:
        if self._updating or self._single is not None:
            self._cancel_update()
        else:
            self.close()

    def _cancel_update(self) -> None:
        runner = self._runner or self._single
        if runner is None:
            return
        runner.terminate()
        self._cancel_btn.setEnabled(False)
        self._set_status("Cancelling the running install…", "info")
        # The done handler logs the final "cancelled" line itself.

    def _on_log_toggled(self, checked: bool) -> None:
        self._log_panel.setVisible(checked)
        self._refresh_log_empty()
        # The preview is a stand-in for the closed panel.
        self._refresh_log_preview()

    def _show_log(self) -> None:
        if not self._log_btn.isChecked():
            self._log_btn.setChecked(True)

    def _copy_error(self) -> None:
        text = self._details.toPlainText()
        if text:
            QApplication.clipboard().setText(text)
            old = self._copy_btn.text()
            self._copy_btn.setText("Copied ✓")
            QTimer.singleShot(2000, lambda: self._copy_btn.setText(old))

    def _copy_log(self) -> None:
        text = self._log_view.toPlainText()
        if text:
            QApplication.clipboard().setText(text)
            old = self._log_copy_btn.text()
            self._log_copy_btn.setText("Copied ✓")
            QTimer.singleShot(2000, lambda: self._log_copy_btn.setText(old))

    def _on_update_done(self, success: bool, output: str) -> None:
        self._anim.stop()
        self._watchdog.stop()
        self._show_cancel(False)
        self._cancel_btn.setEnabled(True)
        self._recheck_btn.setEnabled(True)
        n_total = self._model.rowCount()
        n_selected = len(self._safe_names)
        n_comp = sum(1 for p in self._updates if p.get("compromised"))
        if success:
            # Trust, but verify: a stale sync DB makes `-S` reinstall the
            # OLD version with exit code 0. Never declare success while a
            # selected package is still at its old version.
            expected = {}
            for r in range(self._model.rowCount()):
                it = self._model.item(r)
                if it["name"] in (self._safe_names or []) and it.get("new"):
                    expected[it["name"]] = it["new"]
            stale = verify_upgraded(expected)
            if stale:
                detail = "\n".join(
                    f"{n}: still {have}, expected {want} — "
                    "was not upgraded (stale sync database)"
                    for n, have, want in stale)
                output = ((output + "\n") if output else "") + detail
                success = False
        if success:
            self._overwrite = None
            self._fail_sig = None
            self._fail_streak = 0
            _notify_close(self._fail_notif_id)
            self._fail_notif_id = 0
            self._hide_failure_ui()
            for name in self._safe_names:
                self._model.set_state(name, "done")
            self._installing_row = None
            self._progress.setRange(0, max(n_total, 1))
            self._progress.setValue(n_total)
            self._set_progress_state("ok")
            self._stat_ready.set_value("✓")
            self._stat_ready.set_caption("up to date")
            self._stat_ready.set_accent(_positive_hex())
            msg = f"<b>{n_selected} package{'s' if n_selected != 1 else ''}</b> updated"
            if n_comp:
                msg += f" <span style='color:{_secondary_hex()}'>· {n_comp} compromised skipped</span>"
            msg += f" <span style='color:{_secondary_hex()}'>· closing…</span>"
            self._set_status(msg, "ok")
            subprocess.Popen([
                "notify-send", "Arch Update Complete",
                f"Successfully updated {n_selected} package{'s' if n_selected != 1 else ''}."
                + (f" {n_comp} compromised skipped." if n_comp else ""),
                "-i", "system-software-update", "-t", "9000",
            ])
            self.update_succeeded.emit()
            self._log_action(
                f"Updated {n_selected} package"
                f"{'s' if n_selected != 1 else ''} ✓")
            # A removal the user queued during the update runs now, and it
            # needs the window to stay: closing stops the runners.
            if not self._drain_pending_removals():
                QTimer.singleShot(2000, self.close)
            return

        # ── Failure path ──────────────────────────────────────────────
        # Circuit breaker: dismissing sudo/auth means nothing ran — abort
        # back to idle instead of painting a failure screen. No failed
        # rows, no red error, no retry mode, no notification.
        kind = classify_update_failure(output)[0]
        if kind == "cancelled":
            self._updating = False
            self._release_thread("_runner")
            self._retry_mode = False
            self._fail_sig = None
            self._fail_streak = 0
            self._watchdog.stop()
            self._hide_failure_ui()
            if self._installing_row is not None:
                prev = self._model.item(self._installing_row)["name"]
                self._model.set_state(prev, "idle")
                self._installing_row = None
            self._progress.setRange(0, 1)
            self._progress.setValue(0)
            self._set_progress_state("normal")
            n_done = self._done_selected_count()
            n_left = max(0, n_selected - n_done)
            self._stat_ready.set_value(str(n_left))
            self._stat_ready.set_caption("ready to install")
            self._stat_ready.set_accent(_positive_hex())
            self._set_status("Update cancelled — nothing was changed.",
                             "info")
            self._log_action("Update cancelled")
            self._show_cancel(False)
            self._cancel_btn.setEnabled(True)
            self._recheck_btn.setEnabled(True)
            self._refresh_selection_ui()
            self._drain_pending_removals()
            return
        self._updating = False
        self._release_thread("_runner")
        self._retry_mode = True
        self._watchdog.stop()

        # Name the failing packages even when they were never in the list
        # (dependencies): give them rows + Retry pills so the failure has
        # a visible owner instead of a mystery name in the log. Live
        # conflicts seen mid-run are authoritative — merge them first.
        all_names = self._model.names()
        failed_names = _failed_package_names(output, all_names)
        conflict_pkgs, _conflict_files = extract_file_conflicts(output or "")
        for pkg in list(self._live_conflicts):
            if pkg not in failed_names:
                failed_names.append(pkg)
            if pkg not in conflict_pkgs:
                conflict_pkgs.append(pkg)
        for pkg in conflict_pkgs:
            if self._model.row_of(pkg) is None:
                self._model.ensure_row(pkg)
                all_names.append(pkg)
            if pkg not in failed_names:
                failed_names.append(pkg)
        if self._installing_row is not None:
            prev = self._model.item(self._installing_row)["name"]
            # Don't clobber a live-marked failure back to idle.
            if prev not in failed_names:
                self._model.set_state(prev, "idle")
            self._installing_row = None
        for name in failed_names:
            self._model.set_state(name, "failed")

        kind, title, advice = classify_update_failure(output)
        lines = [l for l in output.splitlines() if l.strip()]
        self._last_error = "\n".join(lines[-60:]) if lines else "(no output captured)"
        self._log_action(
            f"Update failed ({title}): {', '.join(failed_names)}"
            if failed_names else f"Update failed ({title})")

        # Repeat guard: same signature failing again means the auto-fix
        # isn't working — stop the dialog loop, show the manual command.
        sig = (kind, tuple(failed_names))
        self._fail_streak = self._fail_streak + 1 if sig == self._fail_sig else 1
        self._fail_sig = sig
        manual_cmd = ""
        if failed_names:
            manual_cmd = (
                "Manual fix (run in a terminal):\n"
                f"  sudo pacman -S {' '.join(failed_names)} --overwrite '*'\n\n")
        if self._fail_streak >= 2 and kind != "cancelled":
            advice += (f" This exact failure happened {self._fail_streak} "
                       f"times in a row — automatic fixes are paused.")

        # Red, full progress track — never green on failure.
        self._progress.setRange(0, 1)
        self._progress.setValue(1)
        self._set_progress_state("error")

        n_done = self._done_selected_count()
        n_pending = max(0, n_selected - n_done)
        self._stat_ready.set_value(str(n_pending))
        self._stat_ready.set_caption("pending — retry")
        self._stat_ready.set_accent(_negative_hex())
        self._show_log()

        # Unmissable who/why summary in the unified header status, then
        # jump the list to the failed row and its Retry pill.
        who = ", ".join(failed_names) if failed_names else "unknown package"
        self._set_status(
            f"<b>Update failed</b> — {title}: {who}. "
            f"<b>{n_pending}</b> package{'s' if n_pending != 1 else ''} "
            f"pending. {advice}", "error")
        self._fail_row = (self._model.row_of(failed_names[0])
                          if failed_names else None)
        self._scroll_to_failed()

        self._details.setPlainText(manual_cmd + self._last_error)
        self._details_label.setVisible(True)
        self._details.setVisible(True)
        self._copy_btn.setVisible(True)
        self._dismiss_btn.setVisible(True)

        self._update_btn.setEnabled(True)
        self._cancel_btn.setEnabled(True)
        self._show_cancel(False)
        self._recheck_btn.setEnabled(True)
        self._refresh_selection_ui()
        # The database is free again: run whatever the user queued while
        # this update was going. Done before the failure dialogs below so
        # a queued removal never stacks behind them.
        self._drain_pending_removals()

        if kind == "cancelled":
            return  # dismissing auth is not a failure — stay silent

        # Say it in a dialog too: the header line is one elided line and
        # the details panel has to be opened by hand. Only the first time
        # for a given failure — the repeat guard above exists precisely so
        # an identical failure stops throwing dialogs at the user.
        if self._fail_streak == 1:
            self._show_error_dialog(
                "update failed",
                f"{title} — {who} could not be installed.",
                f"{advice} "
                f"{n_pending} package{'s' if n_pending != 1 else ''} still "
                "pending: use Retry on the affected rows, or open the log "
                "panel for the full output.",
                manual_cmd + self._last_error)

        body = f"{title}: {who}"
        if self._fail_streak >= 2:
            body += f"\nFailure #{self._fail_streak} — same issue repeated"
        self._fail_notif_id = _notify_update(
            "Arch Update Failed", body,
            replaces_id=self._fail_notif_id)

        if self._fail_streak >= 2:
            return  # guard: no more auto-fix dialogs for the same failure
        if self._offer_open:
            return  # single-flight: never stack modal fix dialogs
        self._offer_open = True
        try:
            self._maybe_offer_obsolete_cleanup(output)
            self._maybe_offer_overwrite_retry(kind, output)
        finally:
            self._offer_open = False

    def _maybe_offer_overwrite_retry(self, kind: str, output: str,
                                       single_name: str | None = None) -> None:
        """Offer 'Retry with --overwrite' for 'exists in filesystem' failures."""
        if kind != "file-conflict":
            return
        pkgs, files = extract_file_conflicts(output)
        shown = "\n".join(f"  • {f}" for f in files[:8])
        if len(files) > 8:
            shown += f"\n  • …and {len(files) - 8} more"
        who = ", ".join(pkgs) if pkgs else "the failing package(s)"
        box = QMessageBox(self)
        box.setWindowTitle("Files already exist on disk")
        box.setIcon(QMessageBox.Icon.Warning)
        box.setText(
            f"{who} can't install because these files already exist:\n\n"
            f"{shown}\n\n"
            "This usually follows a pip install into system paths.\n"
            "Retry with “--overwrite '*'” to let pacman replace them?"
        )
        retry_btn = box.addButton("Retry with --overwrite", QMessageBox.ButtonRole.AcceptRole)
        box.addButton("Not Now", QMessageBox.ButtonRole.RejectRole)
        box.exec()
        if box.clickedButton() is retry_btn:
            if single_name is not None:
                self._run_single(single_name, overwrite="*")
            else:
                self._overwrite = "*"
                self.start_update()

    # — Show-more popover —
    def _on_more_requested(self, row: int) -> None:
        self.show_popover(row)

    # — AUR → official moves —
    def _open_sources_dialog(self) -> None:
        """Explain the managed sources — read-only, never edits pacman.conf."""
